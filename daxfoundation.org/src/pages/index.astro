---
// 2026-11-08 (Jason, the show): ACT 1 - the gift.
// Act 0 (21:00 Halifax tonight) was one key: D, the call, answered on G.
// Act 1 opens the whole octave. Every key plays. D still calls and still gets
// its answer on G. Nothing is recorded, nothing leaves the page, no account,
// no email - the gift claims nothing, which is what keeps it clear of the
// incorporation gate in state/gift/GIFT-PLAN-20261103.md.
// data-countdown stays: it keeps the full-home content gates skipped at deploy
// time. The DAX line is a hard gate and is verbatim. The privacy link is
// present (every-page deploy gate) but hidden.
// Next acts widen this page; they do not add new ones.
---
<!doctype html>
<html lang="en" data-countdown>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="od-no-beacon" content="1">
<title>DAX Foundation</title>
<style>
  html,body{margin:0;height:100%;background:#000;color:#f2f2f2;overflow:hidden;
    -webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
  body{display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:1.4rem;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    text-align:center;padding:0 16px}
  #d{font-size:clamp(1.1rem,3.4vw,2rem);font-weight:400;max-width:34em;line-height:1.4;margin:0}
  .line{font-size:clamp(.95rem,2.6vw,1.25rem);color:#cfcfcf;max-width:30em;line-height:1.5;margin:0}
  #quiet{font-size:clamp(.78rem,1.9vw,.9rem);color:#7d7d7d;margin:.2rem 0 0;letter-spacing:.02em}
  #privz{position:fixed;left:-9999px;opacity:0}
  /* one plain octave - all of it playable now */
  #kb{position:relative;width:min(88vw,340px);height:150px;margin-top:.3rem}
  .wk{position:absolute;top:0;width:14.2857%;height:100%;background:#fff;border:1px solid #000;
    box-sizing:border-box;border-radius:0 0 5px 5px;cursor:pointer}
  .bk{position:absolute;top:0;width:9%;height:62%;background:#111;border:1px solid #000;
    box-sizing:border-box;border-radius:0 0 4px 4px;z-index:2;cursor:pointer}
  .press{background:#ffd86b !important}
</style>
</head>
<body>
<p id="d">DAX: preservation and expansion of life, humanity, and consciousness.</p>

<p class="line">Sometimes you just have to reach out your hand.</p>
<p class="line">And when you call, sometimes you will hear an answer.</p>
<div id="kb" aria-label="piano"></div>
<p id="quiet">The keys are yours. Nothing here is recorded.</p>

<a id="privz" href="/privacy/" tabindex="-1" aria-hidden="true">Privacy</a>

<script is:inline>
(function () {
  var ctx;
  function tone(freq, when, dur, peak){
    if (!ctx) ctx = new (window.AudioContext||window.webkitAudioContext)();
    if (ctx.state==='suspended') ctx.resume();
    var t = ctx.currentTime + (when||0);
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type='triangle'; o.frequency.value=freq;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(peak||0.28, t+0.012);
    g.gain.exponentialRampToValueAtTime(0.0001, t+(dur||1.3));
    o.connect(g); g.connect(ctx.destination);
    o.start(t); o.stop(t+(dur||1.3)+0.05);
  }

  function flash(el){
    el.classList.add('press');
    setTimeout(function(){ el.classList.remove('press'); }, 180);
  }

  // D is still the call: it answers itself on G, the way Act 0 did.
  function play(el, freq, isCall){
    flash(el);
    tone(freq, 0, 1.3, 0.3);
    if (isCall){
      tone(392.00, 0.65, 1.5, 0.22);
      if (navigator.vibrate) navigator.vibrate([25,120,40]);
    }
  }

  var WHITES = [
    { n:'C', f:261.63 }, { n:'D', f:293.66 }, { n:'E', f:329.63 },
    { n:'F', f:349.23 }, { n:'G', f:392.00 }, { n:'A', f:440.00 },
    { n:'B', f:493.88 }
  ];
  // black keys sit after C,D,F,G,A (indices 0,1,3,4,5)
  var BLACKS = [
    { i:0, f:277.18 }, { i:1, f:311.13 }, { i:3, f:369.99 },
    { i:4, f:415.30 }, { i:5, f:466.16 }
  ];

  function bind(el, freq, isCall){
    el.addEventListener('pointerdown', function(e){
      e.preventDefault();
      play(el, freq, isCall);
    });
  }

  function buildKeys(){
    var kb = document.getElementById('kb');
    WHITES.forEach(function(k,i){
      var el = document.createElement('div');
      el.className = 'wk';
      el.style.left = (i*14.2857) + '%';
      bind(el, k.f, k.n === 'D');
      kb.appendChild(el);
    });
    BLACKS.forEach(function(b){
      var el = document.createElement('div');
      el.className = 'bk';
      el.style.left = (b.i*14.2857 + 10) + '%';
      bind(el, b.f, false);
      kb.appendChild(el);
    });
  }

  buildKeys();
})();
</script>
</body>
</html>
