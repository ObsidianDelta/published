---
import Base from '../layouts/Base.astro';
import { home as homeSamples } from './metadax/_showcase.js';

// daxfoundation.org home, rebuilt 2026-10-05 at Jason's request: Meta DAX front
// and centre, then the Constraint Protocol, then what is coming, then the ask.
//
//   1. The DAX line, alone, as it always was.
//   2. Meta DAX, featured: what it is, the benchmark, three doors (see what it
//      hands a guide and a learner; homeschooling, start here; the measure
//      under all of it), the tree, where it is going, and the way into
//      /metadax/, where everything Meta DAX now lives on this site.
//   3. The Constraint Protocol, second: the ground everything stands on, one
//      picture, the specification, and the line that ties it to Meta DAX.
//   4. Coming soon: Skippy DAX and Nova DAX, by name only.
//   5. Definitions and Reading, kept short.
//   6. The ask, at the foot: the note from the founder (his words, unchanged
//      from 2026-10-01), with his personal Ko-fi. The disclosure sentence
//      beside that link is a deploy gate: the Foundation is not incorporated
//      and takes no money; what is given there goes to Jason. It keeps
//      id="founder" so the old #founder links still land. Above it, the one
//      ask that matters this week: a guide, a real scenario, a sample built
//      for them (/metadax/#ask).
//
// Earlier history of this page (2026-09-29, 2026-10-01) is in the public
// record: github.com/ObsidianDelta/published/commits/main/daxfoundation.org.
//
// Accuracy rules that bind every word here (state/initiatives/
// content-publishing.md): never describe the Foundation as a non-profit,
// charity, registered or incorporated body; the Constraint Protocol has run in
// full once -- say so, and never imply it runs across anyone's traffic today;
// Meta DAX results come from automated runs, and the repository says which;
// the showcase samples are made-up people, built with help from AI and read in
// full by a person before they went up; "guide" and "learner", never "role".
//
// Figures are self-hosted under /figures/ and drawn in this site's palette
// (no accent colour).
//
// Comments in the markup below are {/* ... */}, never <!-- ... -->.

// Every id that used to live on this page and now lives on /definitions/.
const moved = [
  'definitions', 'nonbiological-intelligence', 'biological-intelligence',
  'principal', 'delegate', 'constraint', 'invariant-constraint',
  'dax-constraint', 'cognitive-stack', 'knowledge', 'intelligence', 'wisdom',
  'consciousness', 'emergence', 'top-down-causation', 'constraint-resonance',
  'cognitive-companion', 'human-delta-value', 'ai-as-substrate',
];

const coming = [
  { name: 'Skippy DAX', status: 'Coming soon' },
  { name: 'Nova DAX', status: 'Coming soon' },
];

const first = homeSamples[0];
---
<Base>
  <section class="lede" aria-labelledby="dax">
    <h1 id="dax">DAX: preservation and expansion of life, humanity, and consciousness.</h1>
  </section>

  <section class="block feature" id="learning" aria-labelledby="metadax">
    <h2 id="metadax">Meta DAX</h2>
    <p class="kicker">Our initiative of universal learning.</p>
    <p class="big">Every human being. Any subject. Any domain. Free, forever.</p>
    <p class="body">
      Anyone who is a step ahead can be a guide. Everyone is a learner. Meta DAX
      hands the two of them what they need for the next step together: for the
      guide, what to do, what to say and what to skip; for the learner, a page
      made for them, with something to do in it. After each step the guide says
      how it went, and the next page comes back shaped by it.
    </p>
    <p class="body">
      Held to a benchmark with the audacity built in: <em>take a person who can
      communicate, and get them to the equivalent of a master&rsquo;s degree from
      an Ivy League university &mdash; on five minutes of connectivity a
      day.</em> <strong>We are developing this for all bandwidths!</strong> Five
      minutes a day is where it starts.
    </p>

    <ul class="doors">
      <li>
        <a href="/metadax/showcase/">
          <span class="door-kicker">See it</span>
          <span class="door-title">What it hands a guide and a learner</span>
          <span class="door-text">Six samples, three steps in: a mom and her eleven-year-old on fractions, a teacher and a newcomer, a grandson and his grandmother, a new manager, a first on-call shift, a teacher of teachers. Open the pages. Everyone in them is made up.</span>
        </a>
      </li>
      <li>
        <a href="/metadax/homeschool/">
          <span class="door-kicker">Homeschooling?</span>
          <span class="door-title">Start here</span>
          <span class="door-text">You know your child. That is the part no system can do. The rest of the preparing, Meta DAX does, and hands you the next session. Tell us where your child is stuck and we will build you one.</span>
        </a>
      </li>
      <li>
        <a href="/metadax/#human-delta-value">
          <span class="door-kicker">The measure</span>
          <span class="door-title">Human delta value</span>
          <span class="door-text">Every time the system takes cognitive labour off a guide, one question is left, and it is the whole point: what is it that only you can do here, and how do we help you do it as well as you can?</span>
        </a>
      </li>
    </ul>

    <p class="chairs-lead">Pick your chair:</p>
    <nav class="chairs" aria-label="Meta DAX doors">
      <a href="/metadax/homeschool/">Parent</a>
      <a href="/metadax/tutor/">Tutor</a>
      <a href="/metadax/teacher/">Teacher</a>
      <a href="/metadax/trainer/">Trainer</a>
      <a href="/metadax/research/">Researcher</a>
    </nav>

    <figure class="fig">
      <img src="/figures/meta-dax-tree.svg" width="1200" height="840" alt="Learning drawn as the tree of life upside down: every path from the first question is kept, the dead ends are kept, one learner's question answers another's, and the negative space nobody has explored yet is marked. There is never the way. There is always a way." loading="lazy" />
    </figure>

    <p class="body after-fig">
      Fourteen small experiments first; two have run, with a model in both
      chairs. Then the legwork. Then the twelve we can already picture, written
      as scenes: a guide&rsquo;s move made once in Indonesian and offered in
      Spanish to a stranger who shares nothing with the first learner but kites;
      every contribution on a record nobody can quietly edit; one person on a
      phone going from five minutes a day to a master&rsquo;s.
      The small ones are how we earn the big ones.
    </p>
    <p class="out">
      <a href="/metadax/">Everything Meta DAX &rarr;</a>
      <span aria-hidden="true">&middot;</span>
      <a href="/metadax/#experiments">The experiments</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://github.com/daxfoundation/metadax">The repository, on GitHub</a>
    </p>
  </section>

  <section class="block feature" aria-labelledby="cp">
    <h2 id="cp">Constraint Protocol</h2>
    <p class="big">The ground everything here stands on.</p>
    <p class="body">
      A way for parties &mdash; people, companies or software &mdash; to declare
      in advance what they will not do, and then be checked against it. It keeps
      a signed record nobody can quietly edit, keeps witnessing and judging
      separate, lets a declared constraint hold up named work and records every
      attempt to get round it, and lets anyone dispute any record. It is neutral
      to the constraint and to the kind of entity that holds it. DAX is one
      constraint built on it.
    </p>
    <figure class="fig">
      <img src="/figures/constraint-protocol.svg" width="1000" height="640" alt="The Constraint Protocol in one picture: declare what you will not do, act, witness every event onto a signed record nobody can quietly edit, judge separately; attempts to get round a constraint are refused and recorded; anyone can dispute any record." loading="lazy" />
    </figure>
    <p class="body after-fig">
      Meta DAX is built to run on it. Every guide&rsquo;s move, every
      learner&rsquo;s question that becomes part of a course, every review, on a
      record nobody can quietly edit, so that what one person works out compounds
      for everyone after them. <a href="/metadax/#constraint-protocol">What that
      looks like, scene by scene &rarr;</a>
    </p>
    <p class="note-line">A public working draft, run in full once so far.</p>
    <p class="out">
      <a href="https://github.com/daxfoundation/constraint-protocol">Read the specification &mdash; CP-SPEC v0.5, on GitHub</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://jeyanandan.com/blog/the-constraint/">Why it matters: The Constraint</a>
    </p>
  </section>

  <section class="block" aria-labelledby="coming">
    <h2 id="coming">Coming</h2>
    <ul class="rows">
      {coming.map((i) => (
        <li class="row">
          <span class="name">{i.name}</span>
          <span class="status">{i.status}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="more">
    <h2 id="more">Definitions and reading</h2>
    <ul class="rows">
      <li class="row">
        <span class="name"><a href="/definitions/">Definitions</a></span>
        <span class="text">
          The normative definitions used across the DAX ecosystem:
          <a href="/definitions/#cognitive-companion">cognitive companion</a>,
          <a href="/definitions/#human-delta-value">human delta value</a>,
          constraint, knowledge, intelligence, wisdom, consciousness and the
          rest. Other documents reference them rather than restating them.
        </span>
      </li>
      <li class="row">
        <span class="name"><a href="/writing/">Writing</a></span>
        <span class="text">
          The Foundation&rsquo;s own pieces, starting with
          <a href="/writing/human-delta-value/">Human delta value: the measure</a>.
        </span>
      </li>
      <li class="row">
        <span class="name">On jeyanandan.com</span>
        <span class="text">
          The long-form work behind all of this, by Jason Jeyanandan, who set
          this Foundation up:
          <a href="https://jeyanandan.com/blog/meta-dax/">Meta DAX: An Introduction</a>,
          <a href="https://jeyanandan.com/blog/the-constraint/">The Constraint</a>,
          <a href="https://jeyanandan.com/blog/snowflake-fuckari-in-action/">The Snowflake</a>,
          <a href="https://jeyanandan.com/blog/fuckarian/">The Fuckarian</a>, and
          the framework itself, <a href="https://github.com/ObsidianDelta/Fuckery">Fuckery</a>,
          published in full with its dead ends left in.
        </span>
      </li>
    </ul>
  </section>

  <section class="block" aria-labelledby="ask">
    <h2 id="ask">The ask</h2>
    <p class="big">Give us a real scenario. We will build you a sample.</p>
    <p class="body">
      A parent who homeschools, a teacher, a mentor, a manager, a nurse training
      the next nurse: anyone who is a step ahead of someone on something. Tell us
      where the two of you are stuck, in a few lines, with no names and nothing
      that identifies anyone, and we will hand you back a page like the
      <a href={`/metadax/showcase/${first.id}/`}>one for {first.guide} and {first.learner}</a>:
      one side for you, one for them. Free. You read it before you use it.
      <a href="/metadax/#ask">How to send it &rarr;</a>
    </p>

    <div class="note" id="founder">
      <p class="note-head">A note from the founder</p>
      <p>I have been at this since I was 23. I am now 49.</p>
      <p>&ldquo;This&rdquo; has only ever been one thing: <a href="https://jeyanandan.com/blog/meta-dax/#what-i-am-fighting-for">the right information, to the right person, at the right time</a>. I found it the day I left university for the last time, and everything I have built since has been a draft of it. Meta DAX is the current one: the latest expansion of the same purpose, and the first where the information is the kind that lets a person go and get all the rest.</p>
      <p>It has taken a tremendous amount of personal sacrifice, on every level, and it still does. All of it has come out of my own pocket.</p>
      <p>If you want to know why it means this much to me, <a href="https://jeyanandan.com/blog/meta-dax/#what-meta-dax-means-to-me">it is here</a>. I was <a href="https://jeyanandan.com/blog/meta-dax/#the-kid-it-did-not-exist-for">the kid it did not exist for</a>.</p>
      <p>On the way to getting Meta DAX out, while working out how knowledge and intelligence could be made to compound, it became clear that I needed something else first: an accountability framework. A flight recorder, the black box the aviation industry keeps, for the thing I could see coming. I set that out in <a href="https://jeyanandan.com/blog/the-constraint/">The Constraint</a>. They are not two separate fights. The rubbish on the beach is a real problem, and so is the thousand-foot wave coming towards it, and you do not get to pick one. But while that work was in front of me I did not have the cognitive capacity to give Meta DAX what it needed, and I put it off from the beginning of this year. It is my purpose, and as of 28 September <a href="https://jeyanandan.com/blog/meta-dax/">it is in the open</a>: the experiments, every result, and what comes next.</p>
      <p>So, being completely transparent: if you would like to <a href="https://ko-fi.com/jeyanandan">buy me a coffee</a>, it would mean a great deal to me, from the bottom of my heart. Thank you. It goes to me personally, not the Foundation and not the company.</p>
      <p class="sig">&mdash; <a href="https://jeyanandan.com">Jason Jeyanandan</a></p>
    </div>
  </section>

  {/* Old links such as daxfoundation.org/#cognitive-companion still land:
      a definition anchor that no longer exists here forwards to the same
      anchor on /definitions/. */}
  <script is:inline define:vars={{ moved }}>
    (function () {
      var id = decodeURIComponent(location.hash.slice(1));
      if (id && moved.indexOf(id) !== -1) {
        location.replace('/definitions/' + (id === 'definitions' ? '' : '#' + id));
      }
    })();
  </script>
</Base>

<style>
  .lede { padding-block: 5rem 4.5rem; }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.012em;
    max-width: 22em;
    text-wrap: balance;
  }
  .block { padding-block: 2.25rem; border-top: 1px solid var(--line); }
  .block[id] { scroll-margin-top: 1.5rem; }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker { margin: -0.75rem 0 1rem; color: var(--muted); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 0.9rem;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .name { font-weight: 500; }
  .text { color: #cfcfcf; }
  .status {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .body { margin: 0; max-width: 36em; color: #cfcfcf; }
  .body + .body { margin-top: 1rem; }
  .after-fig { margin-top: 1.5rem; }

  /* One line that carries the weight of a section. */
  .big {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
  }
  strong { font-weight: 600; color: var(--fg); }

  /* The two featured sections: Meta DAX and the Constraint Protocol. */
  .feature { padding-block: 3rem 2.75rem; }
  .note-line { margin: 1rem 0 0; font-size: 0.875rem; color: var(--faint); }

  /* Three doors into Meta DAX. */
  .doors {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .doors a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .doors a:hover, .doors a:focus-visible { border-color: var(--muted); }
  .door-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .door-title { font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  .door-text { font-size: 0.9rem; line-height: 1.5; color: #bdbdbd; }

  /* Five short links: one per chair. */
  .chairs-lead { margin: 1.5rem 0 0.5rem; font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .chairs { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.9375rem; }
  .chairs a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .chairs a:hover, .chairs a:focus-visible { border-bottom-color: currentColor; }

  /* Figures: drawn in this palette, full width of the column. */
  .fig { margin: 1.75rem 0 0; }
  .fig img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  /* Outbound links sit below the block they belong to, in a quiet register.
     Underlined rather than coloured: this palette has no accent. */
  .out { margin: 1.5rem 0 0; font-size: 0.9375rem; }
  .out span { color: var(--faint); margin-inline: 0.5rem; }
  .out a, .rows a, .body a, .note a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--faint);
  }
  .out a:hover, .out a:focus-visible,
  .rows a:hover, .rows a:focus-visible,
  .body a:hover, .body a:focus-visible,
  .note a:hover, .note a:focus-visible { border-bottom-color: currentColor; }

  /* #founder: Jason's own words, set as a short letter at the foot. */
  .note { max-width: 36em; color: #cfcfcf; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); scroll-margin-top: 1.5rem; }
  .note p { margin: 0; }
  .note p + p { margin-top: 0.9rem; }
  .note .note-head {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .note .sig { color: var(--muted); }
  .note .sig a { border-bottom-color: var(--line); }

  @media (max-width: 40rem) {
    .doors { grid-template-columns: 1fr; }
  }
  @media (max-width: 34rem) {
    .fig { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .fig img { width: 640px; max-width: none; }
    .lede { padding-block: 3rem 3rem; }
    .row { grid-template-columns: 1fr; }
  }
</style>
