---
// 2026-11-07 (Jason): "daxfoundation.org root page, the simplest countdown to 8:59 p.m. Sunday. Just one simple countdown, that's it."
// The previous home page is in git history: the parent of the commit that introduced this file.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DAX Foundation</title>
<style>
html,body{margin:0;height:100%;background:#000;color:#f2f2f2}
body{display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
#c{font-size:clamp(2.5rem,12vw,9rem);font-variant-numeric:tabular-nums;letter-spacing:.04em;font-weight:300}
</style>
</head>
<body>
<div id="c" aria-live="polite">&nbsp;</div>
<script is:inline>
(function () {
  var target = Date.parse('2026-11-09T00:59:00Z');
  var el = document.getElementById('c');
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var s = Math.max(0, Math.floor((target - Date.now()) / 1000));
    var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60), x = s % 60;
    el.textContent = (d > 0 ? d + ':' : '') + pad(h) + ':' + pad(m) + ':' + pad(x);
    if (s > 0) setTimeout(tick, 1000 - Date.now() % 1000);
  }
  tick();
})();
</script>
</body>
</html>
