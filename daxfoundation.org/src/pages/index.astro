---
import Base from '../layouts/Base.astro';

// daxfoundation.org home, refocused 2026-10-10 (uniform-home) at Jason's
// request: "a lot of stuff needs to be rearranged, more focused, continuity
// between the GitHub README and the front page." The home now mirrors the
// metadax README's wording and leads with the five chairs.
//
//   1. The DAX line, alone, as the H1.
//   2. Meta DAX: the README's first paragraph (shortened), the FIVE DOORS
//      (the same five chairs as /metadax/, same one-liners), "See it" (the
//      five showcases in one row with the universal line), and the sponsor
//      sentence.
//   3. The research: one short paragraph with the benchmark, all-bandwidths
//      and the X13/X14 runs, linking /metadax/research/ and the findings.
//   4. The Constraint Protocol, trimmed to one paragraph and its links
//      (id="cp" kept -- external links point at daxfoundation.org/#cp).
//   5. Coming: Skippy DAX, Nova DAX.
//   6. Definitions and reading, compact.
//   7. The ask: the CTA now points at the five doors.
//   8. A note from the founder, VERBATIM, id="founder" kept.
//
// Earlier history of this page (2026-09-29, 2026-10-01, 2026-10-05) is in the
// public record: github.com/ObsidianDelta/published/commits/main/daxfoundation.org.
//
// Accuracy rules that bind every word here (state/initiatives/
// content-publishing.md): never describe the Foundation as a non-profit,
// charity, registered or incorporated body; the Constraint Protocol has run in
// full once -- say so, and never imply it runs across anyone's traffic today;
// "guide" and "learner", never "role"; no AI vendor named in guide-facing copy.
//
// Comments in the markup below are {/* ... */}, never <!-- ... -->.

// Every id that used to live on this page and now lives on /definitions/.
const moved = [
  'definitions', 'nonbiological-intelligence', 'biological-intelligence',
  'principal', 'delegate', 'constraint', 'invariant-constraint',
  'dax-constraint', 'cognitive-stack', 'knowledge', 'intelligence', 'wisdom',
  'consciousness', 'emergence', 'top-down-causation', 'constraint-resonance',
  'cognitive-companion', 'human-delta-value', 'ai-as-substrate',
];

// The five chairs, the same one-liners as /metadax/ so the two pages read as
// one. Each door links its own page.
const doors = [
  { href: '/metadax/homeschool/', kicker: 'Parent', title: 'You homeschool',
    text: 'You know your child. Meta DAX does the rest of the preparing and hands you the next session, built through what they love.' },
  { href: '/metadax/tutor/', kicker: 'Tutor', title: 'You tutor',
    text: 'One learner, one stuck spot, one evening. Rough notes in, a plan for the next session and a parent-ready report out.' },
  { href: '/metadax/teacher/', kicker: 'Teacher', title: 'You teach a class',
    text: 'A class that nods and then fails the exit task. A hinge question, every wrong answer planned for, and the cognition handed back to you.' },
  { href: '/metadax/trainer/', kicker: 'Trainer', title: 'You train at work',
    text: 'A new hire, a first week, a process only you hold. A module built from a one-page brief, so the next hire starts a step ahead.' },
  { href: '/metadax/research/', kicker: 'Researcher', title: 'You want the evidence',
    text: 'The benchmark, the measure, how it works underneath, the experiments with their results, the Constraint Protocol, and the ask.' },
];

// The five showcases, in one row: the ceiling of what the recipe builds.
const showcases = [
  { href: '/metadax/samples/stade-des-fractions/', name: 'Le Stade des Fractions', note: 'French fractions in a 3D stadium' },
  { href: '/metadax/showcases/first-week-at-the-bakery/', name: 'First Week at the Bakery', note: 'a staff onboarding module' },
  { href: '/metadax/showcases/proton-mill/', name: 'The Proton Mill', note: 'a 3D Biology 101 lesson' },
  { href: '/metadax/showcases/tutors-desk/', name: "The Tutor's Desk", note: "one tutor's week" },
  { href: '/metadax/showcases/grade-6-science-year/', name: 'The Year on the Wall', note: 'a whole Grade 6 science year' },
];

const findings = 'https://github.com/daxfoundation/metadax/blob/main/experiments/FINDINGS-20261010.md';
---
<Base>
  <section class="lede" aria-labelledby="dax">
    <h1 id="dax">DAX: preservation and expansion of life, humanity, and consciousness.</h1>
  </section>

  <section class="block feature" id="learning" aria-labelledby="metadax">
    <h2 id="metadax">Meta DAX</h2>
    <p class="kicker">Our initiative of universal learning.</p>
    <p class="body">
      Meta DAX is a bet on one benchmark: take a person who can communicate, and
      bring them to the equivalent of a master&rsquo;s degree from an Ivy League
      university &mdash; on five minutes of connectivity a day. The learning
      cannot live on the network, so it does not: a bundle is generated for the
      particular learner, comes down whole, and is worked through offline. Any
      domain means any domain. It is built to be enterprise grade, and it stays
      free &mdash; not freemium, not free-for-some, not free-until-funded.
    </p>

    <p class="chairs-lead">Pick your chair:</p>
    <ul class="doors">
      {doors.map((d) => (
        <li>
          <a href={d.href}>
            <span class="door-kicker">{d.kicker}</span>
            <span class="door-title">{d.title}</span>
            <span class="door-text">{d.text}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="see-it">
      <p class="big">The same recipe built every one of these.</p>
      <nav class="showcases" aria-label="Showcases">
        {showcases.map((s) => (
          <a href={s.href}>
            <span class="sc-name">{s.name}</span>
            <span class="sc-note">{s.note}</span>
          </a>
        ))}
      </nav>
      <p class="out"><a href="/metadax/samples/">See it &mdash; every showcase and sample &rarr;</a></p>
    </div>

    <p class="sponsor">
      MetaDAX is free. It is built on paid compute. If it helped, a coffee on
      <a href="https://ko-fi.com/jeyanandan">Ko-fi</a> or a
      <a href="https://github.com/sponsors/ObsidianDelta">GitHub sponsorship</a>
      keeps it going.
    </p>
  </section>

  <section class="block" aria-labelledby="research">
    <h2 id="research">The research</h2>
    <p class="body">
      The benchmark &mdash; a person who can communicate to a master&rsquo;s on
      five minutes a day &mdash; is audacious on purpose.
      <strong>We are developing this for all bandwidths!</strong> It rests on
      fourteen small experiments first; X13 and X14 have run, with a model in
      both chairs. The small ones are how we earn the big ones.
    </p>
    <p class="out">
      <a href="/metadax/research/">The research, the measure and the experiments &rarr;</a>
      <span aria-hidden="true">&middot;</span>
      <a href={findings}>The X13 / X14 findings</a>
    </p>
  </section>

  <section class="block feature" aria-labelledby="cp">
    <h2 id="cp">Constraint Protocol</h2>
    {/* #constraint-protocol is kept as a second landing point for the section. */}
    <span id="constraint-protocol" aria-hidden="true"></span>
    <p class="big">The ground everything here stands on.</p>
    <p class="body">
      A way for parties &mdash; people, companies or software &mdash; to declare
      in advance what they will not do, and then be checked against it. It keeps
      a signed record nobody can quietly edit, keeps witnessing and judging
      separate, and lets anyone dispute any record. DAX is one constraint built
      on it, and Meta DAX is built to run on it, so that what one person works
      out compounds for everyone after them. A public working draft, run in full
      once so far.
    </p>
    <p class="out">
      <a href="/metadax/research/#constraint-protocol">What that looks like, scene by scene &rarr;</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://github.com/daxfoundation/constraint-protocol">The specification &mdash; CP-SPEC v0.5</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://jeyanandan.com/blog/the-constraint/">Why it matters: The Constraint</a>
    </p>
  </section>

  <section class="block" aria-labelledby="coming">
    <h2 id="coming">Coming</h2>
    <ul class="rows">
      <li class="row"><span class="name">Skippy DAX</span><span class="status">Coming soon</span></li>
      <li class="row"><span class="name">Nova DAX</span><span class="status">Coming soon</span></li>
    </ul>
  </section>

  <section class="block" aria-labelledby="more">
    <h2 id="more">Definitions and reading</h2>
    <ul class="rows">
      <li class="row">
        <span class="name"><a href="/definitions/">Definitions</a></span>
        <span class="text">
          The normative definitions used across the DAX ecosystem:
          <a href="/definitions/#cognitive-companion">cognitive companion</a>,
          <a href="/definitions/#human-delta-value">human delta value</a>,
          constraint, knowledge, intelligence, wisdom, consciousness and the rest.
        </span>
      </li>
      <li class="row">
        <span class="name"><a href="/writing/">Writing</a></span>
        <span class="text">
          The Foundation&rsquo;s own pieces, starting with
          <a href="/writing/human-delta-value/">Human delta value: the measure</a>.
        </span>
      </li>
      <li class="row">
        <span class="name">On jeyanandan.com</span>
        <span class="text">
          The long-form work behind all of this, by Jason Jeyanandan, who set
          this Foundation up:
          <a href="https://jeyanandan.com/blog/meta-dax/">Meta DAX: An Introduction</a>,
          <a href="https://jeyanandan.com/blog/the-constraint/">The Constraint</a>, and
          <a href="https://github.com/ObsidianDelta/Fuckery">Fuckery</a>,
          published in full with its dead ends left in.
        </span>
      </li>
    </ul>
  </section>

  <section class="block" aria-labelledby="ask">
    <h2 id="ask">The ask</h2>
    <p class="big">Give us a real scenario. We will build you a sample.</p>
    <p class="body">
      A parent who homeschools, a teacher, a mentor, a manager, a nurse training
      the next nurse: anyone who is a step ahead of someone on something. Pick
      your chair, then tell us where the two of you are stuck, in a few lines,
      with no names and nothing that identifies anyone, and we will hand you back
      a page like the showcases above: one side for you, one for them. Free. You
      read it before you use it.
    </p>
    <p class="chairs-lead">Pick your chair:</p>
    <nav class="chairs" aria-label="Meta DAX doors">
      <a href="/metadax/homeschool/">Parent</a>
      <a href="/metadax/tutor/">Tutor</a>
      <a href="/metadax/teacher/">Teacher</a>
      <a href="/metadax/trainer/">Trainer</a>
      <a href="/metadax/research/">Researcher</a>
    </nav>
    <p class="out"><a href="/metadax/">Everything Meta DAX &rarr;</a></p>

    <div class="note" id="founder">
      <p class="note-head">A note from the founder</p>
      <p>I have been at this since I was 23. I am now 49.</p>
      <p>&ldquo;This&rdquo; has only ever been one thing: <a href="https://jeyanandan.com/blog/meta-dax/#what-i-am-fighting-for">the right information, to the right person, at the right time</a>. I found it the day I left university for the last time, and everything I have built since has been a draft of it. Meta DAX is the current one: the latest expansion of the same purpose, and the first where the information is the kind that lets a person go and get all the rest.</p>
      <p>It has taken a tremendous amount of personal sacrifice, on every level, and it still does. All of it has come out of my own pocket.</p>
      <p>If you want to know why it means this much to me, <a href="https://jeyanandan.com/blog/meta-dax/#what-meta-dax-means-to-me">it is here</a>. I was <a href="https://jeyanandan.com/blog/meta-dax/#the-kid-it-did-not-exist-for">the kid it did not exist for</a>.</p>
      <p>On the way to getting Meta DAX out, while working out how knowledge and intelligence could be made to compound, it became clear that I needed something else first: an accountability framework. A flight recorder, the black box the aviation industry keeps, for the thing I could see coming. I set that out in <a href="https://jeyanandan.com/blog/the-constraint/">The Constraint</a>. They are not two separate fights. The rubbish on the beach is a real problem, and so is the thousand-foot wave coming towards it, and you do not get to pick one. But while that work was in front of me I did not have the cognitive capacity to give Meta DAX what it needed, and I put it off from the beginning of this year. It is my purpose, and as of 28 September <a href="https://jeyanandan.com/blog/meta-dax/">it is in the open</a>: the experiments, every result, and what comes next.</p>
      <p>So, being completely transparent: if you would like to <a href="https://ko-fi.com/jeyanandan">buy me a coffee</a>, it would mean a great deal to me, from the bottom of my heart. Thank you. It goes to me personally, not the Foundation and not the company.</p>
      <p class="sig">&mdash; <a href="https://jeyanandan.com">Jason Jeyanandan</a></p>
    </div>
  </section>

  {/* Old links such as daxfoundation.org/#cognitive-companion still land:
      a definition anchor that no longer exists here forwards to the same
      anchor on /definitions/. */}
  <script is:inline define:vars={{ moved }}>
    (function () {
      var id = decodeURIComponent(location.hash.slice(1));
      if (id && moved.indexOf(id) !== -1) {
        location.replace('/definitions/' + (id === 'definitions' ? '' : '#' + id));
      }
    })();
  </script>
</Base>

<style>
  .lede { padding-block: 5rem 4.5rem; }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.012em;
    max-width: 22em;
    text-wrap: balance;
  }
  .block { padding-block: 2.25rem; border-top: 1px solid var(--line); }
  .block[id], .block [id] { scroll-margin-top: 1.5rem; }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kicker { margin: -0.75rem 0 1rem; color: var(--muted); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 0.9rem;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .name { font-weight: 500; }
  .text { color: #cfcfcf; }
  .status {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .body { margin: 0; max-width: 36em; color: #cfcfcf; }
  .body + .body { margin-top: 1rem; }

  /* One line that carries the weight of a section. */
  .big {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
  }
  strong { font-weight: 600; color: var(--fg); }

  /* The two featured sections: Meta DAX and the Constraint Protocol. */
  .feature { padding-block: 3rem 2.75rem; }

  /* Five doors into Meta DAX. */
  .chairs-lead { margin: 1.5rem 0 0.5rem; font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .doors {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .doors a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .doors a:hover, .doors a:focus-visible { border-color: var(--muted); }
  .door-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .door-title { font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  .door-text { font-size: 0.9rem; line-height: 1.5; color: #bdbdbd; }

  /* See it: the five showcases in one row. */
  .see-it { margin-top: 2rem; }
  .showcases {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .showcases a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .showcases a:hover, .showcases a:focus-visible { border-color: var(--muted); }
  .sc-name { font-weight: 500; font-size: 0.9rem; line-height: 1.25; }
  .sc-note { font-size: 0.75rem; color: var(--faint); }

  .sponsor { margin: 2rem 0 0; max-width: 36em; color: #bdbdbd; }

  /* Five short links: one per chair, under the ask. */
  .chairs { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.9375rem; }
  .chairs a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .chairs a:hover, .chairs a:focus-visible { border-bottom-color: currentColor; }

  /* Outbound links sit below the block they belong to, in a quiet register.
     Underlined rather than coloured: this palette has no accent. */
  .out { margin: 1.5rem 0 0; font-size: 0.9375rem; }
  .out span { color: var(--faint); margin-inline: 0.5rem; }
  .out a, .rows a, .body a, .note a, .sponsor a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--faint);
  }
  .out a:hover, .out a:focus-visible,
  .rows a:hover, .rows a:focus-visible,
  .body a:hover, .body a:focus-visible,
  .sponsor a:hover, .sponsor a:focus-visible,
  .note a:hover, .note a:focus-visible { border-bottom-color: currentColor; }

  /* #founder: Jason's own words, set as a short letter at the foot. */
  .note { max-width: 36em; color: #cfcfcf; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); scroll-margin-top: 1.5rem; }
  .note p { margin: 0; }
  .note p + p { margin-top: 0.9rem; }
  .note .note-head {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .note .sig { color: var(--muted); }
  .note .sig a { border-bottom-color: var(--line); }

  @media (max-width: 40rem) {
    .doors { grid-template-columns: 1fr; }
    .showcases { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 34rem) {
    .lede { padding-block: 3rem 3rem; }
    .row { grid-template-columns: 1fr; }
  }
</style>
