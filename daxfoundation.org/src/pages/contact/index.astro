---
// /contact/ -- the Foundation's general contact area (2026-11-06).
// A plain, humble front door: one email, where we are, and links on to the
// other front-door pages. Deliberately NOT promoted in search: it carries
// `noindex, follow` (findable by link, not by SEO) and is excluded from
// src/pages/sitemap.xml.js. No street address, no phone -- Jason's call.
import Base from '../../layouts/Base.astro';
---
<Base
  title="Contact the DAX Foundation"
  description="How to reach the DAX Foundation: one email, read by a person. In English and French."
>
  <meta slot="head" name="robots" content="noindex, follow" />
  <article class="front">
    <header class="lede">
      <h1>Contact</h1>
    </header>

    <section>
      <p class="body">There is one door here for anything you want to say &mdash; a question, an introduction, an offer to help, a note from a journalist. Write to us and a person will read it.</p>
      <p class="body fr" lang="fr">Il y a une seule porte ici pour tout ce que vous souhaitez dire &mdash; une question, une pr&eacute;sentation, une offre d&rsquo;aide, un mot d&rsquo;un journaliste. &Eacute;crivez-nous et une personne vous lira.</p>
    </section>

    <section>
      <h2>Write to us</h2>
      <p class="body"><a href="mailto:dax@daxfoundation.org">dax@daxfoundation.org</a></p>
      <p class="body meta">Currently located in Bathurst, New Brunswick, Canada.</p>
      <p class="body meta fr" lang="fr">Actuellement situ&eacute;s &agrave; Bathurst, au Nouveau-Brunswick, au Canada.</p>
    </section>

    <section>
      <h2>More</h2>
      <p class="body"><a href="/what-this-is/">What this is</a> &middot; <a href="/press/">Press</a> &middot; <a href="/partners/">Partners</a></p>
    </section>
  </article>
</Base>

<style>
  .lede { padding-block: 3.5rem 2.5rem; }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.012em;
  }
  .body { margin: 0; max-width: 36em; color: #cfcfcf; }
  .body + .body { margin-top: 1rem; }
  .body.fr { font-size: 0.9375em; color: var(--muted); }
  .body.meta { font-size: 0.9375em; color: var(--muted); }
  section { padding-block: 1.25rem 0; border-top: 1px solid var(--line); }
  section:first-of-type { margin-top: 1.25rem; }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .body a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--faint);
  }
  .body a:hover, .body a:focus-visible { border-bottom-color: currentColor; }
  @media (max-width: 34rem) {
    .lede { padding-block: 2.5rem 2rem; }
  }
</style>
