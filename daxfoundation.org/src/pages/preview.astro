  <script is:inline>
    (function () {
      var form = document.querySelector('[data-preview-form]');
      if (!form || !window.fetch) return;
      var done = document.querySelector('[data-done]');
      var err = form.querySelector('[data-err]');
      form.elements.t.value = String(Date.now());
      try { if (/^fr\b/i.test(navigator.language || '')) form.elements.lang.value = 'fr'; } catch (e) {}
      var NAMES = { name: 'your name · ton nom', email: 'a valid email · un courriel valide', role: 'who you are · qui tu es', country: 'your country · ton pays', consent: 'the consent box · la case de consentement' };
      function show(msg) { err.textContent = msg; err.hidden = false; }
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        err.hidden = true;
        var fd = new FormData(form);
        var body = {};
        fd.forEach(function (v, k) { body[k] = String(v); });
        var missing = [];
        if (!body.name || !body.name.trim()) missing.push('name');
        if (!/^\S+@\S+\.\S+$/.test(body.email || '')) missing.push('email');
        if (!body.role) missing.push('role');
        if (!body.country || body.country.trim().length < 2) missing.push('country');
        if (!body.consent) missing.push('consent');
        if (missing.length) { show('Please add ' + missing.map(function (m) { return NAMES[m]; }).join(', ') + '.'); return; }
        var btn = form.querySelector('button[type=submit]');
        btn.disabled = true;
        fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }).then(function (j) { return { s: r.status, j: j }; }); })
          .then(function (res) {
            btn.disabled = false;
            if (res.j && res.j.ok) { form.hidden = true; done.hidden = false; done.focus(); return; }
            if (res.s === 429) return show('Too many tries from here. Please wait a little. · Trop d’essais d’ici. Attends un peu.');
            if (res.s === 400 && res.j && res.j.errors) return show('Please check ' + res.j.errors.map(function (m) { return NAMES[m] || m; }).join(', ') + '.');
            show('The list is not open yet. Please try again soon. · La liste n’est pas encore ouverte. Réessaie bientôt.');
          })
          .catch(function () { btn.disabled = false; show('No connection. Please try again. · Pas de connexion. Réessaie.'); });
      });
    })();
  </script>
