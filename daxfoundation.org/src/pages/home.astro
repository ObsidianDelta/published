      the answer is tap-to-play with sound. Under reduced motion the hero does not
      autoplay. Idempotent, re-wired after every View Transition navigation. */}
  <script>
    function wireFilms() {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var hero = document.querySelector("[data-film-hero]");
      if (hero && hero.dataset.wired !== "1") {
        hero.dataset.wired = "1";
        var v = hero.querySelector("video");
        var btn = hero.querySelector("[data-film-sound]");
        var label = btn && btn.querySelector(".film-sound-label");
        if (v && reduce) {
          v.removeAttribute("autoplay");
          v.pause();
          if (label) label.textContent = "Play with sound";
        } else if (v) {
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        }
        if (v && btn) {
          btn.addEventListener("click", function () {
            if (v.paused) {
              v.muted = false;
              v.play().catch(function () {});
            } else {
              v.muted = !v.muted;
              if (!v.muted) v.play().catch(function () {});
            }
            var on = !v.muted && !v.paused;
            hero.classList.toggle("sound-on", on);
            btn.setAttribute("aria-pressed", String(on));
            if (label) label.textContent = on ? "Sound on · tap to mute" : "Tap for sound";
          });
        }
      }
      document.querySelectorAll("[data-film-play]").forEach(function (stage) {
        if (stage.dataset.wired === "1") return;
        stage.dataset.wired = "1";
        var vv = stage.querySelector("video");
        var pb = stage.querySelector("[data-film-play-btn]");
        if (vv && pb) {
          pb.addEventListener("click", function () {
            vv.setAttribute("controls", "");
            stage.classList.add("playing");
            vv.play().catch(function () {});
          });
        }
      });
    }
    document.addEventListener("astro:page-load", wireFilms);
  </script>

