---
import Explain from '../layouts/Explain.astro';
import MapHome from '../components/explain/MapHome.astro';
import RunHeader from '../components/explain/RunHeader.astro';
import Chapter from '../components/explain/Chapter.astro';
import ExperiencePicker from '../components/explain/ExperiencePicker.astro';
import lenses from '../data/lenses.json';
import { getCollectionChapters } from '../lib/explain/chapters.js';
import { home as libraryHome, byKind } from '../data/library.js';
import { posts, SERIES, seriesOf } from './_posts.js';
import { heroFilm, newestAnswer, CREDIT } from '../data/films.js';

// 2026-11-14 (Jason, site/sasquatch-films): a calm films band sits right after the
// DAX line, before Opening. The hero (39.4) and the newest answer are read from the
// one films registry (src/data/films.js), so a new answer lands once and shows up
// here and on /films/ automatically. The theme under it -- the resonance between two
// beings, through the lens of love -- is never stated as a slogan; it is let to be
// felt. No technology names, no "AI", no Jason/Skippy narrative on this page.
const hero = heroFilm();
const answer = newestAnswer();

// 2026-10-24 (Jason): "I want it to be like the default experience". The home page
// IS the Meta DAX run: the DAX line, the map (with the other three runs as cards),
// then Meta DAX's nine chapters right here, with the sticky question bar and the
// experience switcher, no click needed. The three blocks that used to follow
// (Meta DAX, The research, the Constraint Protocol) fold into one "Go further"
// index after the run: every link they carried is kept, the research and Protocol
// paragraphs verbatim; the Meta DAX paragraph and the door blurbs live on
// /metadax/homeschool/, /metadax/research/ and the hub. The note from the founder
// and everything under it are unchanged (linked from the top). /explain/metadax/
// stays the run's own shareable page.
//
// daxfoundation.org home, refocused 2026-10-10 (uniform-home) at Jason's
// request: "a lot of stuff needs to be rearranged, more focused, continuity
// between the GitHub README and the front page." The home now mirrors the
// metadax README's wording and leads with the five chairs.
//
//   1. The DAX line, alone, as the H1.
//   2. Meta DAX: the README's first paragraph (shortened), the FIVE DOORS
//      (the same five chairs as /metadax/, same one-liners), "See it" (the
//      five showcases in one row with the universal line), and the sponsor
//      sentence.
//   3. The research: one short paragraph with the benchmark, all-bandwidths
//      and the X13/X14 runs, linking /metadax/research/ and the findings.
//   4. The Constraint Protocol, trimmed to one paragraph and its links
//      (id="cp" kept -- external links point at daxfoundation.org/#cp).
//   5. Coming: Skippy DAX, Nova DAX.
//   6. Definitions and reading, compact.
//   7. The ask: the CTA now points at the five doors.
//   8. A note from the founder, VERBATIM, id="founder" kept.
//
// Earlier history of this page (2026-09-29, 2026-10-01, 2026-10-05) is in the
// public record: github.com/ObsidianDelta/published/commits/main/daxfoundation.org.
//
// Accuracy rules that bind every word here (state/initiatives/
// content-publishing.md): never describe the Foundation as a non-profit,
// charity, registered or incorporated body; the Constraint Protocol has run in
// full once -- say so, and never imply it runs across anyone's traffic today;
// "guide" and "learner", never "role"; no AI vendor named in guide-facing copy.
//
// Comments in the markup below are {/* ... */}, never <!-- ... -->.

// Every id that used to live on this page and now lives on /definitions/.
const moved = [
  'definitions', 'nonbiological-intelligence', 'biological-intelligence',
  'principal', 'delegate', 'constraint', 'invariant-constraint',
  'dax-constraint', 'cognitive-stack', 'knowledge', 'intelligence', 'wisdom',
  'consciousness', 'emergence', 'top-down-causation', 'constraint-resonance',
  'cognitive-companion', 'human-delta-value', 'ai-as-substrate',
];

// The five chairs, the same one-liners as /metadax/ so the two pages read as
// one. Each door links its own page.
const doors = [
  { href: '/metadax/homeschool/', kicker: 'Parent', title: 'You homeschool',
    text: 'You know your child. Meta DAX does the rest of the preparing and hands you the next session, built through what they love.' },
  { href: '/metadax/tutor/', kicker: 'Tutor', title: 'You tutor',
    text: 'One learner, one stuck spot, one evening. Rough notes in, a plan for the next session and a parent-ready report out.' },
  { href: '/metadax/teacher/', kicker: 'Teacher', title: 'You teach a class',
    text: 'A class that nods and then fails the exit task. A hinge question, every wrong answer planned for, and the cognition handed back to you.' },
  { href: '/metadax/trainer/', kicker: 'Trainer', title: 'You train at work',
    text: 'A new hire, a first week, a process only you hold. A module built from a one-page brief, so the next hire starts a step ahead.' },
  { href: '/metadax/research/', kicker: 'Researcher', title: 'You want the evidence',
    text: 'The benchmark, the measure, how it works underneath, the experiments with their results, the Constraint Protocol, and the ask.' },
];

// The "See it" row reads the one library registry (src/data/library.js),
// newest first, so a new showcase lands once and shows up here automatically.
// The external sample-report link is kept, pinned at the end of the row.
const showcases = [
  ...libraryHome().map((e) => ({ href: e.url, name: e.title, note: e.note })),
  { href: 'https://www.obsidiandelta.com/opportunities/sample-report/', name: 'A sample tutor report', note: 'what a tutor gets back', rel: 'noopener' },
];

// The first run report the recipe produced, linked under the row (external).
const newton = byKind('run').find((e) => e.id === 'newton-laws-test-run');

// The Writing row reads the same module as /writing/, so it cannot drift from
// what is published. 2026-10-19: with fifteen pieces dated the same day, "the
// newest three" was three arbitrary ones. The row now lists, in order, one
// entry per active series (the series title linking to its anchor on
// /writing/, its part count and its blurb), then the newest two pieces that
// belong to no series.
const partWords = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const partCount = (n) => `${partWords[n] ?? n} ${n === 1 ? 'part' : 'parts'}`;
const writingSeries = Object.keys(SERIES)
  .filter((key) => seriesOf(key).length > 0)
  .map((key) => ({
    key,
    title: SERIES[key].title,
    blurb: SERIES[key].blurb,
    count: partCount(seriesOf(key).length),
  }));
const writing = posts.filter((p) => !p.series).slice(0, 2);

const runChapters = await getCollectionChapters('metadax');

// 2026-11-04 (Jason, 22:59): "they have to pick their experience and then it opens
// up." A first-time visitor picks an experience (ExperiencePicker, after Opening)
// before the experience-dependent part opens; a returning visitor goes straight in.
// The order of the page is unchanged. The head script below names the state on
// <html data-xp-gate> before the page paints (see ExperiencePicker.astro for the states).
const lensIds = lenses.map((l) => l.id);

const findings = 'https://github.com/daxfoundation/metadax/blob/main/experiments/FINDINGS-20261010.md';

// 2026-11-04 (Jason: "there's nothing happening on my homepage... show upcoming
// and everything"). "Opening · Ouverture": the two labs and the call, right under
// the DAX line, before the map. The DAX line stays first; the map and the run
// follow unchanged. OPENED stays false until the certificate exists: the labels
// say "Opening soon" and nothing here claims the Foundation is incorporated.
// /home/claude/out/launch/fill-corp.sh --open flips it on launch day.
// Privacy wording (launch rules): the phone is a remote control; 21 points per
// hand and recognised words; no image and no sound leave the phone.
const OPENED = false;
const openState = OPENED
  ? { en: 'Open now', fr: 'Ouvert' }
  : { en: 'Opening soon', fr: 'Bientôt' };
const CALL_OUT = '/writing/a-gift-and-an-open-call/#this-is-the-call-out';
const labs = [
  {
    href: '/gift/', img: 'sound-lab',
    en: 'The Sound Lab', fr: 'Le labo du son',
    textEn: 'Heartbeats, and the language of love. Two hearts, two notes: D calls, G answers. It opens with a gift: make your own sound of love.',
    textFr: 'Les battements de cœur et la langue de l’amour. Deux cœurs, deux notes : ré appelle, sol répond. Il s’ouvre sur un cadeau : crée ton propre son de l’amour.',
    goEn: 'What does love sound like?', goFr: 'À quoi ressemble l’amour en musique ?',
  },
  {
    href: 'https://re.ui.research.daxfoundation.org/reui-start', img: 'gesture-lab', ext: true,
    en: 'The Gesture Lab', fr: 'Le labo des gestes',
    textEn: 'What passes between people without words. Cards that move across screens. Your phone is the remote control: it sends 21 points per hand and the words it recognised. No image and no sound leave the phone.',
    textFr: 'Ce qui passe entre les gens sans les mots. Des cartes qui voyagent d’un écran à l’autre. Ton téléphone est la télécommande : il envoie 21 points par main et les mots reconnus. Aucune image, aucun son ne quitte le téléphone.',
    goEn: 'Step into the lab', goFr: 'Entrer dans le labo',
  },
  {
    href: CALL_OUT, img: 'universities',
    en: 'Universities: join the research', fr: 'Universités et collèges : participez',
    textEn: 'Nonverbal, multimodal communication in learning. Open data, for everyone. We are looking for one partner site to be its home.',
    textFr: 'La communication non verbale et multimodale en apprentissage. Des données ouvertes, pour tous. Nous cherchons un site partenaire pour l’accueillir.',
    goEn: 'Answer the call', goFr: 'Répondre à l’appel',
  },
];
const firstLook = [
  { n: 1, w: 900, h: 506, en: 'The intro reel: the ideas fly in.', fr: 'L’intro : les idées arrivent.' },
  { n: 2, w: 720, h: 520, en: 'Three screens, one wall.', fr: 'Trois écrans, un seul mur.' },
  { n: 3, w: 900, h: 506, en: 'Three roles: guide, learner, observer.', fr: 'Trois rôles : guide, apprenant, observateur.' },
  { n: 4, w: 900, h: 506, en: 'Pick up a card, drop it where it fits.', fr: 'Prends une carte, pose-la où elle va.' },
  { n: 5, w: 900, h: 506, en: 'Standing up is part of the lesson.', fr: 'Se lever fait partie de la leçon.' },
  { n: 6, w: 240, h: 520, en: 'The phone is a remote. See every message it sends.', fr: 'Le téléphone est une télécommande. Vois chaque message.' },
];
---
{/* 2026-11-04 (SEO launch): the home's own title and description for search
    results; the H1 below is unchanged. */}
<Explain
  title="DAX Foundation · Meta DAX, universal learning"
  description="DAX: preservation and expansion of life, humanity, and consciousness. Meta DAX, the Foundation's universal learning initiative: any subject, built for one person, free."
>
  <Fragment slot="head">
    <script is:inline define:vars={{ lensIds }}>
      (function () {
        var s = 'peek';
        try {
          var v = localStorage.getItem('dax-explain-lens');
          s = v && lensIds.indexOf(v) !== -1 ? 'known' : (location.hash.length > 1 ? 'peek' : 'pick');
        } catch (e) { s = 'peek'; }
        document.documentElement.setAttribute('data-xp-gate', s);
      })();
    </script>
  </Fragment>
  <section class="home-w home-lede" aria-labelledby="dax">
    <h1 id="dax">DAX: preservation and expansion of life, humanity, and consciousness.</h1>
    <p class="to-founder"><a href="#founder">A note from the founder &darr;</a></p>
  </section>

  {/* Films (2026-11-14): a calm band, right after the DAX line. Dark, then a light
      comes in. It holds the mark, 39.4 as the hero (muted autoplay, tap for sound,
      plays inline on phones), the newest answer (tap to play), one credit line, and
      a plain "Start here". Everything reads from src/data/films.js. */}
  <section class="home-w films-band" aria-labelledby="films-h">
    <p class="films-kicker">
      <img class="films-mark" src="/films/mark.png" width="30" height="30" alt="" decoding="async" loading="eager" />
      <span>Films&nbsp;<span class="films-dot">·</span>&nbsp;resonant publishing</span>
    </p>
    <h2 class="films-h" id="films-h">From the dark, a hello.</h2>
    <p class="films-lede">This is what we&rsquo;re working on, and how we&rsquo;re learning to release it &mdash; in the open, as it happens. Released responsibly: 18+ while we validate, and guides first.</p>

    <figure class="film-hero" data-film-hero>
      <div class="film-stage">
        <video class="film-video" muted autoplay loop playsinline preload="metadata" poster={hero.poster}>
          <source src={hero.src} type="video/mp4" />
        </video>
        <button type="button" class="film-sound" data-film-sound aria-pressed="false">
          <span class="film-sound-label">Tap for sound</span>
        </button>
      </div>
      <figcaption class="film-cap"><span class="film-cap-title">{hero.title}</span></figcaption>
    </figure>

    {answer && (
      <figure class="film-answer" data-film-play>
        <div class="film-stage film-stage-answer">
          <video class="film-video" playsinline preload="none" poster={answer.poster}>
            <source src={answer.src} type="video/mp4" />
          </video>
          <button type="button" class="film-play" data-film-play-btn aria-label={`Play: ${answer.title}`}>
            <span class="film-play-cue">Play</span>
            <span class="film-play-cap">Answer {answer.n} &mdash; {answer.title.replace(/^hey Skippy — /, '')}</span>
          </button>
        </div>
        <figcaption class="film-cap"><span class="film-cap-title">{answer.title}</span></figcaption>
      </figure>
    )}

    <p class="films-credit">{CREDIT}</p>

    {/* Give it to me straight: three steps, no more. */}
    <div class="films-start" aria-labelledby="films-start-h">
      <p class="films-start-h" id="films-start-h">Start here</p>
      <ol class="films-steps">
        <li><span class="step-n" aria-hidden="true">1</span><span class="step-t"><strong>Watch.</strong> 39.4 is playing above. <a href="/films/">See every film &rarr;</a></span></li>
        <li><span class="step-n" aria-hidden="true">2</span><span class="step-t"><strong>Pick your experience.</strong> <a href="#experience">The rest of the page opens for you &rarr;</a></span></li>
        <li><span class="step-n" aria-hidden="true">3</span><span class="step-t"><strong>Join as a guide.</strong> If you already teach, <a href="/contact/">get in touch &rarr;</a> (18+ while we validate; guides first).</span></li>
      </ol>
    </div>
  </section>

  {/* Opening · Ouverture: the Sound Lab, the Gesture Lab and the call to
      universities, bilingual, under the DAX line (see the note in the frontmatter). */}
  <section class="home-w opening" id="opening" aria-labelledby="opening-h">
    <p class="op-kicker"><span class="op-beat" aria-hidden="true"></span>Opening&nbsp;<span class="op-dot">·</span>&nbsp;<span lang="fr">Ouverture</span></p>
    <h2 class="op-h" id="opening-h">Two labs and an open call.<span class="op-fr" lang="fr">Deux labos et un appel ouvert.</span></h2>
    <p class="op-sub">{OPENED ? 'The doors are open. Come in.' : 'The doors open soon. You can already look inside.'}
      <span class="op-fr" lang="fr">{OPENED ? 'Les portes sont ouvertes. Entrez.' : 'Les portes ouvrent bientôt. Vous pouvez déjà jeter un œil.'}</span></p>
    {/* 2026-11-04 (Jason: "an epic for Meta DAX"): one line to the epic, /metadax/epic/.
        data-astro-reload: that page has its own canvas and no client router. */}
    <p class="op-epic"><a href="/metadax/epic/" data-astro-reload><span class="op-epic-dot" aria-hidden="true"></span>Universal learning is aspirational. Meta DAX, version 0.0.0.1 &rarr;<span class="op-fr" lang="fr">L’apprentissage universel est une aspiration. Meta DAX, version 0.0.0.1</span></a></p>
    {/* 2026-11-05 (Jason): "say coming soon preview ... give every single highlight ... start
        collecting names". One modest line to /preview/; the order of the page is unchanged. No date. */}
    <p class="op-epic op-preview"><a href="/preview/"><span class="op-epic-dot" aria-hidden="true"></span>Coming soon &middot; Preview: everything we are building, and the preview list &rarr;<span class="op-fr" lang="fr">Bientôt &middot; Aperçu : tout ce que nous construisons, et la liste d’aperçu</span></a></p>
    <ul class="op-tiles">
      {labs.map((l) => (
        <li>
          <a class="op-tile" href={l.href} rel={l.ext ? 'noopener' : undefined}>
            <span class="op-img">
              <img src={`/opening/${l.img}.webp`} srcset={`/opening/${l.img}-600.webp 600w, /opening/${l.img}.webp 1200w`}
                sizes="(max-width: 40rem) 84vw, (max-width: 60rem) 40vw, 23rem"
                width="1200" height="630" loading="lazy" decoding="async" alt="" />
            </span>
            <span class="op-body">
              <span class="op-tag">{openState.en} · <span lang="fr">{openState.fr}</span></span>
              <strong class="op-name">{l.en}</strong>
              <span class="op-name-fr" lang="fr">{l.fr}</span>
              <span class="op-text">{l.textEn}</span>
              <span class="op-text op-fr" lang="fr">{l.textFr}</span>
              <span class="op-go">{l.goEn} &rarr; <span class="op-fr-inline" lang="fr">{l.goFr}</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="op-by">Cognition provided by <a href="https://www.obsidiandelta.com/">Obsidian Delta</a>, the Foundation&rsquo;s first sponsor.<span class="op-fr" lang="fr">Cognition fournie par Obsidian Delta, premier commanditaire de la Fondation.</span></p>
    <div class="op-look" aria-labelledby="op-look-h">
      <p class="op-look-h" id="op-look-h">The Gesture Lab, a first look&nbsp;<span class="op-dot">·</span>&nbsp;<span lang="fr">Le labo des gestes, un premier regard</span></p>
      <ol class="op-strip">
        {firstLook.map((f) => (
          <li class={f.w < 500 ? 'tall' : undefined}>
            <figure>
              <img src={`/opening/teaser-${f.n}.webp`} width={f.w} height={f.h} loading="lazy" decoding="async"
                alt={`${f.en} ${f.fr}`} />
              <figcaption><span class="op-n">{f.n}</span>{f.en}<span class="op-fr" lang="fr">{f.fr}</span></figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 2026-11-04: pick your experience first; everything under it waits for the pick */}
  <ExperiencePicker />

  <div class="xp-fold" id="xp-fold" data-xp-fold tabindex="-1">
  {/* the window: choose your experience, the live graph, the other three runs */}
  <div class="home-w">
    <MapHome exclude={["metadax"]} />
  </div>

  {/* Meta DAX, the one being built now, plays right here. The question bar sticks
      while the run is on screen and carries the experience switcher. */}
  <section class="home-run" id="learning" aria-labelledby="metadax">
    <RunHeader run="metadax" chapters={runChapters} level={2} headingId="metadax"
      kicker="Our initiative of universal learning. The one being built now: nine questions, written for your experience." />
    {runChapters.map((c) => <Chapter chapter={c} total={runChapters.length} inPage />)}
  </section>

  <section class="home-w further" aria-labelledby="further-h">
    <h2 class="further-h" id="further-h">Go further</h2>
    <div class="further-grid">
      <div class="fcol" style="--run: var(--run-metadax)" data-lens-scope>
        <h3>Meta DAX</h3>
        <p class="fl"><a href="/metadax/">The Meta DAX hub</a>. Pick your chair:</p>
        <ul class="chairs">
          {doors.map((d) => (<li><a href={d.href} title={d.text}>{d.kicker}</a></li>))}
        </ul>
        <p class="fl lens-detail">See it: the same recipe built each of these.</p>
        <ul class="sc lens-detail">
          {showcases.map((x) => (<li><a href={x.href} rel={x.rel}>{x.name}</a> <span>{x.note}</span></li>))}
        </ul>
        <p class="fl"><a href="/metadax/samples/">Every showcase and sample &rarr;</a></p>
        <p class="fl lens-basic"><a href="/metadax/guide/">Make your first lesson (about ten minutes) &rarr;</a></p>
        <p class="fl quiet lens-detail">The first thing the recipe built, in September: the
          <a href={newton.url} rel="noopener">Newton&rsquo;s laws run report</a> (report; simulated learner).</p>
        <p class="fl quiet">
          MetaDAX is free. It is built on paid compute. If it helped, a coffee on
          <a href="https://ko-fi.com/jeyanandan">Ko-fi</a> or a
          <a href="https://github.com/sponsors/ObsidianDelta">GitHub sponsorship</a>
          keeps it going.
        </p>
        <p class="fl quiet lens-basic"><button type="button" class="show-all-btn" data-show-all>Show all the links</button></p>
        {writingSeries.filter((x) => x.key === "for-parents").map((x) => (
          <p class="fl series lens-detail">Publications: <a href={`/writing/#series-${x.key}`}>{x.title}</a> &middot; {x.count} &middot; {x.blurb}</p>
        ))}
      </div>

      <div class="fcol" style="--run: var(--run-metadax)" data-lens-scope>
        <h3 id="research">The research</h3>
        <p class="body lens-basic">The short version: we try small things first and share every result, including the ones that didn&rsquo;t work out.</p>
        <p class="fl lens-basic"><a href="#03-built">In the run above: &ldquo;Has anyone built this before?&rdquo; &uarr;</a></p>
        <p class="fl quiet lens-basic"><button type="button" class="show-all-btn" data-show-all>Show the details</button></p>
        <p class="body lens-detail">
          The benchmark &mdash; a person who can communicate to a master&rsquo;s on
          five minutes a day &mdash; is audacious on purpose.
          <strong>We are developing this for all bandwidths!</strong> It rests on
          fourteen small experiments first, then the twelve scenes and X13 and X14.
          Twenty-four of the twenty-eight have now run, with models or scripts and
          never with a person, and several came back negative.
          The small ones are how we earn the big ones.
        </p>
        <ul class="links lens-detail">
          <li><a href="/metadax/research/">The research, the measure and the experiments &rarr;</a></li>
          <li><a href={findings}>The X13 / X14 findings</a></li>
          <li><a href="https://github.com/daxfoundation/metadax/blob/main/experiments/FINDINGS-20261019.md">The 18&ndash;19 October findings</a></li>
          <li><a href="#03-built">In the run above: &ldquo;Has anyone built this before?&rdquo; &uarr;</a></li>
        </ul>
        {writingSeries.filter((x) => x.key === "results").map((x) => (
          <p class="fl series lens-detail">Publications: <a href={`/writing/#series-${x.key}`}>{x.title}</a> &middot; {x.count} &middot; {x.blurb}</p>
        ))}
      </div>

      <div class="fcol" style="--run: var(--run-cp)" data-lens-scope>
        <h3 id="cp">Constraint Protocol</h3>
        {/* #constraint-protocol is kept as a second landing point for the section. */}
        <span id="constraint-protocol" aria-hidden="true"></span>
        <p class="big">The ground everything here stands on.</p>
        <p class="body lens-basic">One simple rule under everything: write it down, know who&rsquo;s responsible, and sign it.</p>
        <p class="fl lens-basic"><a href="/explain/constraint-protocol/">The short, friendly version: five questions &rarr;</a></p>
        <p class="fl quiet lens-basic"><button type="button" class="show-all-btn" data-show-all>Show the details</button></p>
        <p class="body lens-detail">
          A way for parties &mdash; people, companies or software &mdash; to declare
          in advance what they will not do, and then be checked against it. It keeps
          a signed record nobody can quietly edit, keeps witnessing and judging
          separate, and lets anyone dispute any record. DAX is one constraint built
          on it, and Meta DAX is meant to run on it; its protocol fields are reserved and empty today. The aim is that what one person works
          out compounds for everyone after them. A public working draft, run in full
          once so far.
        </p>
        <ul class="links lens-detail">
          <li><a href="/explain/constraint-protocol/">The guided version: five questions, written for your experience &rarr;</a></li>
          <li><a href="/constraint-protocol/">The Constraint Protocol, honestly: where v0.5 stands &rarr;</a></li>
          <li><a href="/metadax/research/#constraint-protocol">What that looks like, scene by scene</a></li>
          <li><a href="https://github.com/daxfoundation/constraint-protocol">The specification &mdash; CP-SPEC v0.5</a></li>
