---
import Base from '../../layouts/Base.astro';
import { posts, formatDate, SERIES, seriesOf } from '../_posts.js';

// /writing/ -- the Foundation's own pieces, added 2026-10-01. The long-form
// work behind the Foundation stays on jeyanandan.com (see Reading on the home
// page); what is here is written in the Foundation's voice, around the
// definitions: the reasoning, the measures, the consequences.
//
// 2026-10-18: series support. Published posts with a series field are grouped
// under their series block (title, blurb, parts in order). Posts without a
// series appear under "Other writing", newest first.
//
// Comments in the markup below are {/* ... */}, never <!-- ... -->.

// Series that have at least one published post.
const activeSeriesKeys = Object.keys(SERIES).filter(
  (k) => seriesOf(k).length > 0,
);

// Posts that belong to no series.
const otherPosts = posts.filter((p) => !p.series);
---
<Base
  title="Writing · DAX Foundation"
  description="Pieces written in the Foundation's voice, around its definitions: the reasoning, the measures, the consequences. Versioned, in public."
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="The DAX Foundation: Writing" href="https://daxfoundation.org/writing/feed.xml" />
  </Fragment>

  <section class="lede" aria-labelledby="writing">
    <h1 id="writing">Writing</h1>
    <p class="body">
      Pieces in the Foundation&rsquo;s voice, around the
      <a href="/definitions/">definitions</a>: the reasoning, the measures,
      the consequences. Each one shows when it was first published and when it
      last changed, and links its full history in the public record.
    </p>
  </section>

  {activeSeriesKeys.map((key) => {
    const meta = SERIES[key];
    const parts = seriesOf(key);
    return (
      <section class="block series-block" aria-labelledby={`series-${key}`}>
        <h2 id={`series-${key}`} class="series-title">{meta.title}</h2>
        <p class="series-blurb">{meta.blurb}</p>
        <ul class="rows">
          {parts.map((p) => (
            <li class="row">
              <span class="when">
                <time datetime={new Date(p.date).toISOString()}>{formatDate(p.date)}</time>
                {p.updated && new Date(p.updated) > new Date(p.date) && (
                  <span class="upd">Updated {formatDate(p.updated)}</span>
                )}
              </span>
              <span class="text">
                <a class="title" href={`/writing/${p.slug}/`}>{p.title}</a>
                {p.description && <p>{p.description}</p>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  {otherPosts.length > 0 && (
    <section class="block" aria-label={activeSeriesKeys.length > 0 ? 'Other writing' : 'Pieces'}>
      {activeSeriesKeys.length > 0 && <h2 class="other-heading">Other writing</h2>}
      <ul class="rows">
        {otherPosts.map((p) => (
          <li class="row">
            <span class="when">
              <time datetime={new Date(p.date).toISOString()}>{formatDate(p.date)}</time>
              {p.updated && new Date(p.updated) > new Date(p.date) && (
                <span class="upd">Updated {formatDate(p.updated)}</span>
              )}
            </span>
            <span class="text">
              <a class="title" href={`/writing/${p.slug}/`}>{p.title}</a>
              {p.description && <p>{p.description}</p>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {posts.length === 0 && <p class="body">Nothing published yet.</p>}
</Base>

<style>
  .lede { padding-block: 3.5rem 2.5rem; }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.012em;
  }
  .body { margin: 0; max-width: 36em; color: #cfcfcf; }
  .body a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .body a:hover, .body a:focus-visible { border-bottom-color: currentColor; }
  .block { padding-block: 1.25rem 2.25rem; border-top: 1px solid var(--line); }
  .series-title {
    margin: 0 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .series-blurb { margin: 0 0 1rem; max-width: 36em; color: #cfcfcf; font-size: 0.9375rem; }
  .other-heading {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 0.9rem;
  }
  .row + .row { border-top: 1px solid var(--line); }
  .when { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--muted); }
  .upd { color: var(--faint); }
  .text p { margin: 0.4rem 0 0; color: #cfcfcf; }
  .title { font-weight: 500; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--faint); }
  .title:hover, .title:focus-visible { border-bottom-color: currentColor; }
  @media (max-width: 34rem) {
    .lede { padding-block: 2.5rem 2rem; }
    .row { grid-template-columns: 1fr; }
  }
</style>
