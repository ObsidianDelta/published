---
import Base from '../../../../layouts/Base.astro';

// /metadax/guide/faq/ -- plain answers. The "does it save anything" answer quotes
// the player verbatim ("Nothing here is saved or sent anywhere." / "Everything
// runs in your browser."). Never a diagnosis; "a way, never the way"; the DAX
// Foundation, in the open. No feature claimed that the code or pages don't back.

const faqs = [
  {
    q: 'Is it free?',
    a: 'Yes, and it stays free. If you build the lesson yourself, it runs on an AI subscription you already pay for; the project is not charging you. If you use the web questionnaire instead, that costs nothing at all.',
  },
  {
    q: 'Does it save anything about us?',
    a: 'The player keeps nothing and sends nothing. In its own words: “Nothing here is saved or sent anywhere,” and “Everything runs in your browser.” The lesson file stays on your device. If you save a session to a learning record, that file downloads to your device too — nothing is uploaded. The one thing that ever leaves is a generic sample, and only if you choose to share one.',
  },
  {
    q: 'What ages is it for?',
    a: 'Roughly ages 4 to 18. A child uses their side with you beside them — it is built for an adult to run, not for a child on their own. There is no AI on the child’s side and it names no tool.',
  },
  {
    q: 'Does it replace our curriculum?',
    a: 'No. It is one way in for one child on one stuck spot — a way, never the way. Use it alongside whatever you already do, for the parts where something keeps going wrong.',
  },
  {
    q: 'What if my child is really struggling?',
    a: 'Describe what your child does — “covers the page after two tries,” “says the sounds but they stay apart” — and the lesson is built around that behaviour. Meta DAX never labels a child and never names a condition, anywhere. If you are worried, the right next step is to talk to a professional who can do an evaluation; the lesson will say so plainly when the signs warrant it, and it names nothing.',
  },
  {
    q: 'Do I need to be good at the subject myself?',
    a: 'No. Your page is written for where you are — it tells you what to say, what to skip, which slips are normal, and one line of why under each step. The part only you can do is notice your child and decide when to push on or stop.',
  },
  {
    q: 'Which AI do I need?',
    a: 'Any capable assistant you already pay for. There is a ready-made skill for assistants that read a SKILL.md, and a plain prompt for everything else. The task uses nothing specific to one product, and no AI vendor is named on your child’s side.',
  },
  {
    q: 'Is there an app to install?',
    a: 'No. The player is a web page. You can open it online, or save the page and use it offline. There is no account and no sign-up.',
  },
  {
    q: 'Can I print it instead of using a screen?',
    a: 'Yes. The player’s “Print this” gives you the learner page to work from and, on its own page at the end, a guide key with the answers and one line of why. Hand your child their pages; keep the key.',
  },
  {
    q: 'Can I teach more than one child from it?',
    a: 'Yes. Answer the questions once for the group, giving each child a nickname and a rough age, and the package carries each of them — one reads a part, the little ones do the hands-on part, the oldest does the explaining part.',
  },
  {
    q: 'What happens if I share a sample?',
    a: 'Only a generic version goes out — made-up names, nothing identifying — and only when you choose. You post it through a form, and a person reviews it before it ever appears in the public library.',
  },
  {
    q: 'Who makes it?',
    a: 'The DAX Foundation, in the open. Meta DAX is a research project, built in public on GitHub; what runs and what has not is all published there.',
  },
];
---
<Base title="Meta DAX for parents — questions and answers" description="Is it free? Does it save anything? What ages? Does it replace a curriculum? What if my child is struggling? Who makes it? Plain answers for parents." wide>
  <section class="lede">
    <p class="eyebrow"><a href="/metadax/">Meta DAX</a> &rsaquo; <a href="/metadax/guide/">Help</a> &rsaquo; Questions</p>
    <h1>Questions and answers</h1>
    <p class="lede-text">Plain answers to the things parents ask first.</p>
  </section>

  <section class="block">
    <dl class="faq">
      {faqs.map(({ q, a }) => (
        <div class="qa">
          <dt>{q}</dt>
          <dd>{a}</dd>
        </div>
      ))}
    </dl>
    <p class="out">
      <a href="/metadax/guide/">Back to the guide &rarr;</a>
      <span aria-hidden="true">&middot;</span>
      <a href="/metadax/homeschool/">What Meta DAX is, for parents</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://github.com/daxfoundation/metadax">The open repository</a>
    </p>
  </section>
</Base>

<style>
  .lede { padding-block: 3rem 2rem; }
  .eyebrow { margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover, .eyebrow a:focus-visible { color: var(--fg); }
  h1 { margin: 0 0 1.25rem; font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem); font-weight: 400; line-height: 1.22; letter-spacing: -0.012em; max-width: 20em; text-wrap: balance; }
  .lede-text { margin: 0; max-width: 40em; color: #cfcfcf; }

  .block { padding-block: 2.5rem; border-top: 1px solid var(--line); scroll-margin-top: 1.5rem; }

  .faq { margin: 0; max-width: 44em; }
  .qa { padding: 1.1rem 0; border-top: 1px solid var(--line); }
  .qa:first-child { border-top: 0; padding-top: 0; }
  .faq dt { font-size: 1.1rem; font-weight: 500; color: var(--fg); margin: 0 0 0.4rem; text-wrap: balance; }
  .faq dd { margin: 0; color: #cfcfcf; }

  .out { margin: 1.5rem 0 0; font-size: 0.9375rem; }
  .out span { color: var(--faint); margin-inline: 0.5rem; }
  .out a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .out a:hover, .out a:focus-visible { border-bottom-color: currentColor; }
</style>
