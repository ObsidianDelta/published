---
import Base from '../../../layouts/Base.astro';
import NotFinal from '../../../components/NotFinal.astro';
import data from '../../../data/metadax-samples.json';
import { samples as familySamples } from '../_showcase.js';
import { byKind } from '../../../data/library.js';

// /metadax/samples/ -- "See it", 2026-10-10 (five-chairs-doors). Three things,
// in order: the four deep showcases (with the universal line), the nine sample
// packages (filterable), and the six family pages three steps in (linking
// their existing /metadax/showcase/<slug>/ URLs). The six showcase pages did
// not move; they are linked here. Everyone here is made up; no family data.
const samples = data.samples || [];
const sampleCount = samples.length; // the real samples/ folder, counted at build
const subjects = Array.from(new Set(samples.map((s) => s.subject))).sort();
const ageBands = Array.from(new Set(samples.map((s) => s.age_band))).sort();
const repo = 'https://github.com/daxfoundation/metadax/blob/main';
// A sample's markdown links to a sibling as `other-sample.md` (right in the
// repo); on this page every sample sits at #<id>, so point there instead.
const onPage = (html) => (html || '').replace(/href="([a-z0-9-]+)\.md"/g, 'href="#$1"');

// The showcases and kits come from the one registry (src/data/library.js), so
// this page cannot fall behind when a new showcase lands. Editions nest under
// their kit. The chair pages each list their own; the whole library lives at
// /metadax/showcases/.
const byDateDesc = (a, b) => new Date(b.date) - new Date(a.date);
const shelf = [...byKind('showcase'), ...byKind('kit')].sort(byDateDesc);
const editions = byKind('edition');
const editionsFor = (id) => editions.filter((e) => e.id.startsWith(id + '-'));
const chairLabel = { parent: 'Parent', tutor: 'Tutor', teacher: 'Teacher', trainer: 'Trainer', researcher: 'Researcher' };
---
<Base title="Meta DAX: see it" description="The same recipe built every one of these: the showcases, the sample packages, and six family pages three steps in. Made-up names, nothing identifying. A way, never the way." wide>
  <section class="lede">
    <p class="eyebrow"><a href="/metadax/">Meta DAX</a> &rsaquo; See it</p>
    <h1>See it</h1>
    <p class="lede-text">
      Every one of these started as one sentence from a guide and what the
      learner already loves. Made-up names, nothing identifying. A way, never the
      way.
    </p>
    <p class="lib-line"><a href="/metadax/showcases/">The whole library, filterable by chair and language &rarr;</a></p>
  </section>
  <NotFinal />

  <section class="block showcases" aria-labelledby="h-showcases">
    <h2 id="h-showcases">Showcases</h2>
    <p class="universal">The same recipe built every one of these.</p>
    <div class="showcase-cards">
      {shelf.map((e) => (
        <article class="showcase-card">
          <p class="tags">
            {e.lang && <span class="tag">{e.lang}</span>}
            {(e.chairs || []).map((c) => <span class="tag">{chairLabel[c]}</span>)}
          </p>
          <h3 class="title">
            {e.external ? <a href={e.url} rel="noopener">{e.title}</a> : <a href={e.url} lang={e.lang === 'fr' ? 'fr' : undefined}>{e.title}</a>}
          </h3>
          <p>{e.note}</p>
          <p class="card-actions">
            <a href={e.url}>Open</a>
            {e.play && <a href={e.play}>Play</a>}
          </p>
          {editionsFor(e.id).map((ed) => (
            <p class="edition-line"><span class="tag">Edition</span> <a href={ed.url}>{ed.title}</a>{ed.play && <> &middot; <a href={ed.play}>Play</a></>}</p>
          ))}
        </article>
      ))}
    </div>
    <p class="showcase-note">Each showcase was built by the MetaDAX course factory from a short brief. Model-generated; reviewed for safety, not certified.</p>
  </section>

  <section class="block" aria-labelledby="h-filters">
    <h2 id="h-filters">Sample packages</h2>
    <p class="body">{sampleCount} packages built from parents&rsquo; descriptions: one page for the guide, one for the child.</p>
    <div class="filters" role="group" aria-label="Filter samples">
      <label>Subject
        <select id="f-subject">
          <option value="">All</option>
          {subjects.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      <label>Age band
        <select id="f-age">
          <option value="">All</option>
          {ageBands.map((a) => <option value={a}>{a}</option>)}
        </select>
      </label>
      <p class="count"><span id="shown">{sampleCount}</span> of {sampleCount} shown</p>
    </div>
    <ol class="list" id="list">
      {samples.map((s) => (
        <li class="item" id={s.id} data-subject={s.subject} data-age={s.age_band}>
          <details class="pkg">
            <summary>
              <span class="pkg-title">{s.title || s.id}</span>
              <span class="pkg-tags"><span class="tag">{s.subject}</span><span class="tag">Ages {s.age_band}</span></span>
            </summary>
            <p class="open-page"><a href={`/metadax/samples/${s.id}/`}>Open as a page &rarr;</a></p>
            <p class="stuck"><strong>Stuck:</strong> {s.stuck}</p>
            <p class="meta"><strong>Loves:</strong> {s.loves} &nbsp;&middot;&nbsp; <strong>Approach:</strong> {s.approach}</p>
            {s.record && (
              <p class="record"><a href={s.record}>See a learning record from this package &rarr;</a> <span class="note">published by the learner or guide</span></p>
            )}
            {s.companion && (
              <p class="record"><a href={s.companion}>Play with companion notes &rarr;</a> <span class="note">guide-facing sidecar notes, shown only to the guide</span></p>
            )}
            {s.link && (
              <p class="record"><a href={s.link}>Ouvrir le stade (3D) &rarr;</a></p>
            )}
            <details class="inner">
              <summary>Read the sample</summary>
              <div class="body" set:html={onPage(s.html)} />
              <p class="src"><a href={`${repo}/${s.path}`}>View the source markdown &rarr;</a></p>
            </details>
          </details>
        </li>
      ))}
    </ol>
    <p id="empty" class="empty" hidden>No samples match that filter.</p>
  </section>

  <section class="block" aria-labelledby="h-three">
    <h2 id="h-three">Three steps in</h2>
    <p class="body">
      Six family pages, three iterations in: the plan for step four, with steps
      one to three visible as history. One side for the guide, one made for the
      learner. These six now live here; they used to be the showcase.
    </p>
    <ol class="three">
      {familySamples.map((s) => (
        <li class="tri" id={s.id}>
          <a class="head" href={`/metadax/showcase/${s.id}/`}>
            <span class="swatch" aria-hidden="true">{s.swatch.map((c) => <i style={`background:${c}`}></i>)}</span>
            <span class="tri-title">{s.title}</span>
            <span class="tri-pair">{s.pair}</span>
          </a>
          <p class="tri-topic">{s.topic[0].toUpperCase() + s.topic.slice(1)}.</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block" aria-labelledby="h-share">
    <h2 id="h-share">Share one</h2>
    <p class="body">
      If you have run the <a href="https://github.com/daxfoundation/metadax/tree/main/skills/metadax-homeschool">homeschool skill</a>
      on your own, you are invited to offer a generic version through a
      <a href="https://github.com/daxfoundation/metadax/issues/new?template=share-a-sample.yml">&ldquo;Share a sample&rdquo; issue</a>.
      A person reviews each one before it appears here. A free GitHub account is all it needs.
    </p>
  </section>

  <script type="module">
    const subj = document.getElementById('f-subject');
    const age = document.getElementById('f-age');
    const items = Array.from(document.querySelectorAll('#list .item'));
    const shown = document.getElementById('shown');
    const empty = document.getElementById('empty');
    function apply() {
      let n = 0;
      for (const el of items) {
        const ok = (!subj.value || el.dataset.subject === subj.value) &&
                   (!age.value || el.dataset.age === age.value);
        el.hidden = !ok;
        if (ok) n++;
      }
      shown.textContent = String(n);
      empty.hidden = n !== 0;
    }
    subj.addEventListener('change', apply);
    age.addEventListener('change', apply);
  </script>

  <style>
    .lede { padding-block: 3rem 1.5rem; }
    .eyebrow { margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
    .eyebrow a { color: inherit; text-decoration: none; }
    .eyebrow a:hover, .eyebrow a:focus-visible { color: var(--fg); }
    h1 { margin: 0 0 1rem; font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem); font-weight: 400; line-height: 1.22; letter-spacing: -0.012em; }
    .lede-text { margin: 0; max-width: 40em; color: #cfcfcf; }
    .block { padding-block: 2.25rem; border-top: 1px solid rgba(128,128,128,.2); }
    h2 { margin: 0 0 .75rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
    .body { margin: .2rem 0 1rem; max-width: 40em; color: #cfcfcf; }
    .body a { color: inherit; }
    .universal { margin: 0 0 1rem; font-size: 1.15rem; color: var(--fg); }
    .showcase-cards { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); }
    .showcase-card { border:1px solid rgba(128,128,128,.3); border-radius:10px; padding:1rem 1.15rem; }
    .showcase-card .title { margin:.3rem 0 .4rem; }
    .showcase-card p { margin:.2rem 0; }
    .soon { font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:var(--faint); border:1px solid var(--line); border-radius:999px; padding:.05rem .45rem; vertical-align:middle; }
    .showcase-note { margin:.85rem 0 0; opacity:.75; font-size:.9rem; }
    .lib-line { margin:.75rem 0 0; font-size:.95rem; }
    .lib-line a { color:inherit; }
    .showcase-card .card-actions { margin:.5rem 0 0; display:flex; gap:.9rem; font-size:.9rem; }
    .showcase-card .card-actions a, .showcase-card .edition-line a { color:inherit; }
    .edition-line { margin:.5rem 0 0; font-size:.9rem; color:#bdbdbd; }
    .pkg > summary { cursor:pointer; list-style:none; display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.5rem; }
    .pkg > summary::-webkit-details-marker { display:none; }
    .pkg > summary::before { content:"\25B8"; margin-right:.5rem; color:var(--faint); }
    .pkg[open] > summary::before { content:"\25BE"; }
    .pkg-title { font-weight:600; font-size:1.05rem; }
    .pkg-tags { display:flex; gap:.5rem; }
    .pkg .inner { margin-top:.6rem; }
    .filters { display:flex; gap:1.25rem; align-items:end; flex-wrap:wrap; }
    .filters label { display:flex; flex-direction:column; gap:.25rem; font-weight:600; font-size:.9rem; }
    .filters select { font:inherit; padding:.4rem .5rem; min-width:10rem; }
    .filters .count { margin:0 0 .2rem auto; opacity:.7; font-size:.9rem; }
    .list { list-style:none; padding:0; margin:1rem 0 0; display:grid; gap:1rem; }
    .item { border:1px solid rgba(128,128,128,.3); border-radius:10px; padding:1rem 1.15rem; }
    .item[hidden] { display:none; }
    .tags { margin:0 0 .4rem; display:flex; gap:.5rem; }
    .tag { font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; border:1px solid rgba(128,128,128,.4); border-radius:999px; padding:.1rem .6rem; opacity:.85; }
    .item .title { margin:.1rem 0 .5rem; }
    .item .stuck, .item .meta { margin:.2rem 0; }
    .item .meta { opacity:.85; font-size:.95rem; }
    .item details { margin-top:.6rem; }
    .item summary { cursor:pointer; font-weight:600; }
    .item .body { margin-top:.75rem; }
    .item .body :global(h2) { font-size:1.05rem; margin:1rem 0 .3rem; }
    .item .open-page { margin:.5rem 0 .2rem; font-size:.9rem; }
    .item .open-page a { color:inherit; }
    .item .record { margin:.4rem 0; font-size:.95rem; }
    .item .record .note { opacity:.7; font-size:.85rem; }
    .item .src { margin-top:.5rem; font-size:.9rem; }
    .empty { opacity:.7; }

    .three { list-style:none; padding:0; margin:0; display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); }
    .tri { border:1px solid rgba(128,128,128,.3); border-radius:10px; padding:1rem 1.15rem; }
    .tri .head { display:block; text-decoration:none; color:inherit; }
    .swatch { display:flex; gap:3px; margin-bottom:.5rem; }
    .swatch i { display:block; width:14px; height:14px; border-radius:3px; }
    .tri-title { display:block; font-weight:600; font-size:1.1rem; }
    .tri-pair { display:block; color:#bdbdbd; font-size:.9rem; margin-top:.15rem; }
    .tri-topic { margin:.5rem 0 0; font-size:.9rem; color:#cfcfcf; }
  </style>
</Base>
