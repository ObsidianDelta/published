---
import Base from '../../layouts/Base.astro';

// /metadax/ -- "pick your chair", 2026-10-10 (five-chairs-doors).
//
// The hub used to carry every long section (the benchmark, guides and
// learners, the measure, how it works, underneath, the experiments, the
// Constraint Protocol, the ask). Those MOVED, unchanged in substance, to
// /metadax/research/. This page is now a short claim and five doors: Parent,
// Tutor, Teacher, Trainer, Researcher. Each door is one page in that guide's
// own words. "See it" points at the samples with the universal line; then the
// sponsor sentence.
//
// NO-LOSS: every old #anchor on this page still answers. The ones that moved
// forward to the matching anchor on /metadax/research/ (the script at the
// foot); #see-it still exists here.
//
// Rules: "guide" and "learner", never "role"; "a way, never the way"; no AI
// vendor named; "cognitive labour" is never qualified with "manual"; the
// Foundation is never a non-profit, charity, registered or incorporated body.

const doors = [
  {
    href: '/metadax/homeschool/',
    kicker: 'Parent',
    title: 'You homeschool',
    text: 'You know your child. Meta DAX does the rest of the preparing and hands you the next session, built through what they love.',
  },
  {
    href: '/metadax/tutor/',
    kicker: 'Tutor',
    title: 'You tutor',
    text: 'One learner, one stuck spot, one evening. Rough notes in, a plan for the next session and a parent-ready report out.',
  },
  {
    href: '/metadax/teacher/',
    kicker: 'Teacher',
    title: 'You teach a class',
    text: 'A class that nods and then fails the exit task. A hinge question, every wrong answer planned for, and the cognition handed back to you.',
  },
  {
    href: '/metadax/trainer/',
    kicker: 'Trainer',
    title: 'You train at work',
    text: 'A new hire, a first week, a process only you hold. A module built from a one-page brief, so the next hire starts a step ahead.',
  },
  {
    href: '/metadax/research/',
    kicker: 'Researcher',
    title: 'You want the evidence',
    text: 'The benchmark, the measure, how it works underneath, the experiments with their results, the Constraint Protocol, and the ask.',
  },
];

// Old anchors that now live on the research door. A link to any of them
// forwards there, so nothing that pointed at /metadax/#... is lost.
const moved = [
  'guides-and-learners', 'human-delta-value', 'how-it-works', 'underneath',
  'experiments', 'constraint-protocol', 'honest', 'ask', 'top',
];
---
<Base title="Meta DAX: pick your chair" description="Our initiative of universal learning. Every human being. Any subject. Any domain. Free, forever. Pick your chair: parent, tutor, teacher, trainer, researcher." wide>
  <section class="lede" id="see-it-top">
    <p class="eyebrow">Meta DAX</p>
    <h1>Every human being. Any subject. Any domain. Free, forever.</h1>
    <p class="lede-text">
      Our initiative of universal learning. Anyone a step ahead can be a guide;
      everyone is a learner. Meta DAX hands the two of you what you need for the
      next step together, built through what the learner already loves, and then
      gets out of the way. One recipe, five chairs. Pick yours.
    </p>
  </section>

  <section class="block" aria-labelledby="h-doors">
    <h2 id="h-doors">Pick your chair</h2>
    <ul class="doors">
      {doors.map((d) => (
        <li>
          <a href={d.href}>
            <span class="door-kicker">{d.kicker}</span>
            <span class="door-title">{d.title}</span>
            <span class="door-text">{d.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" id="see-it" aria-labelledby="h-see">
    <h2 id="h-see">See it</h2>
    <p class="big">The same recipe built every one of these.</p>
    <p class="body">
      Four deep showcases, nine sample packages, and six family pages three
      steps in: a mom and her eleven-year-old on fractions, a teacher and a
      newcomer, a grandson and his grandmother, a new manager, a first on-call
      shift, a teacher of teachers. Open any of them. Everyone in them is made up.
    </p>
    <p class="out"><a href="/metadax/samples/">See it &rarr;</a></p>
  </section>

  <section class="block" aria-labelledby="h-support">
    <h2 id="h-support">Keep it going</h2>
    <p class="body sponsor">
      MetaDAX is free. It is built on paid compute. If it helped, a coffee on
      <a href="https://ko-fi.com/jeyanandan">Ko-fi</a> or a
      <a href="https://github.com/sponsors/ObsidianDelta">GitHub sponsorship</a>
      keeps it going.
    </p>
    <p class="out">
      <a href="/metadax/research/">The research, the measure, the experiments &rarr;</a>
      <span aria-hidden="true">&middot;</span>
      <a href="https://github.com/daxfoundation/metadax">The repository</a>
    </p>
  </section>

  <script is:inline define:vars={{ moved }}>
    (function () {
      var id = decodeURIComponent(location.hash.slice(1));
      if (id && moved.indexOf(id) !== -1) {
        location.replace('/metadax/research/' + (id === 'top' ? '' : '#' + id));
      }
    })();
  </script>
</Base>

<style>
  .lede { padding-block: 3.5rem 2rem; }
  .eyebrow { margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  h1 { margin: 0 0 1.25rem; font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem); font-weight: 400; line-height: 1.22; letter-spacing: -0.012em; max-width: 22em; text-wrap: balance; }
  .lede-text { margin: 0; max-width: 40em; color: #cfcfcf; }

  .block { padding-block: 2.5rem; border-top: 1px solid var(--line); scroll-margin-top: 1.5rem; }
  h2 { margin: 0 0 1.25rem; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .big { margin: 0 0 1rem; font-size: clamp(1.25rem, 1rem + 1.2vw, 1.6rem); line-height: 1.3; letter-spacing: -0.01em; color: var(--fg); text-wrap: balance; max-width: 30em; }
  .body { margin: 0; max-width: 40em; color: #cfcfcf; }
  .body + .body { margin-top: 1rem; }
  .body a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .body a:hover, .body a:focus-visible { border-bottom-color: currentColor; }
  .sponsor { color: #bdbdbd; }

  .out { margin: 1.5rem 0 0; font-size: 0.9375rem; }
  .out span { color: var(--faint); margin-inline: 0.5rem; }
  .out a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint); }
  .out a:hover, .out a:focus-visible { border-bottom-color: currentColor; }

  /* Five doors. */
  .doors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .doors a { display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: 1.1rem 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: inherit; transition: border-color 0.15s ease; }
  .doors a:hover, .doors a:focus-visible { border-color: var(--muted); }
  .door-kicker { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .door-title { font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  .door-text { font-size: 0.9rem; line-height: 1.5; color: #bdbdbd; }

  @media (max-width: 44rem) { .doors { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .doors { grid-template-columns: 1fr; } .lede { padding-block: 2.5rem 1.5rem; } }
</style>
