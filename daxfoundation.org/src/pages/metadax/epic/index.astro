    <div class="hud" aria-hidden="true">
      <span class="hud-v">v<b id="hud-v">0.0.0.1</b></span>
      <span class="hud-line"><span class="hud-fill" id="hud-fill"></span><span class="hud-dot"></span></span>
      <span class="hud-one">1.0</span>
    </div>
    <button class="lang" id="lang" type="button" aria-label="Language: English or French / Langue : anglais ou français">
      <span class="lang-en">EN</span><span class="lang-sep">·</span><span class="lang-fr">FR</span>
    </button>

    <script>
      import type { EpicState, EpicHandle } from "../../../scenes/epic/substrate";

      const root = document.documentElement;

      // ---- EN / FR ----
      const langBtn = document.getElementById("lang") as HTMLButtonElement;
      function setLang(l: "en" | "fr") {
        if (l === "fr") { root.dataset.lang = "fr"; root.lang = "fr"; } else { delete root.dataset.lang; root.lang = "en"; }
        langBtn.setAttribute("aria-pressed", l === "fr" ? "true" : "false");
        try { localStorage.setItem("dax-epic-lang", l); } catch { /* private mode */ }
        requestAnimationFrame(measure);
      }
      langBtn.setAttribute("aria-pressed", root.dataset.lang === "fr" ? "true" : "false");
      langBtn.addEventListener("click", () => setLang(root.dataset.lang === "fr" ? "en" : "fr"));

      // ---- scroll -> state ----
      type V3 = [number, number, number];
      const STATES: Record<string, EpicState> = {
        hero:       { cam: [0, 1.5, 9],    look: [0, 34, -420], reveal: 0,  net: 0,    cluster: 0, inv: 0, both: 0, swap: 0,   dim: 1,    labels: 0.35 },
        horizon:    { cam: [7, 5, 17],     look: [0, 60, -700],   reveal: 0,  net: 0,    cluster: 0, inv: 0, both: 0, swap: 0,   dim: 1,    labels: 1 },
        substrateA: { cam: [0, 20, 34],    look: [0, 0, -4],     reveal: 22, net: 1,    cluster: 0, inv: 0, both: 0, swap: 0,   dim: 1,    labels: 0.25 },
        substrateB: { cam: [-14, 52, 70],  look: [0, 0, -8],     reveal: 95, net: 1,    cluster: 0, inv: 0, both: 0, swap: 0,   dim: 1,    labels: 0 },
        classroom:  { cam: [0, 5.2, 9.5],  look: [0, 0, 1],      reveal: 95, net: 0.22, cluster: 1, inv: 0, both: 0, swap: 0,   dim: 1,    labels: 0 },
        inverted:   { cam: [0, 4.6, 8],    look: [0, 0, 0.2],    reveal: 95, net: 0.2,  cluster: 1, inv: 1, both: 0, swap: 0,   dim: 1,    labels: 0 },
        both:       { cam: [3, 6.5, 11],   look: [0.6, 0, 0.3],  reveal: 95, net: 0.45, cluster: 1, inv: 1, both: 1, swap: 0.7, dim: 1,    labels: 0 },
        bench:      { cam: [0, 80, 95],    look: [0, 0, -10],    reveal: 95, net: 0.8,  cluster: 0, inv: 1, both: 1, swap: 0.3, dim: 0.45, labels: 0 },
        experiments:{ cam: [0, 9, 26],     look: [0, 60, -600],   reveal: 95, net: 0.4,  cluster: 0, inv: 1, both: 1, swap: 0,   dim: 0.3,  labels: 0 },
        principles: { cam: [26, 34, 56],   look: [0, 0, -14],    reveal: 95, net: 1,    cluster: 0, inv: 1, both: 1, swap: 1,   dim: 0.9,  labels: 0 },
        call:       { cam: [0, 1.5, 9],    look: [0, 34, -420], reveal: 95, net: 0.35, cluster: 0, inv: 1, both: 1, swap: 0.4, dim: 1,    labels: 0 },
      };
      const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-act]"));
      let mids: number[] = [];
      let maxScroll = 1;
      function measure() {
        const vh = innerHeight;
        mids = sections.map((s) => {
          const r = s.getBoundingClientRect();
          const top = r.top + scrollY;
          // a tall section holds its picture while its middle passes
          return top + Math.min(r.height, vh * 1.4) / 2 - vh / 2;
        });
        mids[0] = Math.min(mids[0], 0);
        maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
      }
      const sm = (t: number) => t * t * (3 - 2 * t);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const lerp3 = (a: V3, b: V3, t: number): V3 => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
      const cur: EpicState = { ...STATES.hero };
      let firstState = true;
      function targetState(y: number): EpicState {
        let i = 0;
        while (i < mids.length - 1 && y > mids[i + 1]) i++;
        const a = STATES[sections[i].dataset.act!];
        const bSec = sections[Math.min(i + 1, sections.length - 1)];
        const b = STATES[bSec.dataset.act!];
        const span = (mids[i + 1] ?? mids[i]) - mids[i];
        const t = span > 0 ? sm(Math.min(1, Math.max(0, (y - mids[i]) / span))) : 0;
        const out = {} as EpicState;
        (Object.keys(a) as (keyof EpicState)[]).forEach((k) => {
          const va = a[k], vb = b[k];
          (out as Record<string, unknown>)[k] = Array.isArray(va) ? lerp3(va as V3, vb as V3, t) : lerp(va as number, vb as number, t);
        });
        // portrait screens: pull side-on cameras toward the centre line, so the dot stays in frame
        if (innerWidth < innerHeight) out.cam = [out.cam[0] * 0.25, out.cam[1], out.cam[2]];
        return out;
      }
      // the camera follows the target with a little lag, so a flick of the thumb glides
      function getState(): EpicState {
        const tgt = targetState(scrollY);
        const k = firstState ? 1 : 0.12;
        firstState = false;
        (Object.keys(tgt) as (keyof EpicState)[]).forEach((key) => {
          const tv = tgt[key];
          if (Array.isArray(tv)) (cur as Record<string, unknown>)[key] = lerp3(cur[key] as V3, tv as V3, k);
          else (cur as Record<string, unknown>)[key] = lerp(cur[key] as number, tv as number, k);
        });
        return cur;
      }

      // ---- the HUD: how far down the line the reader has come ----
      const fill = document.getElementById("hud-fill")!;
      function hud() { fill.style.transform = `scaleX(${Math.min(1, Math.max(0, scrollY / maxScroll))})`; }

      // ---- text arrives as it scrolls in (motion only; without it everything shows) ----
      if (root.classList.contains("motion") && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((es) => {
          for (const e of es) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        }, { rootMargin: "0px 0px -12% 0px", threshold: 0.08 });
        document.querySelectorAll(".panel, .bench, .exp, .call, .ex").forEach((el) => { el.classList.add("pre"); io.observe(el); });
        const day = document.querySelector(".day");
        if (day) new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { day.classList.add("go"); o.disconnect(); } }, { threshold: 0.3 }).observe(day);
      }

      measure();
      addEventListener("resize", () => { measure(); handle?.resize(); }, { passive: true });
      addEventListener("load", measure);
      if ("ResizeObserver" in window) new ResizeObserver(() => measure()).observe(document.body);

      // ---- the scene (motion + WebGL2 only) ----
      let handle: EpicHandle | null = null;
      const labels = Array.from(document.querySelectorAll<HTMLElement>("[data-lab]"));
      async function boot() {
        if (!root.classList.contains("gl-pending")) { addEventListener("scroll", hud, { passive: true }); hud(); return; }
        try {
          const mod = await import("../../../scenes/epic/substrate");
          const cs = getComputedStyle(root);
          const v = (n: string) => cs.getPropertyValue(n).trim();
          const canvas = document.getElementById("epic-gl") as HTMLCanvasElement;
          const tickP = mod.TICKS.map((f) => mod.horizonPoint(f));
          handle = mod.mountEpic(canvas, { learner: v("--learner"), guide: v("--guide"), record: v("--record"), ink: v("--ink"), ground: v("--ground") || "#0a0a0a" }, getState, (h) => {
            hud();
            const st = cur;
            const an = h.clusterAnchors();
            const pts: Record<string, { p: V3; o: number }> = {
              now: { p: [0, 0.05, 0], o: st.labels * (1 - st.cluster) },
              t0: { p: tickP[0], o: st.labels },
              t1: { p: tickP[1], o: st.labels },
              t2: { p: tickP[2], o: st.labels },
              learner: { p: an.learner, o: st.cluster * Math.max(0, st.inv * 2 - 1) },
              guide: { p: an.guide, o: st.cluster * Math.max(0, st.inv * 2 - 1) },
            };
            for (const el of labels) {
              const d = pts[el.dataset.lab!];
              if (!d) continue;
              const q = h.project(d.p);
              const o = q.on ? d.o : 0;
              el.style.opacity = o > 0.02 ? String(Math.min(1, o)) : "0";
              if (o > 0.02) {
                // keep a label on screen (its width is read once, while it is visible)
                const wv = Number(el.dataset.w) || (el.dataset.w = String(el.offsetWidth + 24), el.offsetWidth + 24);
                const x = Math.min(q.x, innerWidth - wv);
                el.style.transform = `translate3d(${x.toFixed(1)}px, ${q.y.toFixed(1)}px, 0)`;
              }
            }
          });
          if (!handle) throw new Error("no webgl");
          root.classList.remove("gl-pending");
          root.classList.add("gl");
        } catch {
          root.classList.remove("gl-pending");
          addEventListener("scroll", hud, { passive: true }); hud();
        }
      }
      boot();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: var(--ground); --fg: var(--ink); --muted: var(--ink-muted); --faint: var(--ink-faint);
    --pass: var(--run-metadax); --caveat: var(--run-cp); --fail: var(--signal); --inc: var(--ink-muted);
    --gut: 16px;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; background: var(--ground); }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: var(--font-sans); font-size: var(--text-body-size); line-height: var(--text-body-line);
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  a { color: inherit; }
  :focus-visible { outline: 1px solid var(--focus); outline-offset: 3px; }

  /* the two languages: English unless html[data-lang="fr"] */
  html:not([data-lang="fr"]) .fr { display: none; }
  html[data-lang="fr"] .en { display: none; }

  /* the canvas sits behind everything, shown only once the scene is up */
  #epic-gl { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; display: none; }
  .gl #epic-gl, .gl-pending #epic-gl { display: block; }
  .gl-pending .still, .gl .still { display: none; }
  .labels { position: fixed; inset: 0; z-index: 1; pointer-events: none; display: none; }
  .gl .labels { display: block; }
  .lab {
    position: absolute; left: 0; top: 0; opacity: 0; white-space: nowrap;
    font: 500 12px/1.2 var(--font-mono); letter-spacing: 0.04em; color: var(--ink-muted);
    margin: -2.2em 0 0 0.6em; will-change: transform, opacity; text-shadow: 0 0 8px var(--ground);
  }
  .lab b { color: var(--ink); font-weight: 600; }
  .lab-now b { color: var(--learner); }
  .lab-one b { color: var(--ink); }
  .lab-l { color: var(--learner); margin: 1.1em 0 0 -2.4em; }
  .lab-g { color: var(--guide); margin: 1.1em 0 0 0.4em; }

  .chrome { position: relative; z-index: 3; }
  main { position: relative; z-index: 2; }
  .foot {
    position: relative; z-index: 2; display: flex; flex-wrap: wrap; justify-content: space-between;
    gap: 8px 24px; max-width: 72rem; margin: 0 auto; padding: 64px var(--gut) calc(88px + env(safe-area-inset-bottom));
    font-size: 14px; color: var(--ink-faint); background: var(--ground);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .foot a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .foot a:hover, .foot a:focus-visible { color: var(--ink); }

  /* ---- acts ---- */
  .act {
    position: relative; min-height: 115svh; display: flex; flex-direction: column; justify-content: flex-end;
    padding: 18svh var(--gut) 12svh; max-width: 72rem; margin: 0 auto;
  }
  .act-tall { min-height: 150svh; }
  .act-hero { min-height: 100svh; justify-content: flex-end; padding-top: 12svh; padding-bottom: 14svh; }
  /* phones: the hero text rides high, the dot and the line keep the lower half */
  @media (max-width: 51.99rem) and (orientation: portrait) {
    .gl .act-hero, .gl-pending .act-hero { justify-content: flex-start; padding-top: 9svh; }
  }
  @media (min-width: 52rem) {
    .act { justify-content: center; padding-inline: 32px; }
    .act-hero { justify-content: flex-end; }
  }
  .panel { max-width: 34rem; position: relative; text-shadow: 0 0 22px var(--ground), 0 0 3px var(--ground); }
  .panel::before {
    content: ""; position: absolute; inset: -10% -14%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgb(10 10 10 / 0.72), rgb(10 10 10 / 0));
  }
  .panel-hero { max-width: 60rem; }
  .panel-wide { max-width: 46rem; }
  .panel p { margin: 0 0 1em; color: var(--ink); }
  .kicker {
    margin: 0 0 18px; font-size: var(--text-label-size); letter-spacing: var(--text-label-tracking);
    text-transform: uppercase; color: var(--ink-muted); font-weight: 500;
  }
  .kdot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--learner); margin-right: 10px; vertical-align: 1px; box-shadow: 0 0 12px var(--learner); }
  .mega {
    margin: 0 0 22px; font-weight: 400; letter-spacing: -0.035em; line-height: 0.95;
    font-size: clamp(2.7rem, 0.9rem + 8.2vw, 7.6rem); text-wrap: balance;
  }
  .big { margin: 0 0 20px; font-weight: 400; letter-spacing: -0.02em; line-height: 1.08; font-size: clamp(1.7rem, 1.05rem + 3.1vw, 3.3rem); text-wrap: balance; }
  .lead { font-size: clamp(1.15rem, 0.95rem + 1vw, 1.6rem); line-height: 1.35; color: var(--ink); max-width: 36rem; }
  .ver { font-family: var(--font-mono); font-weight: 600; color: var(--learner); letter-spacing: 0; text-shadow: 0 0 18px rgb(247 180 82 / 0.45); }
  .cue { display: flex; align-items: center; gap: 12px; margin-top: 34px !important; font-size: 13px; color: var(--ink-muted) !important; letter-spacing: 0.08em; text-transform: uppercase; }
  .cue-line { width: 1px; height: 38px; background: linear-gradient(var(--learner), transparent); }
  .motion .cue-line { animation: cue 2.4s ease-in-out infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  .quote { margin: 0 0 1em; padding: 0; }
  .quote p { font-size: clamp(1.35rem, 1rem + 1.7vw, 2.1rem); line-height: 1.25; letter-spacing: -0.012em; margin: 0 0 14px; }
  .quote footer { font-size: 14px; color: var(--ink-muted); }
  .quote-xl p { font-size: clamp(1.5rem, 0.95rem + 2.6vw, 2.9rem); line-height: 1.15; }
  .note { color: var(--ink-muted) !important; border-left: 2px solid var(--guide); padding-left: 14px; }
  .note b { color: var(--guide); font-weight: 600; }

  .legend { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14px; color: var(--ink-muted); }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .sw { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .sw-l { background: var(--learner); box-shadow: 0 0 10px var(--learner); }
  .sw-g { background: var(--guide); box-shadow: 0 0 10px var(--guide); }
  .sw-k { width: 22px; height: 2px; border-radius: 1px; background: linear-gradient(90deg, transparent, #ffe2a8, transparent); }

  /* text arrival (motion only) */
  .motion .pre { opacity: 0; transform: translate3d(0, 28px, 0); transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1); }
  .motion .pre.in { opacity: 1; transform: none; }
  .motion .ex.pre { transform: translate3d(0, 12px, 0); transition-duration: 0.6s; }

  /* ---- stills (no motion / no WebGL) ---- */
  .still { margin: 32px 0 0; max-width: 52rem; width: 100%; }
  .still svg { width: 100%; height: auto; display: block; }
  .still-horizon { order: -1; margin: 0 0 40px; }
  .still-horizon .sv-t { font-size: 20px; }
  @media (max-width: 40rem) { .still-horizon .sv-t { font-size: 28px; } }
  .sv-t { font: 500 13px var(--font-mono); fill: var(--ink-muted); }
  .sv-now { fill: var(--learner); font-weight: 600; }
  .sv-link { stroke: var(--record); stroke-opacity: 0.18; stroke-width: 1; }
  .sv-learner { fill: var(--learner); fill-opacity: 0.85; }
  .sv-guide { fill: var(--guide); }
  .sv-seat { fill: var(--learner); fill-opacity: 0.55; }
  .sv-me { fill: var(--learner); }
  .sv-helper { fill: var(--record); }
  .sv-att { stroke: var(--record); stroke-opacity: 0.2; }
  .sv-att-in { stroke-opacity: 0.32; }
  .sv-gline { stroke: var(--guide); stroke-width: 1.5; }
  .sv-arrow { stroke: var(--ink-muted); fill: none; stroke-width: 1.5; }
  html:not([data-lang="fr"]) svg .fr, html[data-lang="fr"] svg .en { display: none; }

  /* ---- solid acts: the benchmark and the experiments ---- */
  .act-solid { max-width: none; min-height: auto; padding: 14svh var(--gut); justify-content: center; }
  .act-solid::before { content: ""; position: absolute; inset: 0; background: linear-gradient(rgb(10 10 10 / 0), rgb(10 10 10 / 0.86) 12%, rgb(10 10 10 / 0.86) 88%, rgb(10 10 10 / 0)); z-index: -1; }
  .bench { max-width: 72rem; margin: 0 auto; width: 100%; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 52rem) { .bench { grid-template-columns: 1.25fr 1fr; gap: 64px; } }
