---
// /metadax/epic/ -- Meta DAX, version 0.0.0.1 (2026-11-04, Jason 22:12: "I want a fucking
// epic for MetaDax. Universal learning... say that universal learning is aspirational.
// If this was 1.0, this would be version 0.0.0.1").
//
// One scroll-driven page. A single Three.js canvas (src/scenes/epic/substrate.ts) sits
// fixed behind the text; scroll turns into a state per section (camera, how far the
// network has grown, the inversion, the role swap) and the scene draws it. The text is
// the page: with no script, no WebGL, or prefers-reduced-motion, every section shows a
// still picture drawn here at build time, and nothing moves.
//
// Stack: the Explainer Kit's own (Astro, three from package.json, tokens.css). No new
// framework, no webfont, no analytics: the od-no-beacon meta keeps tools/cf-beacon.mjs
// off this page. EN/FR: every string is a pair (components/epic/T.astro); the toggle
// sets html[data-lang] and remembers it per browser.
//
// Copy rules (out/RULES-LAUNCH.md, out/story/STORY.md section 0): no legal-status claim,
// no AI vendor names, the Constraint Protocol not mentioned, guide/learner vocabulary,
// a result only where a dated run produced it, "simulated" where models played people.
// The experiment list and its tally come from src/data/metadax-epic.js.
import "../../../styles/tokens.css";
import "../../../styles/colour.css";
import SiteHeader from "../../../components/SiteHeader.astro";
import SeoJsonLd from "../../../components/SeoJsonLd.astro";
import T from "../../../components/epic/T.astro";
import { core, extension, newest, VERDICT, MODE, tally, seeded } from "../../../data/metadax-epic.js";

const title = "Meta DAX, version 0.0.0.1";
const description = "Universal learning is aspirational. If it were 1.0, Meta DAX is version 0.0.0.1: the substrate we are trying to build, every experiment so far (run and not yet run), and how to build with us.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// ---- build-time stills (reduced motion, no WebGL, no script) ----
// 1. the horizon, in perspective: 0.0.0.1 -> 1.0 on a log scale
// f = 0 at 0.0.0.1, 1/3 at 0.0.1, 2/3 at 0.1, 1 at 1.0: each step moves the digit one place
const hx = (f: number) => {
  const p = 1 - 1 / (1 + 3 * f);     // compress toward the far end
  return 46 + 724 * (p / 0.75);
};
const horizonTicks = [
  { x: hx(1 / 3), s: "0.0.1" }, { x: hx(2 / 3), s: "0.1" }, { x: hx(1), s: "1.0" },
];

// 2. the substrate: a small network, the same every build
const rnd = seeded(1104);
const nodes = Array.from({ length: 150 }, () => {
  const r = 34 + Math.pow(rnd(), 0.8) * 330;
  const th = rnd() * Math.PI * 2;
  return { x: 400 + r * Math.cos(th), y: 210 + r * Math.sin(th) * 0.5, g: rnd() < 0.24, s: 2 + rnd() * 1.6 };
}).filter((n) => n.x > 8 && n.x < 792 && n.y > 8 && n.y < 412);
const links: { x1: number; y1: number; x2: number; y2: number }[] = [];
{
  const seen = new Set<string>();
  nodes.forEach((a, i) => {
    const near = nodes
      .map((b, j) => ({ j, d: (a.x - b.x) ** 2 + (a.y - b.y) ** 2 }))
      .filter((o) => o.j !== i)
      .sort((p, q) => p.d - q.d)
      .slice(0, 2);
    for (const { j } of near) {
      const k = i < j ? `${i}-${j}` : `${j}-${i}`;
      if (seen.has(k)) continue;
      seen.add(k);
      links.push({ x1: a.x, y1: a.y, x2: nodes[j].x, y2: nodes[j].y });
    }
  });
}
const r1 = (n: number) => Math.round(n * 10) / 10;

// 3. the inversion: a classroom, then one learner with thirty around her
const seats = Array.from({ length: 30 }, (_, i) => ({ x: 70 + (i % 6) * 46, y: 150 + Math.floor(i / 6) * 40 }));
const ring = Array.from({ length: 30 }, (_, i) => {
  const th = (i / 30) * Math.PI * 2;
  const rr = 112 + 14 * Math.sin(i * 1.7);
  return { x: 590 + rr * Math.cos(th), y: 190 + rr * Math.sin(th) * 0.78 };
});
const gHelpers = Array.from({ length: 8 }, (_, i) => {
  const th = (i / 8) * Math.PI * 2;
  return { x: 662 + 26 * Math.cos(th), y: 236 + 22 * Math.sin(th) };
});

// 4. the day: 288 five-minute steps, one lit
const dayTicks = Array.from({ length: 288 }, (_, i) => {
  const a = (i / 288) * Math.PI * 2 - Math.PI / 2;
  const long = i % 12 === 0;
  const r0 = long ? 118 : 124, r2 = 134;
  return { x1: r1(150 + r0 * Math.cos(a)), y1: r1(150 + r0 * Math.sin(a)), x2: r1(150 + r2 * Math.cos(a)), y2: r1(150 + r2 * Math.sin(a)), lit: i === 0, long };
});

// 5. the zoom: every experiment inside the first sliver of the line
const zoomItems = [...core, ...extension, ...newest];
const zx = (i: number) => 40 + (720 * (i + 0.5)) / zoomItems.length;

---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DAX Foundation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:locale:alternate" content="fr_CA" />
    <meta name="od-no-beacon" content="no analytics on this page" />
    <SeoJsonLd />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var q = new URLSearchParams(location.search).get("lang");
          var l = q === "fr" || q === "en" ? q : localStorage.getItem("dax-epic-lang");
          if (l === "fr") { d.dataset.lang = "fr"; d.lang = "fr"; }
        } catch (e) {}
        var rm = false;
        try { rm = matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
        if (!rm) {
          d.classList.add("motion");
          if ("WebGL2RenderingContext" in window && new URLSearchParams(location.search).get("lite") !== "1") d.classList.add("gl-pending");
        }
      })();
    </script>
  </head>
  <body>
    <canvas id="epic-gl" aria-hidden="true"></canvas>
    <div class="labels" id="epic-labels" aria-hidden="true">
      <span class="lab lab-now" data-lab="now"><b>0.0.0.1</b> <T en="we are here" fr="nous sommes ici" /></span>
      <span class="lab" data-lab="t0">0.0.1</span>
      <span class="lab" data-lab="t1">0.1</span>
      <span class="lab lab-one" data-lab="t2"><b>1.0</b> <T en="universal learning" fr="l’apprentissage universel" /></span>
      <span class="lab lab-l" data-lab="learner"><T en="the learner" fr="l’apprenant" /></span>
      <span class="lab lab-g" data-lab="guide"><T en="the guide" fr="le guide" /></span>
    </div>

    <div class="chrome"><SiteHeader /></div>

    <main id="epic">
      {/* 0. hero */}
      <section class="act act-hero" data-act="hero" aria-labelledby="h-hero">
        <div class="panel panel-hero">
          <p class="kicker"><span class="kdot" aria-hidden="true"></span><T en="Meta DAX · universal learning" fr="Meta DAX · l’apprentissage universel" /></p>
          <h1 id="h-hero" class="mega"><T en="Universal learning is aspirational." fr="L’apprentissage universel est une aspiration." /></h1>
          <p class="lead"><T en="If this were version 1.0, today is version <b class='ver'>0.0.0.1</b>." fr="Si c’était la version 1.0, nous serions aujourd’hui à la version <b class='ver'>0.0.0.1</b>." /></p>
          <p class="cue" aria-hidden="true"><span class="cue-line"></span><T en="Scroll down the line" fr="Descendez le long de la ligne" /></p>
        </div>
        <figure class="still still-horizon" aria-hidden="true">
          <svg viewBox="0 0 800 220" role="presentation">
            <defs>
              <radialGradient id="g-now"><stop offset="0" stop-color="var(--learner)" stop-opacity="1" /><stop offset="1" stop-color="var(--learner)" stop-opacity="0" /></radialGradient>
              <linearGradient id="g-line" x1="0" x2="1"><stop offset="0" stop-color="var(--record)" stop-opacity="0.9" /><stop offset="1" stop-color="var(--record)" stop-opacity="0.15" /></linearGradient>
            </defs>
            <line x1="46" y1="150" x2="770" y2="150" stroke="url(#g-line)" stroke-width="1.5" />
            {horizonTicks.map((t, i) => (
              <g>
                <line x1={r1(t.x)} y1="143" x2={r1(t.x)} y2="157" stroke="var(--record)" stroke-opacity={i === 2 ? 0.9 : 0.45} />
                <text x={r1(t.x)} y="180" text-anchor="middle" class="sv-t">{t.s}</text>
              </g>
            ))}
            <circle cx="46" cy="150" r="26" fill="url(#g-now)" opacity="0.55" />
            <circle cx="46" cy="150" r="5" fill="var(--learner)" />
            <text x="46" y="118" class="sv-t sv-now">0.0.0.1</text>
            <text x="46" y="102" class="sv-t en">we are here</text>
            <text x="46" y="102" class="sv-t fr">nous sommes ici</text>
          </svg>
        </figure>
      </section>

      {/* 1. the horizon */}
      <section class="act" data-act="horizon" aria-labelledby="h-horizon">
        <div class="panel">
          <p class="kicker"><T en="The horizon" fr="L’horizon" /></p>
          <h2 id="h-horizon" class="big"><T en="That dot is everything that exists today." fr="Ce point, c’est tout ce qui existe aujourd’hui." /></h2>
          <p><T en="Open recipes for building a course. A few dozen small tests: many simulated, some failed, every failure published. The rest of the line is the work." fr="Des recettes ouvertes pour bâtir un cours. Quelques dizaines de petits essais : beaucoup simulés, certains ratés, chaque échec publié. Le reste de la ligne, c’est le travail." /></p>
        </div>
      </section>

      {/* 2. the substrate, first light */}
      <section class="act" data-act="substrateA" aria-labelledby="h-sub">
        <div class="panel">
          <p class="kicker"><T en="The substrate" fr="Le substrat" /></p>
          <blockquote class="quote" id="h-sub">
            <p><T en="“These experiments are trying to figure out how we start to create a distributed, decentralized substrate for compounding knowledge and intelligence.”" fr="« Ces expériences cherchent comment commencer à créer un substrat distribué et décentralisé où le savoir et l’intelligence fructifient. »" /></p>
            <footer><T en="The founder, 4 November 2026" fr="Le fondateur, 4 novembre 2026" /></footer>
          </blockquote>
        </div>
        <figure class="still" aria-hidden="true">
          <svg viewBox="0 0 800 420" role="presentation">
            {links.map((l) => <line x1={r1(l.x1)} y1={r1(l.y1)} x2={r1(l.x2)} y2={r1(l.y2)} class="sv-link" />)}
            {nodes.map((n) => <circle cx={r1(n.x)} cy={r1(n.y)} r={r1(n.s)} class={n.g ? "sv-guide" : "sv-learner"} />)}
            <circle cx="400" cy="210" r="20" fill="url(#g-now)" opacity="0.6" />
            <circle cx="400" cy="210" r="5" fill="var(--learner)" />
          </svg>
        </figure>
      </section>

      {/* 3. the substrate, grown */}
      <section class="act act-tall" data-act="substrateB" aria-labelledby="h-sub2">
        <div class="panel">
          <h2 id="h-sub2" class="big"><T en="Every question becomes a node. Every node gives the next learner a head start." fr="Chaque question devient un nœud. Chaque nœud donne une longueur d’avance au prochain apprenant." /></h2>
          <p><T en="A learner’s question is checked against the saved ones: reuse, extend, or new. Guides fork courses and publish them. Records keep where everything came from. The light is what one person’s learning leaves for the next." fr="La question d’un apprenant est comparée à celles déjà gardées : réutiliser, prolonger ou créer. Les guides reprennent des cours et les publient. Les dossiers gardent la provenance de tout. La lumière, c’est ce que l’apprentissage d’une personne laisse à la suivante." /></p>
          <ul class="legend" aria-label="Legend">
            <li><span class="sw sw-l"></span><T en="learners" fr="apprenants" /></li>
            <li><span class="sw sw-g"></span><T en="guides" fr="guides" /></li>
            <li><span class="sw sw-k"></span><T en="knowledge, flowing on" fr="le savoir, qui circule" /></li>
          </ul>
        </div>
      </section>

      {/* 4. the classroom */}
      <section class="act" data-act="classroom" aria-labelledby="h-class">
        <div class="panel">
          <p class="kicker"><T en="The inversion" fr="L’inversion" /></p>
          <h2 id="h-class" class="big"><T en="Today: thirty learners, one teacher’s attention." fr="Aujourd’hui : trente apprenants, l’attention d’un seul enseignant." /></h2>
        </div>
        <figure class="still" aria-hidden="true">
          <svg viewBox="0 0 800 380" role="presentation">
            {seats.map((s) => <line x1={s.x} y1={s.y} x2="185" y2="70" class="sv-att" />)}
            {seats.map((s, i) => <circle cx={s.x} cy={s.y} r={i === 2 ? 6 : 4.5} class={i === 2 ? "sv-me" : "sv-seat"} />)}
            <circle cx="185" cy="70" r="7" class="sv-guide" />
            <path d="M 370 190 L 430 190 M 418 180 L 430 190 L 418 200" class="sv-arrow" />
            {ring.map((h) => <line x1={r1(h.x)} y1={r1(h.y)} x2="590" y2="190" class="sv-att sv-att-in" />)}
            {ring.map((h) => <circle cx={r1(h.x)} cy={r1(h.y)} r="4" class="sv-helper" />)}
            <line x1="662" y1="236" x2="590" y2="190" class="sv-gline" />
            {gHelpers.map((h) => <circle cx={r1(h.x)} cy={r1(h.y)} r="2.4" class="sv-helper" />)}
            <circle cx="590" cy="190" r="18" fill="url(#g-now)" opacity="0.6" />
            <circle cx="590" cy="190" r="7" class="sv-me" />
            <circle cx="662" cy="236" r="6.5" class="sv-guide" />
          </svg>
        </figure>
      </section>

      {/* 5. inverted */}
      <section class="act" data-act="inverted" aria-labelledby="h-inv">
        <div class="panel">
          <h2 id="h-inv" class="big"><T en="Inverted: thirty attentions on one learner." fr="Inversé : trente attentions sur un seul apprenant." /></h2>
          <p><T en="Companions and agents around each person, every one of them paying attention to her. The guide stays beside her, and decides what she needs." fr="Des compagnons et des agents autour de chaque personne, chacun attentif à elle. Le guide reste à ses côtés, et décide de ce dont elle a besoin." /></p>
        </div>
      </section>

      {/* 6. guide and learner */}
      <section class="act act-tall" data-act="both" aria-labelledby="h-both">
        <div class="panel">
          <h2 id="h-both" class="big"><T en="Whoever is a step ahead is the guide." fr="Celui qui a un pas d’avance est le guide." /></h2>
          <p><T en="Right now, on this. Tomorrow, on something else, the two trade places. Everyone is a learner." fr="Ici, maintenant, sur ce sujet. Demain, sur autre chose, les deux changent de place. Tout le monde apprend." /></p>
          <p class="note"><T en="<b>Human delta value.</b> Bring out the best in the guide, so the guide brings out the best in the learner. It runs both ways: the guide gets helpers too." fr="<b>La valeur delta humaine.</b> Faire ressortir le meilleur du guide, pour que le guide fasse ressortir le meilleur de l’apprenant. Ça va dans les deux sens : le guide a aussi ses aides." /></p>
        </div>
      </section>

      {/* 7. the benchmark */}
      <section class="act act-solid act-bench" data-act="bench" aria-labelledby="h-bench">
        <div class="bench">
          <div class="bench-text">
            <p class="kicker"><T en="The bar we set" fr="La barre que nous plaçons" /></p>
            <blockquote class="quote quote-xl" id="h-bench">
              <p><T en="“Take a person who can communicate, and get them to the equivalent of a master’s degree ... on five minutes of connectivity a day.”" fr="« Prendre une personne qui sait communiquer, et l’amener à l’équivalent d’une maîtrise… avec cinq minutes de connexion par jour. »" /></p>
            </blockquote>
            <p class="pair"><T en="We are developing this for all bandwidths." fr="Nous le développons pour tous les débits." /></p>
            <p class="honest"><T en="A target, not a result. E06 computed that a week’s round trip fits a 50 kbps link; no one has measured it on a real one yet. X06, simulated: a week of one course is 7% of the allowance." fr="Une cible, pas un résultat. E06 a calculé que l’aller-retour d’une semaine passe sur un lien à 50 kb/s ; personne ne l’a encore mesuré sur un vrai lien. X06, simulée : une semaine d’un cours, c’est 7 % du forfait." /></p>
          </div>
          <figure class="day">
            <svg viewBox="0 0 300 300" role="img" aria-labelledby="day-cap">
              <g class="day-ticks">
                {dayTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.lit ? "dt dt-lit" : t.long ? "dt dt-long" : "dt"} />)}
              </g>
              <line x1="150" y1="150" x2="150" y2="22" class="day-hand" />
              <text x="150" y="146" text-anchor="middle" class="day-n">5</text>
              <text x="150" y="172" text-anchor="middle" class="day-of en">of 1,440 minutes</text>
              <text x="150" y="172" text-anchor="middle" class="day-of fr">sur 1 440 minutes</text>
            </svg>
            <figcaption id="day-cap"><T en="One day, in five-minute steps. One of them is lit." fr="Une journée, par tranches de cinq minutes. Une seule est allumée." /></figcaption>
          </figure>
        </div>
      </section>

      {/* 8. the experiments */}
      <section class="act act-solid act-exp" data-act="experiments" aria-labelledby="h-exp" id="experiments">
        <div class="exp">
          <p class="kicker"><T en="Version 0.0.0.1, in full" fr="La version 0.0.0.1, en entier" /></p>
          <h2 id="h-exp" class="big"><T en="Zoom into the dot." fr="Zoomez dans le point." /></h2>
          <figure class="zoom" aria-hidden="true">
            <svg viewBox="0 0 800 150" role="presentation">
              <line x1="40" y1="24" x2="760" y2="24" class="z-line" />
              <circle cx="40" cy="24" r="4" fill="var(--learner)" />
              <text x="40" y="12" class="sv-t">0.0.0.1</text>
              <text x="760" y="12" text-anchor="end" class="sv-t">1.0</text>
              <path d="M 37 30 L 40 104 M 44 30 L 760 104" class="z-mag" />
              <line x1="40" y1="112" x2="760" y2="112" class="z-line z-line-in" />
              {zoomItems.map((e, i) => <circle cx={r1(zx(i))} cy="112" r="5.5" class={`z-dot v-${e.verdict}`} />)}
              {zoomItems.map((e, i) => (i % 2 === 0 ? <text x={r1(zx(i))} y="138" text-anchor="middle" class="z-id">{e.id}</text> : null))}
            </svg>
          </figure>
          <p class="exp-intro"><T en="Every experiment so far, with its own verdict. <b>Simulated</b>: models played the people. <b>Deterministic</b>: a script, no model. <b>Not yet run</b>: no result exists, whatever a plan says." fr="Toutes les expériences à ce jour, avec leur propre verdict. <b>Simulée</b> : des modèles ont joué les personnes. <b>Déterministe</b> : un script, sans modèle. <b>Pas encore lancée</b> : aucun résultat n’existe, quoi qu’en dise un plan." /></p>

          <dl class="tally">
            <div><dt><T en="core experiments designed" fr="expériences de base conçues" /></dt><dd>{tally.designed}</dd></div>
            <div><dt><T en="have run at least once" fr="ont tourné au moins une fois" /></dt><dd>{tally.run}</dd></div>
            <div><dt><T en="not yet run" fr="pas encore lancées" /></dt><dd>{tally.notRun}</dd></div>
            <div class="zero"><dt><T en="with a real human guide or learner" fr="avec un vrai guide ou apprenant humain" /></dt><dd>{tally.withPeople}</dd></div>
          </dl>

          {[
            { key: "core", en: "Core experiments, E01 to E14", fr: "Expériences de base, E01 à E14", items: core },
            { key: "ext", en: "Extensions, X01 to X14 (run with a model or a script in the people’s chairs)", fr: "Prolongements, X01 à X14 (un modèle ou un script à la place des personnes)", items: extension },
            { key: "new", en: "The newest run", fr: "Le plus récent", items: newest },
          ].map((g) => (
            <section class="ex-group" aria-label={g.en}>
              <h3><T en={g.en} fr={g.fr} /></h3>
              <ol class="ex-list">
                {g.items.map((e) => (
                  <li class={`ex v-${e.verdict}`}>
                    <span class="ex-head"><span class="ex-dot" aria-hidden="true"></span><span class="ex-id">{e.id}</span>
                      <span class="ex-v"><T en={VERDICT[e.verdict].en} fr={VERDICT[e.verdict].fr} />{MODE[e.mode].en && <span class="ex-m"> · <T en={MODE[e.mode].en} fr={MODE[e.mode].fr} /></span>}</span></span>
                    <span class="ex-q"><T en={e.en} fr={e.fr} /></span>
                    <span class="ex-r"><T en={e.rEn} fr={e.rFr} /></span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <p class="exp-links">
            <a href="https://github.com/daxfoundation/metadax/tree/main/experiments" rel="noopener"><T en="Every card and every record, in public" fr="Chaque fiche et chaque résultat, en public" /> &rarr;</a>
            <a href="/writing/fourteen-small-experiments/"><T en="Fourteen small experiments, and why small first" fr="Quatorze petites expériences, et pourquoi petit d’abord (en anglais)" /> &rarr;</a>
          </p>
          <p class="exp-truth"><T en="The parts that make knowledge compound (reuse, provenance, append-only records, bandwidth) mostly hold in simulation. The parts that keep people safe (the age wall, the leak gate, expert review) are where the failures are. That is the right order to find them in." fr="Les pièces qui font fructifier le savoir (réutilisation, provenance, dossiers en ajout seul, débit) tiennent surtout en simulation. Les pièces qui protègent les gens (le contrôle d’âge, la barrière contre les fuites, la revue experte) sont là où sont les échecs. C’est le bon ordre pour les trouver." /></p>
        </div>
      </section>

      {/* 9. how it is built */}
      <section class="act act-tall" data-act="principles" aria-labelledby="h-pr">
        <div class="panel panel-wide">
