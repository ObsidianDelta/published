---
// /explain/ — the foundation board (00: the map) with the doors into the runs.
// PART D: the doors are the runs listed from the signed graph (src/data/graph.json):
// one door per initiative node (Meta DAX, Nova DAX, Skippy DAX) plus the Protocol,
// each door showing that node's own line. A door links to its run where one exists
// today; an initiative with no run yet shows its line and reads as "Ahead", never a
// dead link. 2026-10-23: all four runs exist (EXP-12 built Nova DAX and Skippy DAX),
// and the Protocol door opens its explainer run, not the older /constraint-protocol/.
import Explain from "../../layouts/Explain.astro";
import Chapter from "../../components/explain/Chapter.astro";
import { getCollectionChapters } from "../../lib/explain/chapters.js";
import graph from "../../data/graph.json";

const chapters = await getCollectionChapters("foundation");
const map = chapters[0];

// The runs that have a destination today. An initiative with no entry here is
// still ahead: its door shows the line and is not a link.
const routes: Record<string, string> = {
  metadax: "/explain/metadax/",
  "constraint-protocol": "/explain/constraint-protocol/",
  "nova-dax": "/explain/nova-dax/",
  "skippy-dax": "/explain/skippy-dax/",
};

// One door per initiative node, then the Protocol — in the graph's own order.
const doorNodes = [
  ...graph.nodes.filter((n) => n.kind === "initiative"),
  ...graph.nodes.filter((n) => n.kind === "protocol"),
];
const doors = doorNodes.map((n) => ({
  id: n.id,
  label: n.label,
  line: n.line,
  href: n.chapter ? routes[n.chapter] ?? null : null,
}));
---
<Explain
  title="What is the DAX Foundation?"
  description="DAX: the preservation and expansion of life, humanity, and consciousness. The Constraint Protocol and Meta DAX."
>
  {map && <Chapter chapter={map} total={9} />}
  <nav class="doors" aria-label="The runs">
    <ul>
      {doors.map((d) => (
        <li>
          {d.href ? (
            <a href={d.href} class="door">
              <span class="door-label">{d.label}</span>
              <span class="door-line">{d.line}</span>
            </a>
          ) : (
            <span class="door door-ahead">
              <span class="door-label">{d.label}</span>
              <span class="door-line">{d.line}</span>
              <span class="door-tag">Ahead</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</Explain>

<style>
  .doors {
    width: 100%;
    max-width: var(--measure-scene);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-24);
  }
  .doors ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .doors ul { grid-template-columns: repeat(2, 1fr); } }
  .door {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 72px;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  a.door:hover, a.door:focus-visible { border-color: var(--ink); }
  .door-label { font-size: var(--text-lead-size); font-weight: 500; }
  .door-line { color: var(--ink-muted); font-size: var(--text-body-size); }
  .door-ahead { opacity: 0.72; position: relative; }
  .door-tag {
    position: absolute; top: var(--space-4); right: var(--space-6);
    font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
