---
// /explain/metadax/<id>/ — the same continuous scroll, scrolled to <id> on load.
// Shareable per-chapter URLs; one scroll. getStaticPaths enumerates the chapters;
// the canonical is this page's own URL (the layout computes it from the path).
import Explain from "../../../layouts/Explain.astro";
import Chapter from "../../../components/explain/Chapter.astro";
import { getCollectionChapters } from "../../../lib/explain/chapters.js";

export async function getStaticPaths() {
  const chapters = await getCollectionChapters("metadax");
  return chapters.map((c) => ({ params: { id: c.data.id }, props: { chapters, id: c.data.id } }));
}

const { chapters, id } = Astro.props;
const here = chapters.find((c) => c.data.id === id);
const title = here ? `${here.data.question.en} — Meta DAX` : "Meta DAX";
---
<Explain
  title={title}
  description="The job that is left, built once already, turned inside out: Meta DAX, the DAX Foundation's universal learning initiative."
>
  {chapters.map((c) => <Chapter chapter={c} total={chapters.length} />)}
  <script is:inline define:vars={{ id }}>
    // Jump to the shared chapter without smooth animation (respect the pin).
    const go = () => {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: "auto", block: "start" });
    };
    if (document.readyState !== "loading") go();
    else document.addEventListener("DOMContentLoaded", go);
  </script>
</Explain>
