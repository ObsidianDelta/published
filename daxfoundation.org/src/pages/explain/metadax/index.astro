---
// /explain/metadax/ — all eight Meta DAX chapters as one continuous scroll.
import Explain from "../../../layouts/Explain.astro";
import Chapter from "../../../components/explain/Chapter.astro";
import { getCollectionChapters } from "../../../lib/explain/chapters.js";

const chapters = await getCollectionChapters("metadax");
---
<Explain
  title="Meta DAX — universal learning"
  description="The job that is left, built once already, turned inside out: Meta DAX, the DAX Foundation's universal learning initiative."
>
  {chapters.map((c) => <Chapter chapter={c} total={chapters.length} />)}
</Explain>
