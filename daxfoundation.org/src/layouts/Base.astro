---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
}
const {
  title = 'DAX Foundation',
  description = 'DAX: preservation and expansion of life, humanity, and consciousness.',
  image = 'metadax',
  wide = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${image}.png`, Astro.site);

// 2026-09-20: the footer used to carry "Canadian not-for-profit" in its right
// corner. It is gone at Jason's request, and nothing has taken its place: the
// Foundation is not incorporated yet, so any sentence here about its legal
// status -- incorporated, registered, charitable, or a softer wording of the
// same claim -- would be a claim it cannot stand behind. This footer says the
// name. When incorporation actually happens, the claim can come back with a
// number behind it.
//
// This note is in the frontmatter, not an HTML comment: this layout wraps
// every page on the site, so an <!-- --> here ships on all of them.
//
// 2026-09-29: the definitions moved to their own page, so the masthead carries
// one link to it, in the same quiet register as the mark.
//
// 2026-10-01: /writing/ is new (the Foundation's own pieces), so the masthead
// carries a second link. The footer links the public record and the one page
// that explains how everything here is published, Jason's "How I Publish".
//
// 2026-10-05: Meta DAX has its own section of the site (/metadax/, with the
// showcase and the page for parents who homeschool), so the masthead leads
// with it. Pages may pass `wide` for a slightly wider column.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DAX Foundation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="wrap top">
      <a class="mark" href="/">DAX Foundation</a>
      <nav class="nav" aria-label="Site">
        <a class="mark" href="/metadax/">Meta DAX</a>
        <a class="mark" href="/definitions/">Definitions</a>
        <a class="mark" href="/writing/">Writing</a>
      </nav>
    </header>
    <main class:list={['wrap', { wide }]}>
      <slot />
    </main>
    <footer class="wrap foot">
      <span>DAX Foundation</span>
      <span class="foot-links">
        <a href="https://github.com/ObsidianDelta/published/tree/main/daxfoundation.org">Versioned, in public</a>
        <a href="https://jeyanandan.com/blog/how-i-publish/">How this is published</a>
      </span>
      <p class="ecosystem">One body of work: jeyanandan.com (the writing) · daxfoundation.org (MetaDAX, the open commons) · obsidiandelta.com (the company: done-for-you services) · formaddie.com (Maddie)</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0a;
    --fg: #e8e8e8;
    --muted: #8c8c8c;
    --faint: #5c5c5c;
    --line: #1e1e1e;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
  a { color: inherit; }
  .wrap {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding-inline: 1.5rem;
  }
  .wrap.wide { max-width: 52rem; }
  .top {
    padding-block: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .mark {
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mark:hover, .mark:focus-visible { color: var(--fg); }
  .nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; justify-content: flex-end; }
  @media (max-width: 26rem) { .top { flex-wrap: wrap; } .nav { gap: 0.5rem 0.9rem; } }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 3rem 2.5rem;
    font-size: 0.8125rem;
    color: var(--faint);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .ecosystem { flex-basis: 100%; margin: 0.75rem 0 0; color: var(--faint); line-height: 1.6; }
  .foot a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .foot a:hover, .foot a:focus-visible { color: var(--fg); }
  :focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
</style>
