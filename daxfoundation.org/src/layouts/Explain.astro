---
// The explainer's own layout (Explainer Kit v1, spec section 4). Base.astro is
// NOT reused: this copies the Base head tags (title, description, canonical, og,
// favicon, theme-color) and the two-line footer verbatim, adds one Google Fonts
// link for Fraunces, imports the generated tokens, and draws NO masthead -- each
// chapter draws its own row. inlineStylesheets is 'always' in astro.config, so
// the token import ships inline.
import "../styles/tokens.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  siteName?: string;
}
const {
  title = "DAX Foundation",
  description = "DAX: preservation and expansion of life, humanity, and consciousness.",
  image,
  ogType = "website",
  siteName = "DAX Foundation",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(`/og/${image}.png`, Astro.site) : new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Fraunces for the question and display numerals only; the body uses the
         system stack. One css2 link, display=swap, variable optical size. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&display=swap"
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <span>DAX Foundation</span>
      <span class="foot-links">
        <a href="https://github.com/ObsidianDelta/published/tree/main/daxfoundation.org">Versioned, in public</a>
        <a href="https://jeyanandan.com/blog/how-i-publish/">How this is published</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
  a { color: inherit; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    width: 100%;
    max-width: var(--measure-scene);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
    font-size: var(--text-small-size);
    color: var(--faint);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .foot a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .foot a:hover, .foot a:focus-visible { color: var(--fg); }
  :focus-visible { outline: 1px solid var(--focus); outline-offset: 3px; }
</style>
