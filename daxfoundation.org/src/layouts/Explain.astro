---
// The explainer's own layout (Explainer Kit v1, spec section 4). Base.astro is
// NOT reused: this copies the Base head tags (title, description, canonical, og,
// favicon, theme-color) and the two-line footer verbatim, adds one Google Fonts
// link for Fraunces, imports the generated tokens, and draws NO masthead -- each
// chapter draws its own row. inlineStylesheets is 'always' in astro.config, so
// the token import ships inline.
import "../styles/tokens.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  siteName?: string;
}
const {
  title = "DAX Foundation",
  description = "DAX: preservation and expansion of life, humanity, and consciousness.",
  image,
  ogType = "website",
  siteName = "DAX Foundation",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(`/og/${image}.png`, Astro.site) : new URL("/og.png", Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Fraunces for the question and display numerals only; the body uses the
         system stack. One css2 link, display=swap, variable optical size. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&display=swap"
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <!-- Reading hairline: a 2px bar, width = scroll fraction (EXP-8a item 5). -->
    <div class="reading-rule" id="reading-rule" aria-hidden="true"></div>

    <!-- The site's own masthead/nav, from Base.astro, so /explain reads as
         daxfoundation.org and not a separate site (EXP-8a item 5). -->
    <header class="site-top">
      <a class="mark" href="/">DAX Foundation</a>
      <nav class="site-nav" aria-label="Site">
        <a class="mark" href="/metadax/">Meta DAX</a>
        <a class="mark" href="/definitions/">Definitions</a>
        <a class="mark" href="/writing/">Writing</a>
      </nav>
    </header>

    <!-- The lens chooser: the chapter is written for whoever is reading. Chosen
         lens is remembered in localStorage and applied to every chapter on the
         page without a reload (the chapters listen for the "dax-lens" event). -->
    <section class="chooser" aria-labelledby="chooser-h">
      <p class="chooser-h" id="chooser-h">Who's reading? The chapter is written for you.</p>
      <div class="chips" id="lens-chips" role="group" aria-label="Who's reading">
        <button type="button" class="chip" data-lens="curious" aria-pressed="true">Just curious</button>
        <button type="button" class="chip" data-lens="teacher" aria-pressed="false">I teach</button>
        <button type="button" class="chip" data-lens="parent" aria-pressed="false">I'm a parent</button>
        <button type="button" class="chip" data-lens="builder" aria-pressed="false">I build software</button>
        {/* SLOT: "Someone else…" (a reader's own edition) is NOT shipped in this
            ask -- it needs the widget sampling transport (EXP-6). Add the chip
            and its panel here when that transport lands. */}
      </div>
    </section>

    <main>
      <slot />
    </main>
    <footer class="foot">
      <span>DAX Foundation</span>
      <span class="foot-links">
        <a href="https://github.com/ObsidianDelta/published/tree/main/daxfoundation.org">Versioned, in public</a>
        <a href="https://jeyanandan.com/blog/how-i-publish/">How this is published</a>
      </span>
    </footer>

    <script>
      // The lens chooser and the reading hairline. localStorage under
      // `dax-explain-lens`, try/catch so private mode never throws. Changing the
      // lens dispatches "dax-lens"; the chapters redraw themselves (no reload).
      const LENS_KEY = "dax-explain-lens";
      const LENSES = ["curious", "teacher", "parent", "builder"];

      function readLens(): string {
        try {
          const v = localStorage.getItem(LENS_KEY);
          return v && LENSES.includes(v) ? v : "curious";
        } catch {
          return "curious";
        }
      }
      function writeLens(v: string): void {
        try {
          localStorage.setItem(LENS_KEY, v);
        } catch {
          /* private mode: the choice simply does not persist */
        }
      }

      function paintChips(lens: string): void {
        document.querySelectorAll<HTMLElement>("#lens-chips .chip").forEach((c) => {
          c.setAttribute("aria-pressed", c.dataset.lens === lens ? "true" : "false");
        });
      }

      function wireChooser(): void {
        const chips = document.getElementById("lens-chips");
        if (!chips || (chips as any).__wired) return;
        (chips as any).__wired = true;
        chips.addEventListener("click", (e) => {
          const chip = (e.target as Element | null)?.closest<HTMLElement>(".chip");
          const lens = chip?.dataset.lens;
          if (!lens) return;
          writeLens(lens);
          paintChips(lens);
          document.dispatchEvent(new CustomEvent("dax-lens", { detail: lens }));
        });
        paintChips(readLens());
      }

      // Reading hairline: width = how far down the page the reader is.
      let ticking = false;
      function onScroll(): void {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const rule = document.getElementById("reading-rule");
          if (!rule) return;
          const vh = window.innerHeight;
          const sh = document.documentElement.scrollHeight;
          const y = window.scrollY || document.documentElement.scrollTop;
          rule.style.width = (sh > vh ? (y / (sh - vh)) * 100 : 0) + "%";
        });
      }

      function boot(): void {
        wireChooser();
        onScroll();
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      document.addEventListener("astro:page-load", boot);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
  a { color: inherit; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    width: 100%;
    max-width: var(--measure-scene);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
    font-size: var(--text-small-size);
    color: var(--faint);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .foot a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
  .foot a:hover, .foot a:focus-visible { color: var(--fg); }
  :focus-visible { outline: 1px solid var(--focus); outline-offset: 3px; }

  /* Reading hairline, fixed at the very top of the page. */
  .reading-rule {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--record);
    z-index: 20;
  }

  /* Site masthead/nav, matching Base.astro's quiet register. */
  .site-top {
    width: 100%;
    max-width: var(--measure-scene);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .site-top .mark {
    text-decoration: none;
    font-size: var(--text-label-size);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .site-top .mark:hover, .site-top .mark:focus-visible { color: var(--fg); }
  .site-nav { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); justify-content: flex-end; }

  /* The lens chooser. */
  .chooser {
    width: 100%;
    max-width: var(--measure-scene);
    margin: 0 auto;
    padding: var(--space-6) var(--space-6) 0;
    display: grid;
    gap: var(--space-3);
  }
  .chooser-h { margin: 0; font-size: var(--text-small-size); color: var(--ink-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    min-height: 40px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: var(--text-small-size);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .chip:hover { color: var(--fg); }
  .chip[aria-pressed="true"] { border-color: var(--record); color: var(--fg); }
  .chip:focus-visible { outline: 2px solid var(--record); outline-offset: 3px; }
</style>
