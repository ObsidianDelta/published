---
// MapHome (EXP-10): the map chapter at the top of the home page. The Foundation
// drawn as ONE signed graph (src/data/graph.json), revealed by reading level: a
// lens chooser, the graph scene, the question and the reading ladder. Jason, 23
// Oct 2026: the Constraint Protocol is not a half of the picture; it is what the
// edges are made of. Reading level is how much of the graph you see.
//
// This component drives the graph scene itself (mount + setProgress + setLevel +
// setLabels) so it does not depend on the explainer layout; the scene stays behind
// the kit contract (src/scenes/contract.ts). Tokens are imported so the scene can
// read --learner/--guide/--record off :root.
import "../../styles/tokens.css";
import graph from "../../data/graph.json";
import lenses from "../../data/lenses.json";
import { getCollectionChapters } from "../../lib/explain/chapters.js";

const chapters = await getCollectionChapters("foundation");
const map = chapters[0];
const editions = (map?.editions ?? {}) as Record<string, any>;

// The runs each node opens: real destinations only (ahead runs have none yet).
// 2026-10-23: all four runs exist (EXP-12 built Nova DAX and Skippy DAX); the
// Protocol node opens its explainer run rather than the older /constraint-protocol/.
const routes: Record<string, string> = {
  metadax: "/explain/metadax/",
  "constraint-protocol": "/explain/constraint-protocol/",
  "nova-dax": "/explain/nova-dax/",
  "skippy-dax": "/explain/skippy-dax/",
};

// The labels the scene reads, per lens: the edition's labels merged over the
// graph's signed defaults and the chapter's declared scene labels. The scene
// bakes no text; everything it draws comes from here.
const baseLabels = (map?.data.scene?.params?.labels ?? {}) as Record<string, any>;
const labelsByLens: Record<string, any> = {};
for (const l of lenses) {
  labelsByLens[l.id] = { ...baseLabels, ...((editions[l.id]?.labels) ?? {}) };
}
const levelByLens: Record<string, number> = Object.fromEntries(lenses.map((l) => [l.id, l.level]));
const question = map?.data.question?.en ?? "What is the DAX Foundation?";

// Static run-node links: every node whose chapter resolves to a live route gets a
// real <a href> in the server-rendered HTML, so keyboard and touch users can reach
// it without waiting for the JS scene to boot. sr-only visually; fully traversable.
const runLinks = graph.nodes.filter(
  (n) => n.chapter && routes[n.chapter as string],
);

const levelNames = [
  "DAX and the three it builds",
  "the same, in plain words",
  "the people and the record",
  "the Protocol as its own node",
  "the whole graph",
];
---
<section class="maphome" aria-labelledby="map-q" data-maphome>
  <div class="chooser">
    <p class="chooser-h">Who&rsquo;s reading? The map is drawn for you.</p>
    <div class="chips" id="map-chips" role="group" aria-label="Who's reading">
      {lenses.map((l) => (
        <button type="button" class="chip" data-lens={l.id} data-level={l.level}
          aria-pressed={l.id === "curious" ? "true" : "false"}>{l.label}</button>
      ))}
    </div>
  </div>

  <div class="map-grid">
    <div class="scene-col">
      <div class="scene-frame" data-scene="graph" aria-hidden="true"></div>
    </div>
    <div class="map-words">
      <h2 class="map-q" id="map-q">{question}</h2>
      <p class="map-sub">It is one graph. Every line is the Constraint Protocol: every action recorded, accountable, signed.</p>
      {/* "Now showing" live region: updated by JS when the reading level changes. */}
      <p class="level-notice" id="graph-level-notice" aria-live="polite" aria-atomic="true"></p>
      <p class="ladder-h">Reading level — how much of the graph you see</p>
      <ol class="ladder" id="map-ladder" aria-label="Reading level">
        {[1, 2, 3, 4, 5].map((n) => (
          <li><button type="button" class="rung" data-level={n} aria-pressed={n === 2 ? "true" : "false"}>
            <span class="rung-n">{n}</span>
            <span class="rung-t">{levelNames[n - 1]}</span>
          </button></li>
        ))}
      </ol>
      <p class="map-more"><a href="/explain/">Open the map full-screen &rarr;</a></p>
    </div>
  </div>

  {/* Static sr-only fallback: real <a href> for every run node in the graph. This
      satisfies keyboard navigation and tests without depending on the JS scene. */}
  <nav class="graph-nodes-sr" aria-label="Graph node links">
    <ul>
      {runLinks.map((n) => (
        <li><a href={routes[n.chapter as string]}>{n.label} — {n.line}</a></li>
      ))}
    </ul>
  </nav>

  <script type="application/json" data-graph set:html={JSON.stringify(graph)} />
  <script type="application/json" data-routes set:html={JSON.stringify(routes)} />
  <script type="application/json" data-labels set:html={JSON.stringify({ labelsByLens, levelByLens })} />
</section>

<script>
  import { readTokens, clamp01 } from "../../scenes/contract";
  import { resolve } from "../../scenes/registry";

  const LENS_KEY = "dax-explain-lens";
  const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;

  function readJson(sel: string): any {
    const el = document.querySelector(sel);
    try { return JSON.parse(el?.textContent || "{}"); } catch { return {}; }
  }
  function storedLens(ids: string[]): string {
    try { const v = localStorage.getItem(LENS_KEY); return v && ids.includes(v) ? v : "curious"; }
    catch { return "curious"; }
  }

  async function boot(): Promise<void> {
    const root = document.querySelector<HTMLElement>("[data-maphome]");
    if (!root || (root as any).__booted) return;
    (root as any).__booted = true;
    const frame = root.querySelector<HTMLElement>('[data-scene="graph"]');
    if (!frame) return;
    const graph = readJson("[data-graph]");
    const routes = readJson("[data-routes]");
    const { labelsByLens, levelByLens } = readJson("[data-labels]");
    const ids = Object.keys(labelsByLens || {});
    let lens = storedLens(ids);

    let mod: any = null;
    try {
      const r = resolve("graph");
      const ns: any = REDUCED ? await r.loadFallback().catch(() => r.load()) : await r.load();
      mod = ns?.default ?? ns;
    } catch { mod = null; }
    if (!mod || typeof mod.mount !== "function") return; // page still reads without the scene

    const handle = await mod.mount(frame, {
      labels: labelsByLens[lens] || {},
      params: { graph, routes },
      reducedMotion: REDUCED,
      locale: "en",
      maxPixelRatio: 2,
    }, readTokens());

    let curLevel = levelByLens[lens] || 2;
    if (typeof handle.setLevel === "function") handle.setLevel(curLevel);

    const LEVEL_NAMES = [
      "DAX and the three it builds",
      "the same, in plain words",
      "the people and the record",
      "the Protocol as its own node",
      "the whole graph",
    ];

    function paint(sel: string, attr: string, val: string): void {
      root!.querySelectorAll<HTMLElement>(sel).forEach((b) =>
        b.setAttribute("aria-pressed", b.dataset[attr] === val ? "true" : "false"));
    }

    function showLevelNotice(n: number): void {
      const notice = root!.querySelector<HTMLElement>("#graph-level-notice");
      if (notice) notice.textContent = `Now showing: Level ${n} — ${LEVEL_NAMES[n - 1] || ""}`;
    }

    function scrollSceneIntoView(): void {
      if (window.innerWidth > 700) return;
      const sceneEl = root!.querySelector<HTMLElement>(".scene-col");
      if (sceneEl) sceneEl.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function applyLens(next: string): void {
      lens = next;
      try { localStorage.setItem(LENS_KEY, next); } catch { /* private mode */ }
      paint("#map-chips .chip", "lens", next);
      if (typeof handle.setLabels === "function") handle.setLabels(labelsByLens[next] || {});
      setLevel(levelByLens[next] || 2, true);
    }
    function setLevel(n: number, fromUser = false): void {
      curLevel = n;
      paint("#map-ladder .rung", "level", String(n));
      if (typeof handle.setLevel === "function") handle.setLevel(n);
      if (fromUser) {
        showLevelNotice(n);
        scrollSceneIntoView();
      }
    }

    paint("#map-chips .chip", "lens", lens);
    paint("#map-ladder .rung", "level", String(curLevel));

    root.querySelector("#map-chips")?.addEventListener("click", (e) => {
      const chip = (e.target as Element | null)?.closest<HTMLElement>(".chip");
      if (chip?.dataset.lens) applyLens(chip.dataset.lens);
    });
    root.querySelector("#map-ladder")?.addEventListener("click", (e) => {
      const rung = (e.target as Element | null)?.closest<HTMLElement>(".rung");
      if (rung?.dataset.level) setLevel(Number(rung.dataset.level), true);
    });

    // t: a gentle settle driven by how far the map has scrolled through its box.
    let raf = 0;
    function onScroll(): void {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const rect = root!.getBoundingClientRect();
        const span = rect.height - window.innerHeight;
        const t = span > 0 ? clamp01(-rect.top / span) : clamp01(-rect.top / window.innerHeight);
        if (typeof handle.setProgress === "function") handle.setProgress(t);
      });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => { handle.resize?.(); onScroll(); }, { passive: true });
    onScroll();
  }

  document.addEventListener("astro:page-load", boot);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else { boot(); }
</script>

<style>
  .maphome { padding-block: var(--space-10, 2.5rem) var(--space-8, 2rem); border-bottom: 1px solid var(--line); }
  .chooser { display: grid; gap: 0.6rem; margin-bottom: 1.5rem; }
  .chooser-h { margin: 0; font-size: 0.875rem; color: var(--ink-muted, #9a9a9a); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 40px; padding: 0.35rem 0.9rem; border: 1px solid var(--line);
    border-radius: 999px; background: transparent; color: var(--ink-muted, #9a9a9a);
    font: inherit; font-size: 0.875rem; cursor: pointer;
  }
  .chip[aria-pressed="true"] { border-color: var(--record, #c9a227); color: var(--fg, #fff); }
  .chip:focus-visible { outline: 2px solid var(--record, #c9a227); outline-offset: 3px; }

  .map-grid { display: grid; gap: 1.5rem; }
  .scene-col {
    position: relative; height: 56vh; min-height: 320px; background: var(--ground, #0a0a0a);
    border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
  }
  .scene-frame { width: 100%; height: 100%; }

  .map-q {
    font-family: var(--font-display, Fraunces, Georgia, serif); font-weight: 400;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.5rem); line-height: 1.1; margin: 0 0 0.75rem;
    letter-spacing: -0.012em; text-wrap: balance;
  }
  .map-sub { margin: 0 0 1rem; max-width: 34em; color: #cfcfcf; }
  .level-notice {
    font-size: 0.8125rem;
    color: var(--ink-muted, #9a9a9a);
    margin: 0 0 0.75rem;
    min-height: 1.25em;
  }
  .ladder-h {
    margin: 0 0 0.5rem; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-faint, #6f6f6f);
  }
  .ladder { list-style: none; margin: 0 0 1.25rem; padding: 0; display: grid; gap: 0.25rem; }
  .rung {
    width: 100%; display: flex; align-items: baseline; gap: 0.75rem; min-height: 40px;
    background: none; border: 0; border-top: 1px solid var(--line); color: var(--ink-muted, #9a9a9a);
    font: inherit; text-align: left; cursor: pointer; padding: 0.4rem 0;
  }
  .rung-n { font-family: var(--font-mono, ui-monospace, monospace); color: var(--ink-faint, #6f6f6f); }
  .rung[aria-pressed="true"] { color: var(--fg, #fff); }
  .rung[aria-pressed="true"] .rung-n { color: var(--record, #c9a227); }
  .rung:focus-visible { outline: 2px solid var(--record, #c9a227); outline-offset: 2px; }
  .map-more { margin: 0; font-size: 0.9375rem; }
  .map-more a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--faint, #6f6f6f); }
  .map-more a:hover, .map-more a:focus-visible { border-bottom-color: currentColor; }

  /* Narrow: scroll scene into view when level changes (via JS); make the grid
     a start-aligned column so the map-words don't float oddly next to a tall scene. */
  @media (max-width: 700px) {
    .map-grid { align-items: start; }
  }
  @media (min-width: 52rem) {
    .map-grid { grid-template-columns: 1.2fr 1fr; align-items: start; }
    .scene-col { height: min(64vh, 560px); position: sticky; top: 1rem; }
  }

  /* sr-only fallback nav: real <a href> links for run nodes; visually hidden. */
  .graph-nodes-sr {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .graph-nodes-sr ul { list-style: none; margin: 0; padding: 0; }
</style>
