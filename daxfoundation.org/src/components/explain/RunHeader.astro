---
// RunHeader (2026-10-23): the top of a run's page, said once. Jason: the run pages
// repeated "DAX Foundation", a counter pill and a "Live now" pill on every chapter.
// Now: the run's name in its colour, its one line (graph.json), and a strip of its
// questions (1..N) that shows where the reader is and jumps to any question. The
// language note that sat on every chapter is said here once. Sticky under the
// top menu, so the reader always knows which run and which question they are on.
import graph from "../../data/graph.json";
import lenses from "../../data/lenses.json";

interface Props {
  run: "metadax" | "nova-dax" | "skippy-dax" | "constraint-protocol";
  chapters: any[];
  /** 2 when the run sits under another page's H1 (the homepage, 2026-10-24) */
  level?: 1 | 2;
  /** one line under the run's name (the homepage: "Our initiative of universal learning, …") */
  kicker?: string;
  /** an id for the run's heading (the homepage keeps its old #metadax anchor) */
  headingId?: string;
}
const { run, chapters, level = 1, kicker, headingId } = Astro.props;
const H = level === 2 ? "h2" : "h1";
const NAME: Record<string, string> = {
  metadax: "Meta DAX", "nova-dax": "Nova DAX", "skippy-dax": "Skippy DAX", "constraint-protocol": "The Constraint Protocol",
};
const COLOUR: Record<string, string> = {
  metadax: "--run-metadax", "nova-dax": "--run-novadax", "skippy-dax": "--run-skippydax", "constraint-protocol": "--run-cp",
};
const line = (graph.nodes as any[]).find((n) => n.chapter === run)?.line ?? "";
const anyFr = chapters.some((c) => Boolean(c.data?.question?.fr));
const items = chapters.map((c, i) => ({ n: i + 1, id: c.data.id as string, q: c.data.question.en as string }));
---
<div class="run-head" style={`--run: var(${COLOUR[run]})`} data-run-head>
  <div class="run-id">
    <H class="run-name" id={headingId}>{NAME[run]}</H>
    {kicker && <p class="run-kicker">{kicker}</p>}
    <p class="run-line">{line}</p>
    <p class="run-lang">{anyFr ? "English · Français" : "English · French coming"}</p>
  </div>
</div>
{/* a sibling of the chapters (not inside .run-head), so it stays pinned while the
    whole run scrolls under it */}
<nav class="run-strip" aria-label={`${NAME[run]}: the questions`} style={`--run: var(${COLOUR[run]})`} data-run-strip>
    <ol>
      {items.map((it) => (
        <li><a href={`#${it.id}`} data-run-step={it.id} title={it.q}>
          <span class="rs-n">{it.n}</span><span class="rs-q">{it.q}</span>
        </a></li>
      ))}
    </ol>
    {/* 2026-10-24 (Jason): switch experience from wherever you are in the run, e.g.
        at chapter 3 of 9 jump from "Give it to me straight" to "I'm a researcher" and
        stay on chapter 3. Same choice as the top menu (it presses the top menu's chip,
        which saves it, repaints every chapter and keeps this chapter in place). */}
    <details class="xp-mini" data-xp-mini>
      <summary aria-label="Change your experience">
        <span class="xm-dot" aria-hidden="true"></span>
        <span class="xm-k">Reading as</span>
        <b class="xm-name" data-xm-name>{lenses.find((l) => l.id === "kid")!.label}</b>
        <span class="xm-caret" aria-hidden="true">▾</span>
      </summary>
      <div class="xm-panel" role="group" aria-label="Your experience">
        <p class="xm-h">Switch here; you stay on this question.</p>
        <div class="xm-chips">
          {lenses.map((l) => (
            <button type="button" class="chip" data-xm-lens={l.id} data-label={l.label}
              style={`--chip-h: ${(l as any).hue}`} aria-pressed={l.id === "kid" ? "true" : "false"}>{l.label}</button>
          ))}
        </div>
      </div>
    </details>
</nav>

<script>
  // Where am I: the question whose chapter crosses the upper third of the screen.
  function boot(): void {
    const head = document.querySelector<HTMLElement>("[data-run-strip]");
    if (!head || (head as any).__spy) return;
    (head as any).__spy = true;
    const links = Array.from(head.querySelectorAll<HTMLAnchorElement>("[data-run-step]"));
    const set = (id: string) => {
      for (const a of links) {
        const on = a.dataset.runStep === id;
        a.classList.toggle("on", on);
        if (on) {
          a.setAttribute("aria-current", "step");
          const row = a.closest("ol");
          if (row) row.scrollLeft = a.offsetLeft - row.clientWidth / 2 + a.offsetWidth / 2;
        } else a.removeAttribute("aria-current");
      }
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) set((e.target as HTMLElement).id);
    }, { rootMargin: "-30% 0px -60% 0px" });
    for (const a of links) {
      const el = document.getElementById(a.dataset.runStep || "");
      if (el) io.observe(el);
    }
    if (links[0]) set(location.hash ? location.hash.slice(1) : links[0].dataset.runStep || "");
    wireMini();
  }

  // The experience switcher in the strip mirrors the top menu's.
  function paintMini(lens: string): void {
    for (const b of Array.from(document.querySelectorAll<HTMLElement>("[data-xm-lens]"))) {
      const on = b.dataset.xmLens === lens;
      b.setAttribute("aria-pressed", on ? "true" : "false");
      if (on) {
        const name = document.querySelector<HTMLElement>("[data-xm-name]");
        if (name) name.textContent = b.dataset.label || b.textContent || "";
      }
    }
  }
  function wireMini(): void {
    const mini = document.querySelector<HTMLDetailsElement>("[data-xp-mini]");
    if (!mini || (mini as any).__wired) return;
    (mini as any).__wired = true;
    let saved = "kid";
    try { saved = localStorage.getItem("dax-explain-lens") || "kid"; } catch { /* private mode */ }
    paintMini(saved);
    mini.addEventListener("click", (e) => {
      const b = (e.target as Element | null)?.closest<HTMLElement>("[data-xm-lens]");
      if (!b) return;
      const lens = b.dataset.xmLens || "kid";
      const top = document.querySelector<HTMLElement>(`#lens-chips .chip[data-lens="${lens}"]`);
      if (top) top.click();
      else document.dispatchEvent(new CustomEvent("dax-lens", { detail: lens }));
      mini.open = false;
    });
    document.addEventListener("dax-lens", (e) => {
      const lens = (e as CustomEvent).detail;
      if (typeof lens === "string") paintMini(lens);
    });
    document.addEventListener("click", (e) => {
      if (mini.open && !(e.target as Element | null)?.closest("[data-xp-mini]")) mini.open = false;
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") mini.open = false; });
  }
  document.addEventListener("astro:page-load", boot);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
</script>

<style>
  .run-head {
    width: 100%; max-width: var(--measure-scene, 72rem); margin: 0 auto;
    padding: var(--space-6, 1.5rem) var(--space-6, 1.5rem) 0;
    display: grid; gap: var(--space-4, 1rem);
  }
  .run-id { border-left: 4px solid var(--run); padding-left: var(--space-4, 1rem); }
  .run-name {
    margin: 0; font-family: var(--font-sans); font-weight: 400; letter-spacing: -0.015em;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.6rem); line-height: 1.1; color: var(--run);
  }
  .run-line { margin: 0.35rem 0 0; color: var(--ink); }
  .run-kicker { margin: 0.35rem 0 0; color: var(--ink-muted); }
  .run-lang { margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--ink-faint); letter-spacing: 0.06em; }

  .run-strip {
    position: sticky; top: 0; z-index: 20;
    width: 100%; max-width: var(--measure-scene, 72rem); margin: var(--space-4, 1rem) auto 0;
    padding: 0.5rem var(--space-6, 1.5rem);
    background: color-mix(in oklch, var(--ground, #0a0a0a) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .run-strip { display: flex; align-items: center; gap: 0.6rem; }
  .run-strip ol {
    flex: 1 1 auto; min-width: 0;
    list-style: none; margin: 0; padding: 0; display: flex; gap: 0.4rem;
    overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth;
  }
  .run-strip ol::-webkit-scrollbar { display: none; }
  .run-strip a {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 36px;
    padding: 0.2rem 0.75rem 0.2rem 0.35rem; border-radius: 999px; white-space: nowrap;
    border: 1px solid var(--line); color: var(--ink-muted); text-decoration: none; font-size: 0.8125rem;
  }
  .rs-n {
    display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    font-family: var(--font-sans); font-size: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--run) 50%, transparent); color: var(--run);
  }
  .rs-q { max-width: 16rem; overflow: hidden; text-overflow: ellipsis; }
  .run-strip a:hover, .run-strip a:focus-visible { color: var(--ink); border-color: color-mix(in oklch, var(--run) 50%, var(--line)); }
  .run-strip a.on { color: var(--ink); border-color: var(--run); }
  .run-strip a.on .rs-n { background: var(--run); color: var(--ground, #0a0a0a); border-color: var(--run); }
  /* the experience switcher, at the strip's right end */
  .xp-mini { position: relative; flex: none; }
  .xp-mini > summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
    min-height: 36px; padding: 0.2rem 0.75rem; border-radius: 999px; white-space: nowrap;
    border: 1px solid var(--lane); background: color-mix(in oklch, var(--lane) 12%, transparent);
    font-size: 0.8125rem; color: var(--ink);
  }
  .xp-mini > summary::-webkit-details-marker { display: none; }
  .xm-dot { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--lane); }
  .xm-k { color: var(--ink-muted); }
  .xm-name { color: var(--lane); font-weight: 600; }
  .xm-caret { color: var(--ink-muted); font-size: 0.75em; }
  .xp-mini[open] .xm-caret { transform: rotate(180deg); }
  .xm-panel {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 60;
    width: min(32rem, calc(100vw - 2rem)); padding: 0.9rem;
    border: 1px solid var(--line); border-radius: 14px;
    background: var(--surface, #141414); box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }
  .xm-h { margin: 0 0 0.65rem; font-size: 0.8125rem; color: var(--ink-muted); }
  .xm-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .xm-chips .chip {
    min-height: 38px; padding: 0.3rem 0.85rem; border: 1px solid var(--line); border-radius: 999px;
    background: transparent; color: var(--ink-muted); font: inherit; font-size: 0.8125rem; cursor: pointer;
  }
  /* scoped styles outrank colour.css, so the chosen chip's fill is restated here */
  .xm-chips .chip[aria-pressed="true"] {
    background: var(--chip); border-color: var(--chip); color: var(--lane-ink); font-weight: 600;
  }
  /* on a phone only the current question shows its words; the rest are numbers */
  @media (max-width: 700px) {
    .run-strip a:not(.on) .rs-q { display: none; }
    .run-strip a:not(.on) { padding-right: 0.35rem; }
    .xm-k { display: none; }
    .xm-name { max-width: 6rem; overflow: hidden; text-overflow: ellipsis; }
    .xp-mini > summary { padding-inline: 0.6rem; }
    .run-strip .rs-q { max-width: 9rem; }
  }
</style>
