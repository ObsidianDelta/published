---
// SiteHeader (2026-10-23): ONE top menu for every page on daxfoundation.org, the
// regular pages (Base.astro) and the guided runs (Explain.astro) alike. Jason:
// "as soon as they select their experience, that experience is always available
// to them on the top menu, so they could always switch back and forth".
//
// - The runs, each in its colour (tokens --run-*): Meta DAX, Nova DAX, Skippy DAX,
//   the Constraint Protocol. Each opens its guided run; the run's chapters link
//   on to the detail pages ("Go deeper", from src/data/site-map.json).
// - Definitions, Writing, About: the detail layer's own indexes.
// - "Your experience": the reader's preset (a lens, src/data/lenses.json). One
//   choice, kept in localStorage under dax-explain-lens, shown here on every
//   page and switchable from any page. Changing it dispatches "dax-lens" on
//   document; the chapters and the home map redraw themselves. The chips keep
//   id="lens-chips" (the explainer tests and scripts read them there).
import "../styles/tokens.css";
import "../styles/colour.css";
import lenses from "../data/lenses.json";
import runRoutes from "../data/run-routes.json";

const path = Astro.url.pathname;
const RUNS = [
  { key: "metadax", label: "Meta DAX", colour: "--run-metadax" },
  { key: "nova-dax", label: "Nova DAX", colour: "--run-novadax" },
  { key: "skippy-dax", label: "Skippy DAX", colour: "--run-skippydax" },
  { key: "constraint-protocol", label: "Constraint Protocol", colour: "--run-cp" },
].map((r) => ({ ...r, href: (runRoutes as Record<string, string>)[r.key] }));
// 2026-10-23 (Jason, late): only Meta DAX stands in the menu; Nova DAX, Skippy DAX
// and the Constraint Protocol sit in one drop-down; Writing is called Publications
// (the address stays /writing/); Definitions and About moved to every page's footer.
const LEAD = RUNS[0];
const DROP = RUNS.slice(1);
const MORE = [
  { label: "Publications", href: "/writing/" },
];
const here = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const curious = lenses.find((l) => l.id === "curious")!;
---
<header class="site-head">
  <div class="row">
    <a class="mark" href="/">DAX Foundation</a>
    <details class="xp" data-xp>
      <summary aria-label="Your experience: choose who you are reading as">
        <span class="xp-dot" aria-hidden="true"></span>
        <span class="xp-k">Your experience</span>
        <b class="xp-name" data-xp-name>{curious.label}</b>
        <span class="xp-caret" aria-hidden="true">▾</span>
      </summary>
      <div class="xp-panel">
        <p class="xp-h">Choose your experience. Every page is written for it, and you can switch any time.</p>
        <div class="chips" id="lens-chips" role="group" aria-label="Your experience">
          {lenses.map((l) => (
            <button
              type="button"
              class="chip"
              data-lens={l.id}
              data-level={l.level}
              data-hue={(l as any).hue}
              data-label={l.label}
              style={`--chip-h: ${(l as any).hue}`}
              aria-pressed={l.id === "curious" ? "true" : "false"}
            >{l.label}</button>
          ))}
        </div>
      </div>
    </details>
  </div>
  <nav class="nav" aria-label="Site">
    <a class:list={["run", { on: here(LEAD.href) }]} href={LEAD.href} style={`--c: var(${LEAD.colour})`}
      aria-current={here(LEAD.href) ? "page" : undefined}>{LEAD.label}</a>
    <details class:list={["drop", { on: DROP.some((r) => here(r.href)) }]} data-drop>
      <summary>
        <span class="drop-dots" aria-hidden="true">{DROP.map((r) => <i style={`--c: var(${r.colour})`}></i>)}</span>
        More <span class="drop-caret" aria-hidden="true">▾</span>
      </summary>
      <div class="drop-panel">
        {DROP.map((r) => (
          <a class:list={["run", { on: here(r.href) }]} href={r.href} style={`--c: var(${r.colour})`}
            aria-current={here(r.href) ? "page" : undefined}>{r.label}</a>
        ))}
      </div>
    </details>
    <span class="sep" aria-hidden="true"></span>
    {MORE.map((m) => (
      <a class:list={["more", { on: here(m.href) }]} href={m.href}
        aria-current={here(m.href) ? "page" : undefined}>{m.label}</a>
    ))}
  </nav>
</header>

<script>
  const KEY = "dax-explain-lens";
  function chips(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>("#lens-chips .chip"));
  }
  function read(): string {
    const ids = chips().map((c) => c.dataset.lens || "");
    try { const v = localStorage.getItem(KEY); return v && ids.includes(v) ? v : "curious"; }
    catch { return "curious"; }
  }
  function paint(lens: string): void {
    for (const c of chips()) {
      const on = c.dataset.lens === lens;
      c.setAttribute("aria-pressed", on ? "true" : "false");
      if (on) {
        if (c.dataset.hue) document.documentElement.style.setProperty("--lane-h", c.dataset.hue);
        const name = document.querySelector<HTMLElement>("[data-xp-name]");
        if (name) name.textContent = c.dataset.label || c.textContent || "";
      }
    }
  }
  function choose(lens: string): void {
    try { localStorage.setItem(KEY, lens); } catch { /* private mode */ }
    paint(lens);
    document.dispatchEvent(new CustomEvent("dax-lens", { detail: lens }));
  }
  function boot(): void {
    const row = document.getElementById("lens-chips");
    if (row && !(row as any).__wired) {
      (row as any).__wired = true;
      row.addEventListener("click", (e) => {
        const chip = (e.target as Element | null)?.closest<HTMLElement>(".chip");
        if (!chip?.dataset.lens) return;
        choose(chip.dataset.lens);
        const d = document.querySelector<HTMLDetailsElement>("[data-xp]");
        if (d) d.open = false;
      });
    }
    paint(read());
  }
  // another control (the home map's chips) changed the experience: follow it
  document.addEventListener("dax-lens", (e) => {
    const lens = (e as CustomEvent).detail;
    if (typeof lens === "string") paint(lens);
  });
  // close the panel on Escape or a click elsewhere
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") document.querySelectorAll<HTMLDetailsElement>("[data-xp], [data-drop]").forEach((d) => { d.open = false; });
  });
  document.addEventListener("click", (e) => {
    const t = e.target as Element | null;
    for (const d of Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-xp], [data-drop]"))) {
      if (d.open && !t?.closest("details") ) d.open = false;
      else if (d.open && t?.closest("details") !== d) d.open = false;
    }
  });
  document.addEventListener("astro:page-load", boot);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
</script>

<style>
  .site-head {
    width: 100%; max-width: 72rem; margin: 0 auto;
    padding: 1.25rem clamp(1rem, 4vw, 1.5rem) 0.75rem;
    display: grid; gap: 0.75rem;
    font-family: inherit;
  }
  /* grid items default to min-width:auto and would grow to the nav's full width on a
     phone, widening the page; 0 lets the nav row scroll inside its own box */
  .site-head > * { min-width: 0; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .mark {
    text-decoration: none; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-muted, #8c8c8c); white-space: nowrap;
  }
  .mark:hover, .mark:focus-visible { color: var(--ink, #e8e8e8); }

  .nav {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.1rem;
    font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .nav a { text-decoration: none; white-space: nowrap; padding-block: 0.35rem; border-bottom: 2px solid transparent; }
  .run { color: var(--c); }
  .run::before {
    content: ""; display: inline-block; width: 0.5em; height: 0.5em; border-radius: 50%;
    background: var(--c); margin-right: 0.45em; vertical-align: 0.08em;
  }
  .run:hover, .run:focus-visible, .run.on { border-bottom-color: var(--c); }
  .more { color: var(--ink-muted, #8c8c8c); }
  .more:hover, .more:focus-visible, .more.on { color: var(--ink, #e8e8e8); border-bottom-color: var(--line, #1e1e1e); }
  .sep { width: 1px; height: 1em; background: var(--line, #1e1e1e); }

  /* the experience switcher: a pill in the lane's colour */
  .xp { position: relative; }
  .xp > summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 40px; padding: 0.3rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--lane); color: var(--ink, #e8e8e8); font-size: 0.8125rem;
    background: color-mix(in oklch, var(--lane) 12%, transparent);
  }
  .xp > summary::-webkit-details-marker { display: none; }
  .xp-dot { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--lane); }
  .xp-k { color: var(--ink-muted, #8c8c8c); }
  .xp-name { font-weight: 600; color: var(--lane); }
  .xp-caret { color: var(--ink-muted, #8c8c8c); font-size: 0.75em; }
  .xp[open] .xp-caret { transform: rotate(180deg); }
  .xp-panel {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 50;
    width: min(34rem, calc(100vw - 2rem));
    padding: 1rem; border: 1px solid var(--line, #1e1e1e); border-radius: 14px;
    background: var(--surface, #141414); box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }
  .xp-h { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--ink-muted, #8c8c8c); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 40px; padding: 0.35rem 0.9rem; border: 1px solid var(--line, #1e1e1e);
    border-radius: 999px; background: transparent; color: var(--ink-muted, #9a9a9a);
    font: inherit; font-size: 0.875rem; cursor: pointer;
  }
  .chip:focus-visible { outline: 2px solid var(--lane); outline-offset: 3px; }

  @media (max-width: 700px) {
    .xp-k { display: none; }
    .nav { gap: 0.35rem 0.9rem; }
  }

  /* the drop-down: Nova DAX, Skippy DAX, the Constraint Protocol */
  .drop { position: relative; }
  .drop > summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
    padding-block: 0.35rem; color: var(--ink-muted, #8c8c8c); border-bottom: 2px solid transparent;
  }
  .drop > summary::-webkit-details-marker { display: none; }
  .drop > summary:hover, .drop[open] > summary, .drop.on > summary { color: var(--ink, #e8e8e8); }
  .drop-dots { display: inline-flex; gap: 2px; }
  .drop-dots i { width: 0.45em; height: 0.45em; border-radius: 50%; background: var(--c); }
  .drop-caret { font-size: 0.75em; }
  .drop[open] .drop-caret { transform: rotate(180deg); }
  .drop-panel {
    position: absolute; left: 0; top: calc(100% + 0.4rem); z-index: 50; min-width: 15rem;
    display: grid; gap: 0.15rem; padding: 0.5rem;
    border: 1px solid var(--line, #1e1e1e); border-radius: 12px;
    background: var(--surface, #141414); box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
  }
  .drop-panel a { padding: 0.55rem 0.6rem; border-radius: 8px; border-bottom: 0; }
  .drop-panel a:hover, .drop-panel a:focus-visible, .drop-panel a.on { background: color-mix(in oklch, var(--c) 14%, transparent); }
</style>
