---
// NotFinal (2026-10-24, Jason): wherever Meta DAX packages are made or shown, say
// plainly that they are in no way indicative of a final product -- they show the
// commitment to be useful to humanity from the very start of the initiative, by
// making things people can use now. One component so the words stay the same on
// every page (the standalone package pages in public/ carry a short strip that
// links here, written by the same hand).
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<aside class:list={["not-final", { compact }]} id="not-final" aria-label="Not a final product">
  <p><strong>Not a final product.</strong> What you see here is in no way indicative of a final product. These packages are early experiments. They show our commitment to be useful to humanity from the very start of this initiative, by making things people can use today.</p>
</aside>

<style>
  .not-final {
    margin: 0 0 var(--space-6, 1.5rem);
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in oklch, var(--run-metadax, #3fc37f) 35%, var(--line, #1e1e1e));
    border-left: 3px solid var(--run-metadax, #3fc37f);
    border-radius: 10px;
    background: color-mix(in oklch, var(--run-metadax, #3fc37f) 6%, transparent);
    max-width: 46rem;
  }
  .not-final p { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--ink-muted, #9a9a9a); }
  .not-final strong { color: var(--ink, #e8e8e8); font-weight: 600; }
  .not-final.compact { margin-top: var(--space-4, 1rem); }
</style>
