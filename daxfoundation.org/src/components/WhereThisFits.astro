---
// WhereThisFits (2026-10-23): on every regular page, one quiet line saying which
// run and which question it belongs to, in that run's colour, linking into the
// guided run at that question. The other half of the two-way link: the run's
// chapter lists this page under "Go deeper". Both read src/data/site-map.json.
import siteMap from "../data/site-map.json";
import runRoutes from "../data/run-routes.json";
import { getCollectionChapters } from "../lib/explain/chapters.js";

const path = Astro.url.pathname;
type Entry = { path: string; chapter: string; list: boolean; label?: string };
const pages = (siteMap as { pages: Entry[] }).pages;
// exact match first, then the longest "prefix*" that covers this page
const exact = pages.find((e) => !e.path.endsWith("*") && e.path === path);
const prefix = pages
  .filter((e) => e.path.endsWith("*") && path.startsWith(e.path.slice(0, -1)) && path !== e.path.slice(0, -1))
  .sort((a, b) => b.path.length - a.path.length)[0];
const entry = exact || prefix;

const RUN: Record<string, { label: string; colour: string }> = {
  foundation: { label: "The DAX Foundation", colour: "--run-foundation" },
  metadax: { label: "Meta DAX", colour: "--run-metadax" },
  "nova-dax": { label: "Nova DAX", colour: "--run-novadax" },
  "skippy-dax": { label: "Skippy DAX", colour: "--run-skippydax" },
  "constraint-protocol": { label: "Constraint Protocol", colour: "--run-cp" },
};

let fit: { run: string; colour: string; question: string; href: string } | null = null;
if (entry && path !== "/") {
  const [run, id] = entry.chapter.split("/");
  const chapters = await getCollectionChapters(run);
  const ch = chapters.find((c: any) => c.data.id === id);
  const base = run === "foundation" ? "/explain/" : (runRoutes as Record<string, string>)[run];
  if (ch && base && RUN[run]) {
    fit = {
      run: RUN[run].label,
      colour: RUN[run].colour,
      question: (ch as any).data.question.en,
      href: run === "foundation" ? base : `${base}#${id}`,
    };
  }
}
---
{fit && (
  <p class="fit" style={`--c: var(${fit.colour})`}>
    <span class="fit-dot" aria-hidden="true"></span>
    <span class="fit-k">Part of {fit.run}</span>
    <a href={fit.href}>{fit.question}</a>
  </p>
)}

<style>
  .fit {
    width: 100%; max-width: 72rem; margin: 0 auto;
    padding: 0.5rem clamp(1rem, 4vw, 1.5rem) 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.6rem;
    font-size: 0.8125rem; color: var(--ink-muted, #8c8c8c);
  }
  .fit-dot { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--c); align-self: center; }
  .fit-k { color: var(--c); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.75rem; }
  .fit a { color: var(--ink, #e8e8e8); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--c) 55%, transparent); }
  .fit a:hover, .fit a:focus-visible { border-bottom-color: var(--c); }
</style>
