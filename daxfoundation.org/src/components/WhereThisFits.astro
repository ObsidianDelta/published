---
// WhereThisFits (2026-10-23, revised the same night): on every regular page, a
// breadcrumb that reads like the site's own structure --
//   Meta DAX › What exists today? › Samples › Grammar from your own book
// The run is in its colour and opens the guided run; the question opens the run at
// that question; the section (the page's parent index, when there is one) and the
// page itself follow. Jason found the first version ("Part of Meta DAX · What exists
// today?") mechanical. The other half of the two-way link: the run's chapter lists
// this page under "Go deeper". Both read src/data/site-map.json.
import siteMap from "../data/site-map.json";
import runRoutes from "../data/run-routes.json";
import { getCollectionChapters } from "../lib/explain/chapters.js";

interface Props { title?: string }
const { title = "" } = Astro.props;
const path = Astro.url.pathname;
type Entry = { path: string; chapter: string; list: boolean; label?: string };
const pages = (siteMap as { pages: Entry[] }).pages;
const exact = pages.find((e) => !e.path.endsWith("*") && e.path === path);
const prefix = pages
  .filter((e) => e.path.endsWith("*") && path.startsWith(e.path.slice(0, -1)) && path !== e.path.slice(0, -1))
  .sort((a, b) => b.path.length - a.path.length)[0];
const entry = exact || prefix;

const RUN: Record<string, { label: string; colour: string }> = {
  foundation: { label: "The map", colour: "--run-foundation" },
  metadax: { label: "Meta DAX", colour: "--run-metadax" },
  "nova-dax": { label: "Nova DAX", colour: "--run-novadax" },
  "skippy-dax": { label: "Skippy DAX", colour: "--run-skippydax" },
  "constraint-protocol": { label: "Constraint Protocol", colour: "--run-cp" },
};
// short names for the section indexes a page can sit under
const SECTION: Record<string, string> = {
  // the names the Meta DAX pages already used in their own path lines
  "/writing/": "Publications",
  "/metadax/": "Meta DAX hub",
  "/metadax/samples/": "Samples",
  "/metadax/showcase/": "Showcase",
  "/metadax/showcases/": "The library",
  "/metadax/guide/": "Help",
  "/metadax/homeschool/": "Homeschooling",
  "/metadax/teacher/": "Teacher",
  "/metadax/tutor/": "Tutor",
  "/metadax/trainer/": "Trainer",
  "/metadax/research/": "Research",
};
const clean = (t: string) => t.replace(/\s*[·|]\s*(DAX Foundation|Meta DAX sample|Meta DAX)\s*$/i, "").replace(/\s*—\s*Meta ?DAX\s*$/i, "").trim();

type Crumb = { label: string; href?: string; run?: boolean };
let crumbs: Crumb[] = [];
let colour = "--run-foundation";
if (entry && path !== "/") {
  const [run, id] = entry.chapter.split("/");
  colour = RUN[run]?.colour ?? colour;
  if (run === "foundation") {
    crumbs.push({ label: RUN.foundation.label, href: "/explain/", run: true });
  } else {
    const chapters = await getCollectionChapters(run);
    const ch = chapters.find((c: any) => c.data.id === id) as any;
    const base = (runRoutes as Record<string, string>)[run];
    crumbs.push({ label: RUN[run].label, href: base, run: true });
    if (ch) crumbs.push({ label: ch.data.question.en, href: `${base}#${id}` });
  }
  // every section index above this page (e.g. the Meta DAX hub, then Help), so the
  // links the pages' own path lines carried are kept here
  const parts = path.split("/").filter(Boolean);
  for (let i = 1; i < parts.length; i++) {
    const up = "/" + parts.slice(0, i).join("/") + "/";
    if (SECTION[up]) crumbs.push({ label: SECTION[up], href: up });
  }
  crumbs.push({ label: SECTION[path] ?? clean(title) });
}
---
{crumbs.length > 0 && (
  <nav class="crumbs" aria-label="Where this page sits" style={`--c: var(${colour})`}>
    <ol>
      {crumbs.map((c, i) => (
        <li class:list={{ run: c.run }}>
          {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}

<style is:global>
  /* the Meta DAX pages' own path lines ("Meta DAX › Help › …") said the same thing
     as this breadcrumb, which now carries their names and their hub link */
  body:has(nav.crumbs) main .eyebrow:has(> a[href="/metadax/"]) { display: none; }
</style>
<style>
  .crumbs {
    width: 100%; max-width: 72rem; margin: 0 auto;
    padding: 0.25rem clamp(1rem, 4vw, 1.5rem) 0;
    font-size: 0.8125rem; color: var(--ink-faint, #6f6f6f);
  }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0; }
  .crumbs li { display: inline-flex; align-items: baseline; min-width: 0; }
  .crumbs li + li::before { content: "›"; margin: 0 0.5em; color: var(--ink-faint, #6f6f6f); }
  .crumbs a { color: var(--ink-muted, #8c8c8c); text-decoration: none; }
  .crumbs a:hover, .crumbs a:focus-visible { color: var(--ink, #e8e8e8); }
  .crumbs li.run a { color: var(--c); }
  .crumbs li.run::before { content: none; }
  .crumbs li.run { padding-left: 0.9em; position: relative; }
  .crumbs li.run::after {
    content: ""; position: absolute; left: 0; top: 50%; translate: 0 -50%;
    width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--c);
  }
  .crumbs [aria-current] { color: var(--ink-muted, #8c8c8c); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 28ch; }
</style>
