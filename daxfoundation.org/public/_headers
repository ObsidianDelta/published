# 2026-11-04 (SEO launch): the pages.dev mirror and preview builds stay out of search;
# daxfoundation.org is the one indexed host (every page also carries a canonical link to it).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# 2026-11-05 (Security Policy v1.0): browsers use HTTPS only for daxfoundation.org.
# Apex only (no includeSubDomains, no preload) so no other host is affected.
/*
  Strict-Transport-Security: max-age=31536000
