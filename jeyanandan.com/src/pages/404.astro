---
import Base from '../layouts/Base.astro';

// Added 2026-09-19. Until now this site had no 404 route at all, so Cloudflare
// Pages fell back to serving the home page with a 200 for every unknown URL --
// a cloaking signature to reputation scanners, and an invitation for search
// engines to index unbounded duplicate pages once the blog grows. Astro emits
// this route as dist/404.html, which Pages serves with a real 404 status.
---
<Base title="Not found" description="There is no page at that address.">
  <section class="hero"><div class="shell">
    <h1>Not found</h1>
    <div class="rule"></div>
  </div></section>

  <section><div class="shell narrow">
    <p class="lede">There is no page at that address. Either it never existed, or I moved it and left nothing behind to point the way.</p>
    <p>Three places that do exist:</p>
    <ul class="ways">
      <li><a href="/">The home page</a> &mdash; Maddie, and what she is for.</li>
      <li><a href="/blog/">Writing</a> &mdash; everything I have posted.</li>
      <li><a href="/important/">Before you start</a> &mdash; what Maddie is and is not. The most important page here.</li>
    </ul>
  </div></section>
</Base>

<style is:global>
.hero{padding:clamp(2.5rem,7vw,4.5rem) 0 clamp(.5rem,2vw,1rem)}
section{padding-bottom:clamp(2.5rem,6vw,4rem)}
.narrow p,.narrow li{color:var(--ink)}
.lede{font-size:clamp(19px,2.2vw,21px)}
.ways{list-style:none;margin:.4rem 0 0;padding:0;display:flex;flex-direction:column;gap:1.1rem}
.ways li{border-top:1px solid var(--line);padding-top:.95rem;color:var(--muted)}
.ways a{font-family:var(--sans);font-weight:600;font-size:1.15rem;color:var(--strong);text-decoration:none}
.ways a:hover{color:var(--orange)}
</style>
