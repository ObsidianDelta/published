---
import Base from '../../layouts/Base.astro';
import { telemetryPosts, formatDate } from '../_posts.js';

// Telemetry — Jason's media pipeline. Photos and short clips he captures on his
// phone, approved one tap at a time, published here newest first. This lists the
// posts carrying `telemetry: true`; they also appear in /blog/ with a small
// "Telemetry" label. The thumbnail is the post's own media, pulled from the
// frontmatter `thumb` (set at publish) or the first image in the body.
const posts = telemetryPosts;
---
<Base title="Telemetry — Jason Jeyanandan" description="Field captures by Jason Jeyanandan, newest first.">
  <section class="hero"><div class="shell">
    <h1>Telemetry</h1>
    <div class="rule"></div>
  </div></section>
  <section><div class="shell narrow">
    <ul class="tposts">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`}>
            {p.thumb && <img class="thumb" src={p.thumb} alt={p.title} loading="lazy" />}
            <span class="meta">
              <span class="t">{p.title}</span>
              <time datetime={new Date(p.date).toISOString()}>{formatDate(p.date)}</time>
              {p.description && <span class="d">{p.description}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    {posts.length === 0 && <p>Nothing published yet.</p>}
  </div></section>
</Base>

<style is:global>
.hero{padding:clamp(2.5rem,7vw,4.5rem) 0 clamp(.5rem,2vw,1rem)}
section{padding-bottom:clamp(2.5rem,6vw,4rem)}
.tposts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1.6rem}
.tposts li{border-top:1px solid var(--line);padding-top:1.1rem}
.tposts a{display:flex;gap:1rem;align-items:flex-start;text-decoration:none;color:inherit}
.tposts a:hover .t{color:var(--orange)}
.thumb{width:96px;height:96px;object-fit:cover;border-radius:6px;flex:0 0 auto;background:var(--line)}
.tposts .meta{display:flex;flex-direction:column}
.tposts .t{font-family:var(--sans);font-weight:600;font-size:1.35rem;color:var(--strong)}
.tposts time{font-family:var(--mono);font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-top:.35rem}
.tposts .d{color:var(--muted);margin-top:.45rem}
</style>
