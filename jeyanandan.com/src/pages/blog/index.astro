---
import Base from '../../layouts/Base.astro';

// import.meta.glob rather than a content collection: one folder of markdown,
// no schema to drift, nothing to configure.
const modules = import.meta.glob('../../posts/*.md', { eager: true });
const posts = Object.entries(modules)
  .map(([file, mod]) => ({
    slug: file.split('/').pop().replace(/\.md$/, ''),
    ...mod.frontmatter,
  }))
  .filter((p) => !p.draft)
  .sort((a, b) => new Date(b.date) - new Date(a.date));

const fmt = (d) =>
  new Date(d).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Blog — Jason Jeyanandan" description="Writing by Jason Jeyanandan.">
  <section class="hero"><div class="shell">
    <h1>Blog</h1>
    <div class="rule"></div>
  </div></section>
  <section><div class="shell narrow">
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`}>{p.title}</a>
          <time datetime={new Date(p.date).toISOString()}>{fmt(p.date)}</time>
          {p.description && <p>{p.description}</p>}
        </li>
      ))}
    </ul>
    {posts.length === 0 && <p>Nothing published yet.</p>}
  </div></section>
</Base>

<style is:global>
.hero{padding:clamp(2.5rem,7vw,4.5rem) 0 clamp(.5rem,2vw,1rem)}
section{padding-bottom:clamp(2.5rem,6vw,4rem)}
.posts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1.6rem}
.posts li{border-top:1px solid var(--line);padding-top:1.1rem}
.posts a{font-family:var(--sans);font-weight:600;font-size:1.35rem;color:var(--strong);text-decoration:none;display:block}
.posts a:hover{color:var(--orange)}
.posts time{display:block;font-family:var(--mono);font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-top:.35rem}
.posts p{margin:.55rem 0 0;color:var(--muted)}
</style>
