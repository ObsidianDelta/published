---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../posts/*.md', { eager: true });
  return Object.entries(modules)
    .filter(([, mod]) => !mod.frontmatter.draft)
    .map(([file, mod]) => ({
      params: { slug: file.split('/').pop().replace(/\.md$/, '') },
      props: { frontmatter: mod.frontmatter, Content: mod.Content },
    }));
}

const { frontmatter, Content } = Astro.props;
const fmt = new Date(frontmatter.date).toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---
<Base title={`${frontmatter.title} — Jason Jeyanandan`} description={frontmatter.description || frontmatter.title}>
  <section class="hero"><div class="shell narrow">
    <p class="eyebrow">{fmt}</p>
    <h1>{frontmatter.title}</h1>
    <div class="rule"></div>
  </div></section>
  <article><div class="shell narrow prose">
    <Content />
  </div></article>
  <div class="shell narrow"><p class="back"><a href="/blog/">&larr; All writing</a></p></div>
</Base>

<style is:global>
.hero{padding:clamp(2.5rem,7vw,4.5rem) 0 clamp(.5rem,2vw,1rem)}
article{padding-bottom:clamp(2rem,5vw,3rem)}
.prose h2{font-family:var(--sans);font-weight:600;font-size:1.35rem;margin:2.2rem 0 .6rem;color:var(--strong)}
.prose h3{font-family:var(--sans);font-weight:600;font-size:1.1rem;margin:1.8rem 0 .5rem;color:var(--strong)}
.prose blockquote{margin:1.5rem 0;padding-left:1.1rem;border-left:3px solid var(--orange);color:var(--muted)}
.prose code{font-family:var(--mono);font-size:.88em;background:var(--card);border:1px solid var(--line);border-radius:4px;padding:.08em .34em}
.prose img{max-width:100%;height:auto;border-radius:8px}
.back{font-family:var(--sans);font-size:17px}
.back a{color:var(--muted);text-decoration:none}
.back a:hover{color:var(--orange)}
</style>
