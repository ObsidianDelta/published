---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../posts/*.md', { eager: true });
  return Object.entries(modules)
    .filter(([, mod]) => !mod.frontmatter.draft)
    .map(([file, mod]) => ({
      params: { slug: file.split('/').pop().replace(/\.md$/, '') },
      props: { frontmatter: mod.frontmatter, Content: mod.Content },
    }));
}

const { frontmatter, Content } = Astro.props;
const fmt = new Date(frontmatter.date).toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// A post may split its title in two: `title` sits large, `subtitle` sits under
// it as a deck. The tab, the bookmark and every share card still want the whole
// thing in one line, so they get the two rejoined. Posts without a subtitle are
// unaffected.
const fullTitle = frontmatter.subtitle
  ? `${frontmatter.title}: ${frontmatter.subtitle}`
  : frontmatter.title;
---
<Base title={`${fullTitle} — Jason Jeyanandan`} description={frontmatter.description || fullTitle}>
  <section class="hero"><div class="shell narrow">
    <p class="eyebrow">{fmt}</p>
    <h1>{frontmatter.title}</h1>
    {frontmatter.subtitle && <p class="deck">{frontmatter.subtitle}</p>}
    <div class="rule"></div>
  </div></section>
  <article><div class="shell narrow prose">
    <Content />
  </div></article>
  <div class="shell narrow"><p class="back"><a href="/blog/">&larr; All writing</a></p></div>
</Base>

<style is:global>
/* ---------------------------------------------------------------------------
   Long-form typography for a single post. Everything here is set in the site's
   own palette -- paper, bone, card, line, ink, strong, muted -- and the orange
   stays where Base.astro put it: one accent, never decoration.
--------------------------------------------------------------------------- */

/* ---------- masthead of the piece ---------- */
.hero{padding:clamp(2.5rem,7vw,4.5rem) 0 clamp(.5rem,2vw,1rem)}
.hero h1{margin-bottom:.4rem}
.deck{
  font-family:var(--sans);font-weight:400;
  font-size:clamp(1.15rem,3.6vw,1.7rem);line-height:1.22;letter-spacing:-.012em;
  color:var(--muted);margin:0 0 1.2rem;text-wrap:balance;
}

article{padding-bottom:clamp(2rem,5vw,3rem)}
.prose{max-width:44rem}
.prose p{text-wrap:pretty}
.prose strong{color:var(--strong);font-weight:600}

/* The opening paragraph carries a little more weight than the rest, and then
   the piece settles into its normal measure. */
.prose > p:first-of-type{font-size:1.13em;line-height:1.55;color:var(--strong)}

/* ---------- section rhythm ----------
   The post separates every section with a markdown rule, so the rule does the
   spacing work and the heading that follows it sits tight underneath. */
.prose h2{
  font-family:var(--sans);font-weight:600;
  font-size:clamp(1.3rem,3.6vw,1.55rem);line-height:1.2;letter-spacing:-.015em;
  margin:2.6rem 0 .8rem;color:var(--strong);text-wrap:balance;scroll-margin-top:1.5rem;
}
.prose h3{
  font-family:var(--sans);font-weight:600;font-size:1.12rem;line-height:1.3;
  margin:2rem 0 .55rem;color:var(--strong);
}
.prose hr{
  border:0;height:0;border-top:1px solid var(--line);
  margin:clamp(2.4rem,6vw,3.4rem) 0 clamp(1.9rem,4.5vw,2.6rem);
}
.prose hr + h2{margin-top:0}

/* ---------- lists ---------- */
.prose ul,.prose ol{margin:0 0 1.3em;padding-left:1.35rem}
.prose li{margin:0 0 .42em}
.prose li::marker{color:var(--muted)}

/* ---------- the claims ----------
   The post states its load-bearing claims in blockquotes, so they are set in
   full ink rather than muted grey: they are the argument, not an aside. */
.prose blockquote{
  margin:1.8rem 0;padding:.1rem 0 .1rem 1.2rem;
  border-left:3px solid var(--orange);color:var(--ink);
}
.prose blockquote p{margin:0 0 .85em}
.prose blockquote p:last-child{margin-bottom:0}

/* ---------- inline code ---------- */
.prose code{
  font-family:var(--mono);font-size:.88em;
  background:var(--card);border:1px solid var(--line);border-radius:4px;
  padding:.08em .34em;overflow-wrap:break-word;
}

/* ---------- fenced blocks ----------
   These are ASCII flow diagrams, up to 79 columns wide. Two rules matter:

   1. Ink on the page's own bone tint. Astro's default Shiki theme used to paint
      each <pre> with an inline `background-color:#24292e;color:#e1e4e8` while
      the `.prose code` rule above repainted the inner <code> cream -- pale text
      on a pale bar, which is to say invisible. Highlighting is off in
      astro.config.mjs now, so there is no inline style left to fight; the
      !important below is a guard so this block stays legible even if a future
      highlighter starts emitting one again.
   2. The block scrolls on its own axis. A 79-column diagram is wider than the
      measure on every screen, so it must scroll inside its own box and never
      drag the page sideways. */
.prose pre{
  font-family:var(--mono);
  font-size:clamp(11px,2.8vw,13.5px);
  line-height:1.5;
  color:var(--ink)!important;
  background:var(--bone)!important;
  border:1px solid var(--line);border-radius:6px;
  margin:1.7rem 0;padding:1rem 1.05rem;
  max-width:100%;
  overflow-x:auto;overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
  tab-size:2;
}
.prose pre code{
  display:block;
  font-family:inherit;font-size:inherit;line-height:inherit;color:inherit;
  background:none;border:0;border-radius:0;padding:0;
  white-space:pre;overflow-wrap:normal;word-break:normal;
}

/* ---------- tables ----------
   Same rule as the code blocks: scroll inside the box, never push the page. */
.prose table{
  display:block;width:100%;max-width:100%;overflow-x:auto;
  border-collapse:collapse;margin:1.7rem 0;
  font-family:var(--sans);font-size:.93rem;line-height:1.4;
}
.prose th,.prose td{
  text-align:left;vertical-align:top;padding:.6rem .85rem;
  border-bottom:1px solid var(--line);
}
.prose th:first-child,.prose td:first-child{padding-left:0}
.prose thead th{
  font-family:var(--mono);font-size:11px;font-weight:600;
  letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
  border-bottom:1px solid var(--ink);white-space:nowrap;
}

/* ---------- figures ----------
   astro.config.mjs promotes a lone image in a paragraph to <figure> and moves
   its alt text into a <figcaption>, so the description of each diagram is on
   the page instead of only in the markup. */
.prose figure{
  margin:clamp(1.9rem,5vw,2.8rem) 0;padding:0;
  display:flex;flex-direction:column;align-items:center;gap:.8rem;
}
.prose figcaption{
  font-family:var(--sans);font-size:.87rem;line-height:1.45;
  color:var(--muted);text-align:center;text-wrap:pretty;max-width:34rem;
}
.prose img{display:block;max-width:100%;height:auto;border-radius:8px}

.back{font-family:var(--sans);font-size:17px;margin-top:.5rem}
.back a{color:var(--muted);text-decoration:none}
.back a:hover{color:var(--orange)}
</style>
