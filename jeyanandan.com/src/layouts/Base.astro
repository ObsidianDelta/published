---
const { title, description = "Jason Jeyanandan.", noindex = false } = Astro.props;

// 2026-10-08: the page carried a title and description but no canonical, no
// Open Graph and no Twitter card, so a shared link -- the home page included --
// unfurled as a bare URL with no image. Added here, on every page: a
// self-referential canonical, the OG/Twitter set, and an absolute /og.png
// (1200x630, the wordmark on paper with the coda line, in the site's own
// palette). Astro.site is https://jeyanandan.com. No new copy: og:image:alt is
// the name, the share text is each page's own title and description.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// 2026-09-08: the Blog link is off the masthead and the footer at Jason's
// request. The /blog/ routes still build and still resolve, they are simply
// unlinked from the chrome; the home page links into them twice.
//
// 2026-09-20: the footer carried two links, "Before you start" to /important/
// and "Privacy" to /privacy/. Both pages were taken off the site with the rest
// of the product surface, so the footer is the name alone rather than two links
// to nothing. The pages are kept, unbuilt, in src/_suppressed/ -- read the
// README there before restoring either.
//
// 2026-09-28: the footer carries one outbound link, to Jason's LinkedIn, at his
// request -- LinkedIn is the reference for him, and this layout wraps every
// page, so every post links to it too.
//
// 2026-10-01: two more, on every page: "How I publish" (/blog/how-i-publish/,
// the explainer every surface points at) and the public record,
// github.com/ObsidianDelta/published, where every post's history is readable.
//
// These notes live in the frontmatter, not in an HTML comment in the body,
// because this layout wraps every page on the site: an <!-- --> here is emitted
// into the built HTML of all of them, and internal notes about pages that no
// longer exist are not something to ship to readers.
//
// 2026-09-20: `noindex` is passed only by src/pages/blog/[slug].astro, for a
// post src/pages/_posts.js marks unlisted. Every other page leaves it off and
// emits no robots meta at all, which is the default: index, follow.
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#FAF4E8" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Jason Jeyanandan" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Jason Jeyanandan" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<style is:global>
/* ---------------------------------------------------------------------------
   Palette is the Obsidian Delta light system: paper #FAF4E8, card #EFE5CE,
   deep-green ink #2D3A2E, burnt orange #C97224. Orange is the one accent; it
   is never decoration.
   System faces only — no webfonts, no CDN, no analytics, nothing third-party.
--------------------------------------------------------------------------- */
:root{
  --paper:#FAF4E8; --bone:#F5EBD7; --card:#EFE5CE; --line:#D4CCB7;
  --muted:#6E6859; --ink:#2D3A2E; --strong:#141410;
  --soft:#2D3A2E;   /* same deep green as --ink; no page built today uses it */
  --orange:#C97224; --red:#A8311F;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--serif);font-size:19px;line-height:1.66;
  -webkit-font-smoothing:antialiased;
}
p{margin:0 0 1.3em}
a{color:inherit}
::selection{background:var(--orange);color:var(--paper)}
.shell{max-width:1120px;margin:0 auto;padding:0 clamp(1.15rem,4vw,2.5rem)}
.narrow{max-width:44rem}

/* ---------- uniform ecosystem top bar (adapted to this palette) ---------- */
.ecobar{border-bottom:1px solid var(--line)}
.ecobar .shell{display:flex;flex-wrap:wrap;gap:.25rem 1.1rem;padding-top:.55rem;padding-bottom:.55rem}
.ecobar a{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:lowercase;color:var(--muted);text-decoration:none;white-space:nowrap}
.ecobar a:hover,.ecobar a:focus-visible{color:var(--orange)}
.ecobar a[aria-current="page"]{color:var(--strong);text-decoration:underline;text-underline-offset:3px}

/* ---------- masthead ---------- */
.strip{border-bottom:1px solid var(--line)}
.who-nav{display:flex;flex-wrap:wrap;gap:.5rem 1.2rem}
.who-nav a{font-family:var(--mono);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-decoration:none}
.who-nav a:hover,.who-nav a[aria-current]{color:var(--orange)}
.strip .shell{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;padding-top:1.1rem;padding-bottom:1.1rem}
.strip a,.strip span{font-family:var(--mono);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-decoration:none}
.strip .who{color:var(--strong)}
.strip a:hover,.strip a[aria-current]{color:var(--orange)}

h1{
  font-family:var(--sans);font-weight:600;
  font-size:clamp(2.1rem,6.2vw,3.5rem);line-height:1.08;letter-spacing:-.025em;
  margin:0 0 1rem;color:var(--strong);text-wrap:balance;
}
.rule{width:56px;height:2px;background:var(--orange);margin:0 0 1.4rem}
.eyebrow{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--orange);margin:0 0 .9rem}

footer{border-top:1px solid var(--line);margin-top:clamp(2.5rem,6vw,4rem)}
footer .shell{padding:1.6rem 0 2.6rem;font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
footer .links{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem}
footer .ecosystem{flex-basis:100%;margin:0}
footer a{text-decoration:none}
footer a:hover{color:var(--orange)}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
  <nav class="ecobar" aria-label="DAX ecosystem"><div class="shell">
    <a href="https://jeyanandan.com/" aria-current="page">jeyanandan.com</a>
    <a href="https://daxfoundation.org/">daxfoundation.org</a>
    <a href="https://www.obsidiandelta.com/">obsidiandelta.com</a>
    <a href="https://formaddie.com/">formaddie.com</a>
  </div></nav>

  <div class="strip"><div class="shell">
    <a class="who" href="/">Jason Jeyanandan</a>
    <nav class="who-nav" aria-label="Site">
      <a href="/blog/">Blog</a>
    </nav>
  </div></div>

  <slot />

  <footer><div class="shell">
    <span>Jason Jeyanandan</span>
    <span class="links">
      <a href="/blog/how-i-publish/">How I publish</a>
      <a href="https://github.com/ObsidianDelta/published/tree/main/jeyanandan.com">Versioned, in public</a>
      <a href="https://www.linkedin.com/in/jasonjeyanandan">LinkedIn</a>
    </span>
    <p class="ecosystem">One body of work: <a href="/">jeyanandan.com</a> (the writing) · <a href="https://daxfoundation.org/metadax/">daxfoundation.org</a> (MetaDAX, the open commons) · <a href="https://www.obsidiandelta.com/learning/">obsidiandelta.com</a> (the company: done-for-you services) · <a href="https://formaddie.com/">formaddie.com</a> (Maddie)</p>
  </div></footer>
</body>
</html>
